    "battery_optimization_disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحسين البطاريه معطل. لتمكينه انتقل إلى إعدادات الجهاز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery optimization disabled. To enable it go to device settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimización de la batería inhabilitado. Para habilitarla vaya a la configuración del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimisation de la batterie désactivée. Pour l'activer, consultez les paramètres de l’appareil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оптимизация батареи отключена. Возобновить работу можно в настройках устройства"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池优化已禁用。若要启用它请转到设备设置"
          }
        }
      }
    },
