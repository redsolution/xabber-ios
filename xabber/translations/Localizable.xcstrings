    "connection_start_at_boot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل عند بدء النظام\nتشغيل التطبيق عند بدء نظام التشغيل Android. هذا الإعداد لن يعمل إذا تم تثبيت Xabber على بطاقة الذاكرة SD."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start when Android boots\nStart the application when Android boots. This doesn't work when Xabber is installed on SD card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar al encender Android\nInicia la aplicación cuando se enciende Android. Esta opción no funciona si Xabber está instalada en la tarjeta SD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer avec Android\nL'application sera lancée au démarrage d'Android. Ne fonctionne pas quand Xabber est installé sur une carte SD."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать при включении телефона\nЗапускать приложение при включении телефона. Функция не будет работать, если Xabber установлен на SD-карту"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随Android启动\n当Android启动时启动该程序。如果Xabber被安装在SD卡上，此功能将会失效。"
          }
        }
      }
    },
    "connection_state_sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация"
          }
        }
      }
    },
    "connection_status__you_are_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не в сети"
          }
        }
      }
    },
    "connection_use_carbons": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع النسخة الكربونية\nقد تكون غير مستقرة!سوف تشارك المحادثات لنفس الحساب على هذا العميل. عطّلها لتقليل استخدام بيانات الشبكة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-copied mode\nWill share sessions for the same account on this client. Disable to reduce traffic usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de copiado Carbon\n¡Puede ser inestable! Compartirá las sesiones de una misma cuenta con este cliente. Deshabilitar para reducir el uso de tráfico de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode copie carbone\nPeut être instable ! Partagera les séances pour le même compte utilisant ce client. Désactiver pour réduire l'utilisation du réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения carbons\nПринимать сообщения других сессий Вашей учетной записи. Отключение поможет сэкономить трафик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复写模式\n将为此客户端上的相同账户共享会话，禁用以减少流量使用。"
          }
        }
      }
    },
    "connection_wake_lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع وضع السكون\nمنع الجهاز من السكون. هذا سينقص من عمر البطارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent sleep mode\nPrevent the device from sleeping. This will increase battery usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevenir el modo suspesión\nPreviene que el teléfono se suspenda. Esto aumentará el uso de la batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêcher la mise en veille\nEmpêche l'appareil de se mettre veille. Décharge la batterie plus rapidement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращать спящий режим\nНе давать устройству перейти в спящий режим. Уменьшает время работы от аккумулятора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止睡眠模式\n防止设备进入睡眠，这将增加电池使用量。"
          }
        }
      }
    },
    "connection_wifi_lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقٍ اتصال WiFi نشطاً\nأبقٍ اتصال WiFi نشط في وضع السكون. سينقص عمر البطارية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep WiFi awake\nKeep WiFi active on standby. This will increase battery usage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar la WiFi conectada\nDejar la WiFi activa en espera. Esto aumentará el uso de la batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Wi-Fi actif\nEmpêche le Wi-Fi de se mettre en veille. Décharge la batterie plus rapidement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать WiFi включенным\nПредотвращать отключение WiFi при простое. Уменьшает время работы от аккумулятора"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持Wi-Fi唤醒\n待机时保持Wi-Fi活动，这将增加电池使用量"
          }
        }
      }
    },
