    "device_detail_terminate_session_message": {
      "comment": "Confirmation message before terminating the selected device session.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ جلسة الجهاز المحدد. سيظل الجهاز الحالي مسجلاً الدخول. لن تُحذف بيانات الحساب أو الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminate the selected device session. Current device remains signed in. Account and server data is not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza la sesión del dispositivo seleccionado. La sesión de este dispositivo seguirá abierta. No se eliminarán los datos de la cuenta ni del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez fin à la session de l’appareil sélectionné. L’appareil actuel restera connecté. Les données du compte et du serveur ne seront pas supprimées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить сеанс выбранного устройства. На текущем устройстве вход в аккаунт будет сохранён. Данные аккаунта и данные на сервере не будут удалены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终止所选设备的会话。当前设备将保持登录。不会删除账户和服务器数据。"
          }
        }
      }
    },
