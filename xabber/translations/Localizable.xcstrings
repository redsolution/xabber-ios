    "too_many_unlock_attempts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إبطال رمز الجهاز %1$@ (%2$@) بسبب كثرة محاولات إلغاء القفل. تم حذف بيانات المستخدم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token of device %1$@ (%2$@) was revoked because too many unlock attempts. User data deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token del dispositivo %1$@ (%2$@) se revocó debido a demasiados intentos de desbloqueo. Se eliminaron los datos del usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton de l’appareil %1$@ (%2$@) a été révoqué en raison d’un trop grand nombre de tentatives de déverrouillage. Les données utilisateur ont été supprimées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен устройства %1$@ (%2$@) был отозван из-за слишком большого количества попыток подбора кода безопасности"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备 %1$@（%2$@）因解锁尝试次数过多而被撤销令牌。用户数据已删除。"
          }
        }
      }
    },
