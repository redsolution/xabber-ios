        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому результату соответствует несколько сообщений, поэтому ни одно из них не было открыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多条消息与此结果匹配，因此未打开任何消息。"
          }
        }
      }
    },
    "chat_search_result_bounded_window_message": {
