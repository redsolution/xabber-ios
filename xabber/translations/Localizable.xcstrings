    "xmpp_login__registration_description_jid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account will be created on a chosen server. You will be able to use it to communicate with users of other servers. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учетная запись будет создана на выбранном сервере. Вы сможете использовать её для общения с пользователями других серверов. "
          }
        }
      }
    },
    "xmpp_login__registration_description_nickname": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الاسم أو اللقب الذي ترتاح إليه أكثر. سيكون اسمك مرئيًا للمستخدمين الآخرين في شبكة XMPP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the name or a nickname you are most comfortable with. Your name will be visible to other users of the XMPP network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el nombre o apodo con el que te sientas más cómodo. Tu nombre será visible para otros usuarios de la red XMPP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le nom ou le surnom qui vous convient le mieux. Votre nom sera visible par les autres utilisateurs du réseau XMPP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте имя или псевдоним, которое для вас наиболее удобно. Ваше имя будет видно другим пользователям сети XMPP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你最习惯的姓名或昵称。你的姓名将对 XMPP 网络中的其他用户可见。"
          }
        }
      }
    },
    "xmpp_login__registration_description_password": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام كلمة مرور قوية أمر حيوي لأمانك. نوصي باستخدام كلمات مرور فريدة وتطبيق لإدارة كلمات المرور للاحتفاظ بها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using a strong password is vital for your safety. We recommend you use unique passwords and password manager apps to keep track of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar una contraseña segura es fundamental para tu seguridad. Recomendamos usar contraseñas únicas y aplicaciones de gestión de contraseñas para llevar su control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe robuste est essentiel à votre sécurité. Nous vous recommandons d’utiliser des mots de passe uniques et une application de gestion des mots de passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование надежного пароля имеет жизненно важное значение для вашей безопасности. Мы рекомендуем вам использовать уникальные пароли и приложения менеджера паролей для их отслеживания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用高强度密码对你的安全至关重要。建议使用不同的密码，并通过密码管理器应用进行管理。"
          }
        }
      }
    },
    "xmpp_login__registration_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed"
          }
        }
