    "device_verification__description__about_to_establish_contact_connection": {
      "comment": "Device-verification description shown before establishing a secure connection with a contact. Security-sensitive copy.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على وشك إنشاء اتصال آمن مع جهة الاتصال هذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to establish a secure connection with this contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a punto de establecer una conexión segura con este contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur le point d’établir une connexion sécurisée avec ce contact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы собираетесь установить безопасное соединение с этим контактом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你即将与此联系人建立安全连接。"
          }
        }
      }
    },
    "device_verification__description__establish_contact_connection": {
      "comment": "Device-verification description shown when verifying a contact. Security-sensitive copy.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تنشئ اتصالاً آمناً مع جهة الاتصال هذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
