    "xmpp_auth_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استخدام الحساب XMPP المحدد لتسجيل الدخول إلى حساب شبير. عن طريق تسجيل الدخول لك قبول لدينا سياسة الخصوصية وشروط الخدمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected XMPP account will be used to sign in to Xabber Account. By signing in you accept our privacy policy and terms of service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta XMPP seleccionada se utilizará para acceder a la cuenta Xabber. Firmando usted acepta nuestra política de privacidad y términos de servicio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите XMPP аккаунт который будет использован для входа в аккаунт Xabber. Осуществляя вход Вы соглашаетесь с нашей политикой по обработке персональных данных и с условиями оказания услуг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定的XMPP帐户将用于登录Xabber帐户。 登录即表示您接受我们的隐私政策和服务条款。"
          }
        }
      }
    },
