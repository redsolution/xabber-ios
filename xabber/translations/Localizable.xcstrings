    "intro_encrypted_chat_learn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرفة المزيد عن المحادثات المشفرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn more about encrypted chats"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más información sobre los chats cifrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En savoir plus sur les conversations chiffrées"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробнее о зашифрованных чатах"
          }
        },
