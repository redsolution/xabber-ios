    "last_calls__nfc_scan_alert_message__register_yubikey_for_account": {
      "comment": "Hard-coded nfcScanAlertMessage copy used by ContactsViewController. Shown to the user or exposed through accessibility/error presentation. Hard-coded nfcScanAlertMessage copy used by LastCallsViewController. Shown to the user or exposed through accessibility/error presentation. Hard-coded nfcScanAlertMessage copy used by LastChatsViewController+Flow. Shown to the user or exposed through accessibility/error presentation. Hard-coded nfcScanAlertMessage copy used by SettingsViewController+UITableViewDelegate. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
