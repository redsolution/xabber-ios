    "sync_all_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مزامنة إعدادات جميع الحسابات وترتيب الحساب تلقائيًا مع الأجهزة الأخرى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings of all accounts and account order will be automatically synced with other devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de todas las cuentas y el orden de la cuenta se sincronizarán automáticamente con otros dispositivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки всех аккаунтов и их порядок будут автоматически синхронизированы с другими устройствами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有帐户和帐户订单的设置将自动与其他设备同步"
          }
