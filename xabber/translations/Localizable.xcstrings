    "privacy_settings__footer_label__server_and_contacts_text_description": {
      "comment": "Hard-coded footerLabel copy used by PrivacySettingsViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصف وضع الخادم وجهات الاتصال"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server and Contacts text description"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descripción del modo Servidor y contactos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Description du mode Serveur et contacts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описание режима «Сервер и контакты»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“服务器和联系人”模式说明"
          }
        }
      }
    },
    "privacy_settings__footer_label__this_option_shares_your_device_information_type_and_os_with_both_the": {
      "comment": "Hard-coded footerLabel copy used by PrivacySettingsViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشارك هذا الخيار معلومات جهازك (النوع ونظام التشغيل) مع الخادم وجهات الاتصال. يستخدم الخادم هذه البيانات لإدارة الأجهزة فقط، مما يسمح بعرض الأجهزة المتصلة بالحساب. قد ترى جهات الاتصال هذه المعلومات أثناء التحقق من الجهاز، ما يحسّن التجربة على حساب بعض الخصوصية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This option shares your device information (type and OS) with both the server and your contacts. The server uses this data solely for device management purposes, allowing users to see which devices are connected to their account. Your contacts might see this information during device verification, enhancing the user experience at the cost of some privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opción comparte la información de tu dispositivo (tipo y sistema operativo) con el servidor y tus contactos. El servidor usa estos datos solo para gestionar dispositivos y mostrar cuáles están conectados a la cuenta. Tus contactos pueden verlos durante la verificación, lo que mejora la experiencia a costa de cierta privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette option partage les informations de votre appareil (type et système d’exploitation) avec le serveur et vos contacts. Le serveur les utilise uniquement pour la gestion des appareils afin d’afficher ceux qui sont connectés au compte. Vos contacts peuvent voir ces informations lors de la vérification, ce qui améliore l’expérience au prix d’une certaine confidentialité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот параметр передаёт сведения об устройстве (тип и ОС) серверу и контактам. Сервер использует их только для управления устройствами, чтобы показывать подключённые к аккаунту устройства. Контакты могут видеть эти сведения при проверке устройств, что улучшает удобство за счёт некоторого снижения конфиденциальности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选项会将设备信息（类型和操作系统）同时共享给服务器和联系人。服务器仅将这些数据用于设备管理，以便显示连接到账号的设备。联系人可能会在设备验证期间看到这些信息，这会提升体验，但会牺牲部分隐私。"
          }
        }
      }
    },
    "privacy_settings__footer_label__typing_notifications_text_description": {
      "comment": "Hard-coded footerLabel copy used by PrivacySettingsViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
