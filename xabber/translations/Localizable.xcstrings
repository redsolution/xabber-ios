    "signin_tokens_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رموز Xabber غير مدعومة. من دون رموز Xabber، لا يمكنك إبطال الوصول من الأجهزة المخترقة. ستُخزن كلمة مرور الحساب محليًا وقد تتعرض للسرقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber tokens are not supported. Without Xabber tokens you can’t revoke access from compromised devices. Account password will be stored locally and can be potentially stolen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admiten los tokens de Xabber. Sin ellos no puedes revocar el acceso de dispositivos comprometidos. La contraseña de la cuenta se almacenará localmente y podría ser robada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons Xabber ne sont pas pris en charge. Sans eux, vous ne pouvez pas révoquer l’accès des appareils compromis. Le mot de passe du compte sera stocké localement et pourrait être dérobé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токены Xabber не поддерживаются. Без токенов Xabber вы не можете отозвать доступ со скомпрометированных устройств. Пароль учетной записи будет храниться локально и может быть потенциально украден."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持 Xabber 令牌。若无 Xabber 令牌，你将无法撤销受入侵设备的访问权限。账户密码将存储在本地，可能被窃取。"
          }
        }
      }
    },
    "signup_with_social": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسيتم ربط حسابك %1$@ بإنشاء حساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ account will be linked to create account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta %1$@ estará vinculada para crear una cuenta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
