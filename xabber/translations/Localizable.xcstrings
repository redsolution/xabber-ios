    "events_persistent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيقونة شريط المهام\nاظهار مستمر للإخطار. هذا الخيار يمنع نظام Android من إزالة التطبيق من الذاكرة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taskbar icon\nShow persistent notification. This option prevents Android from unloading the app from memory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icono en la barra de tareas\nMostrar una notificación persistente. Esta opción previene que Android deje de usar la aplicación desde la memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icône de barre des tâches\nAffiche une notification permanente. Cette option force Android à garder l'application en mémoire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иконка в панели задач\nОтображать постоянное уведомление. Включение предотвращает выгрузку приложения при нехватке памяти"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务栏图标\n显示持久性通知，此选项可防止Android从内存中卸载该程序"
          }
        }
      }
    },
