            "state": "translated",
            "value": "это устройство"
          }
        }
      }
    },
    "omemo__dialog_fingerprints__textfield_device_id_tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device ID: %@\nLabel: %@\nDevice ID is a unique identifier for your contact's device. You maintain separate encryption session with each device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ID устройства: %@\nМетка: %@\nID устройства является уникальным идентификатором для устройства вашего собеседника. С каждым устройством собеседника поддерживается отдельный сеанс связи."
          }
        }
      }
    },
    "omemo__dialog_purge_keys__button_purge_keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purge Keys"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить ключи"
          }
        }
      }
    },
    "omemo__dialog_purge_keys__header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purge encryption keys"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить ключи шифрования"
          }
        }
      }
    },
    "omemo__dialog_purge_keys__text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will unpublish all encryption keys and remove them from your server and this device. All decrypted chats will be permanently deleted, you will not be able to recover them in the future. To resume encrypted messaging you will have to perform fingerprint verification procedures again, with each of your contacts.\n\nUse this measure only as a last resort."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все опубликованные ключи шифрования будут удалены  с вашего сервера и с этого устройства. Все расшифрованные чаты будут навсегда удалены, вы не сможете восстановить их в будущем. Для возобновления шифрования, вам придётся заново осуществить процедуру проверки цифровых отпечатков со всеми собеседниками. \nИспользуйте эту функцию только в качестве крайней меры."
          }
        }
      }
    },
