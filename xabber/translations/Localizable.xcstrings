          }
        }
      }
    },
    "debug_crash_reports_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حصة تحطم وتشخيص البيانات\nمساعدة مطوري التطبيق تحسين شبير بالسماح بتبادل البيانات تحطم وتشخيص معهم (الرجاء إعادة تشغيل التطبيق لتطبيق التغييرات)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share crash and diagnostics data\nHelp app developers improve Xabber by allowing to share crash and diagnostics data with them (please restart application to apply changes)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir datos de fallos y diagnósticos\nAyuda a los desarrolladores de la aplicación a mejorar Xabber permitiendo compartir los datos de fallos y diagnósticos con ellos (por favor, reinicie la aplicación para aplicar los cambios)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les données de plantage et de diagnostique\nAidez les développeurs à améliorer Xabber en autorisant le partage des données de plantage et de diagnostique avec eux (veuillez redémarrer l'application pour appliquer les modifications)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор диагностической информации\nРазрешив сбор информации о сбоях вы поможете разработчикам улучшить Xabber (пожалуйста, перезапустите приложение, чтобы применить изменения)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的崩溃和诊断 data\n允许与应用程序开发人员分享崩溃和诊断数据来帮助他们改进 Xabber (请重新启动应用程序以应用更改)。"
          }
        }
      }
    },
