    "settings_safety_reporting_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإبلاغ عن محتوى مرفوض أو مستخدمين مسيئين أو مخاوف تتعلق بالسلامة، استخدم إجراء الإبلاغ في المحادثات أو الملفات الشخصية أو شاشات الغرف. يمكنك أيضًا التواصل معنا عبر %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To report objectionable content, abusive users, or safety concerns, use the Report action in chats, profiles, or room screens. You can also contact us at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para denunciar contenido censurable, usuarios abusivos o problemas de seguridad, usa la acción Denunciar en chats, perfiles o pantallas de salas. También puedes ponerte en contacto con nosotros en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour signaler des contenus répréhensibles, des utilisateurs abusifs ou des problèmes de sécurité, utilisez l’action Signaler dans les discussions, les profils ou les écrans de salon. Vous pouvez également nous contacter à l’adresse %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сообщить о неприемлемом контенте, нарушениях со стороны пользователей или проблемах безопасности, используйте действие «Пожаловаться» в чатах, профилях или комнатах. Вы также можете связаться с нами по адресу %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要举报不当内容、有滥用行为的用户或安全问题，请在聊天、个人资料或房间屏幕中使用“举报”操作。你也可以通过 %@ 联系我们。"
          }
        }
      }
    },
