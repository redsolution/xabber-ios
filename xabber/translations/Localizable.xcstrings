    "web_client__screen_about__block_3__text_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was originally developed by %2$@ — an international software and services company currently based in Estonia. Since then, a number of individuals joined %3$@ as developers, testers and translators."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fue desarrollado originalmente por %2$@ — una empresa internacional de software y servicios actualmente situada en Estonia. Desde entonces, numerosos individuos se unieron a %3$@ como desarrolladores, testers y traductores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été développé à l'origine par %2$@ — une société internationale de logiciels et de services basée actuellement en Estonie. Depuis, un certain nombre de personnes ont rejoint %3$@ en tant que développeurs, testeurs et traducteurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ изначально был разработан %2$@ — международной компанией по разработке программного обеспечения и услуг, в настоящее время базирующейся в Эстонии. С тех пор ряд людей присоединился к %3$@ в качестве разработчиков, тестировщиков и переводчиков."
          }
        }
      }
    },
    "web_client__screen_about__block_3__text_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our goal is to create a stable, reliable, interoperable and user friendly ecosystem for instant messaging that does not rely on proprietary services and data silos. We welcome anyone who believes in open standards and free information interchange to take part in moving %@ forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro objetivo es crear un ecosistema estable, confiable, interoperable y fácil de usar para la mensajería instantánea que no dependa de servicios propietarios y silos de datos. Damos la bienvenida a cualquier persona que crea en los estándares abiertos y en el intercambio libre de información para participar en el progreso de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre objectif est de créer un stable et fiable, écosystème interopérable et convivial pour la messagerie instantanée qui ne repose pas sur des services propriétaires et des silos de données. Nous souhaitons la bienvenue à tous ceux qui croient en des normes ouvertes et en l'échange gratuit d'informations afin de participer à la progression de %@."
          }
        }
      }
    },
    "web_client__screen_about__block_3__text_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow us on Twitter and Github."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Síguenos en Twitter y Github."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez-nous sur Twitter et Github."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за нами в Twitter и Github."
          }
        }
      }
    },
