    "web_client__screen_about__block_4__text_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available in multiple languages thanks to many fine people from all over the world. We have created a special page on our website to acknowledge their efforts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está disponible en varios idiomas gracias a muchas personas de todo el mundo. Hemos creado una página especial en nuestra web para reconocer sus esfuerzos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est disponible en plusieurs langues grâce à de nombreuses personnes du monde entier. Nous avons créé une page spéciale sur notre site Web pour reconnaître leurs efforts."
          }
        }
      }
    },
    "web_client__screen_about__block_4__text_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may join their ranks and help us improve translation quality by contributing your translations to %@"
