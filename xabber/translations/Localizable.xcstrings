            "value": "New dark theme is now available for Xabber. Join the dark side or stay on the light side?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuevo tema oscuro está disponible ahora para Xabber. ¿Puedes resistir la tentación de usarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
