    "report_encrypted_excerpt_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي تضمين المقتطف إلى إرسال نص الرسالة المفكوك تشفيره والمعروض لمراجعته من قبل فريق الإشراف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Including the excerpt will submit the displayed decrypted message text for moderation review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al incluir el extracto, se enviará el texto descifrado mostrado del mensaje para su revisión por moderación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure l’extrait enverra le texte déchiffré affiché du message afin qu’il soit examiné par l’équipe de modération."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включить фрагмент, показанный расшифрованный текст сообщения будет отправлен на проверку модераторам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含摘录会将显示的已解密消息文本提交以供审核。"
          }
        }
      }
    },
    "report_error_missing_configuration": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تكوين إرسال البلاغات. يرجى التواصل مع الدعم عبر %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report submission is not configured. Please contact support at %@."
          }
        },
        "es": {
