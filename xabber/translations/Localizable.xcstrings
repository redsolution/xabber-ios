    "chat_attachment_cloud_storage_quota_exceeded_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة كافية في التخزين السحابي لإرسال هذه المرفقات. افتح التخزين السحابي لتفريغ مساحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough space in Cloud Storage to send these attachments. Open Cloud Storage to free up space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en Almacenamiento en la nube para enviar estos archivos adjuntos. Abre Almacenamiento en la nube para liberar espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace disponible dans le stockage cloud est insuffisant pour envoyer ces pièces jointes. Ouvrez le stockage cloud pour libérer de l’espace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Cloud Storage недостаточно места для отправки этих вложений. Откройте Cloud Storage, чтобы освободить место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云存储空间不足，无法发送这些附件。请打开云存储释放空间。"
          }
        }
      }
    },
