    "trusted_devices__secondary_text__a_verification_request_has_been_sent_to_your_contact_s_devices_wait": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال طلب تحقق إلى أجهزة جهة الاتصال. انتظر حتى يزوّدك جهة الاتصال برمز التحقق، ثم أدخله لإكمال التحقق من الهوية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verification request has been sent to your contact's devices. Wait for your contact to provide the verification code, then you will need to enter it to complete the identity verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha enviado una solicitud de verificación a los dispositivos de tu contacto. Espera a que tu contacto te facilite el código de verificación y, después, introdúcelo para completar la verificación de identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande de vérification a été envoyée aux appareils de votre contact. Attendez que votre contact vous communique le code de vérification, puis saisissez-le pour terminer la vérification d’identité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на проверку отправлен на устройства контакта. Дождитесь кода проверки от контакта, затем введите его, чтобы завершить проверку личности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证请求已发送到联系人的设备。请等待联系人提供验证码，然后输入验证码以完成身份验证。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__a_verification_request_has_been_sent_to_your_other_device_please_check": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال طلب تحقق إلى جهازك الآخر. تحقّق من الجهاز واتبع التعليمات لإكمال عملية التحقق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verification request has been sent to your other device. Please check the device and follow the provided instructions to complete the verification process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha enviado una solicitud de verificación a tu otro dispositivo. Compruébalo y sigue las instrucciones para completar la verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande de vérification a été envoyée à votre autre appareil. Consultez cet appareil et suivez les instructions pour terminer la vérification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на проверку отправлен на другое ваше устройство. Проверьте его и следуйте инструкциям, чтобы завершить проверку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证请求已发送到你的另一台设备。请查看该设备并按照说明完成验证。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__device_has_requested_to_establish_a_trusted_encryption_session_with_you_if": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب جهاز إنشاء جلسة تشفير موثوقة معك. إذا وافقت، فسيظهر رمز أمان يجب تمريره إلى جهازك الأساسي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device has requested to establish a trusted encryption session with you. If you accept, you'll be presented with a security code which you'll need to pass to your primary device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo ha solicitado establecer una sesión cifrada de confianza contigo. Si aceptas, se mostrará un código de seguridad que deberás proporcionar a tu dispositivo principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil a demandé à établir une session chiffrée de confiance avec vous. Si vous acceptez, un code de sécurité s’affichera ; vous devrez le transmettre à votre appareil principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство запросило создание доверенного зашифрованного сеанса. Если вы согласитесь, появится код безопасности, который нужно передать на основное устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台设备请求与你建立可信加密会话。接受后会显示安全码，你需要将其提供给主设备。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__the_contact_accepted_the_verification_request": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
