    "verification_request_description": {
      "comment": "Push notification body for an identity verification request. Argument 1 is the sender display name.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب منك %1$@ التحقق من هويتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ asks you to verify yourself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ te pide que verifiques tu identidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vous demande de vérifier votre identité"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ просит вас подтвердить свою личность"
          }
        },
        "zh-Hans": {
