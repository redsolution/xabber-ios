    "intro_incognito_group_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://www.xabber.com/learn/incognito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
