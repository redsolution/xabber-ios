    "intro_public_group_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هويات المستخدمين في هذه المجموعة علنية، لذلك يمكن لأي عضو التواصل معك باستخدام معرّف XMPP الحقيقي الخاص بك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identities of users in this group are public, so any member can contact you using your real XMPP ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las identidades de los usuarios de este grupo son públicas, por lo que cualquier miembro puede ponerse en contacto contigo usando tu ID de XMPP real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identités des utilisateurs de ce groupe sont publiques, donc tout membre peut vous contacter en utilisant votre véritable ID XMPP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификаторы пользователей в этой группе являются публичными, поэтому любой участник сможет связаться с вами по вашему XMPP ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组中的用户身份是公开的，因此任何成员都可以使用你的真实 XMPP ID 联系你。"
          }
        }
      }
    },
