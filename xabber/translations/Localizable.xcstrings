    "otr_fingerprint_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتأكد من هوية الطرف الآخر، أطلب منه أن يعطيك بصمته لمقارنتها مع البصمة المحددة بالأسفل. لهذا الغرض، يجب عدم استخدام محادثة XMPP لتبادل البصمات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To confirm the identity of your opponent, ask him to provide his fingerprint and compare it with the one below. For this purpose, you should not exchange fingerprints by XMPP chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu interlocutor puede proporcionarte su huella de seguridad con la que puedes comparar para asegurarte de que es quien dice ser. Debes usar un medio de comunicación seguro para esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour confirmer l'identité de votre interlocuteur, demandez-lui de fournir son empreinte et comparez-la à celle ci-dessous. N'échangez surtout pas vos empreintes via XMPP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы Вам убедиться, что никто не выдает себя за вашего собеседника, он должен сообщить Вам цифровой отпечаток пальца, который вы сверите с указанным здесь. Не следует использовать XMPP чат для такой проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方可提供他的指纹，你可与此处提供的相比对，以确认他确实是你所认为的人。你不应用XMPP聊天进行此项工作。"
          }
        }
      }
    },
