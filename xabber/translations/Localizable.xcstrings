    "signin_message_archive_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرشيف الرسائل غير مدعوم. من دون أرشيف الرسائل، لا يمكنك مزامنة سجل المحادثات بين الخادم والعملاء المتصلين. لا يمكن استخدام Xabber على الخوادم التي لا تدعم أرشيف الرسائل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message Archive is not supported. Without Message Archive you can’t synchronize chat history between server and connected clients.  Xabber can not be used on servers that do not support message archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite el Archivo de mensajes. Sin él, no puedes sincronizar el historial de chats entre el servidor y los clientes conectados. Xabber no se puede usar en servidores que no admitan el archivo de mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archive des messages n’est pas prise en charge. Sans elle, vous ne pouvez pas synchroniser l’historique des discussions entre le serveur et les clients connectés. Xabber ne peut pas être utilisé sur les serveurs qui ne prennent pas en charge l’archive des messages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив сообщений не поддерживается. Без архива сообщений вы не сможете синхронизировать историю чата между сервером и подключенными клиентами. Xabber не может быть использован на серверах, которые не поддерживают архив сообщений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持消息归档。若无消息归档，你将无法在服务器和已连接的客户端之间同步聊天历史记录。Xabber 无法在不支持消息归档的服务器上使用。"
          }
        }
      }
    },
    "signin_message_editing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرير الرسائل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message editing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edición de mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification des messages"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование сообщений"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息编辑"
          }
        }
      }
    },
    "signin_message_editing_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرير الرسائل غير مدعوم. لن تتمكن من تحرير الرسائل أو حذفها من أرشيف الرسائل على هذا الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message editing is not supported. You will not be able to edit or delete messages from this server’s Message Archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite la edición de mensajes. No podrás editar ni eliminar mensajes del Archivo de mensajes de este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification des messages n’est pas prise en charge. Vous ne pourrez pas modifier ni supprimer les messages de l’archive des messages de ce serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование сообщений не поддерживается. Вы не сможете редактировать или удалять сообщения из архива сообщений этого сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持消息编辑。你将无法编辑或删除此服务器消息归档中的消息。"
          }
        }
      }
    },
    "signin_no_message_archive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الخادم أرشيف الرسائل. لا يمكن لـ Xabber العمل من دون أرشيف الرسائل، لذا نقترح إنشاء حساب جديد على خادم Xabber.chat متوافق بالكامل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not support message archive. It is impossible for Xabber to work without message archive, so we suggest creating a new account on a fully-compatible Xabber.chat server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no admite el archivo de mensajes. Xabber no puede funcionar sin él, por lo que recomendamos crear una cuenta nueva en un servidor Xabber.chat totalmente compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas en charge l’archive des messages. Xabber ne peut pas fonctionner sans elle. Nous vous conseillons donc de créer un compte sur un serveur Xabber.chat entièrement compatible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не поддерживает архив сообщений. Xabber не может работать без архива сообщений, поэтому мы предлагаем создать новую учетную запись на полностью совместимом сервере Xabber.chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器不支持消息归档。没有消息归档，Xabber 无法正常工作，因此建议在完全兼容的 Xabber.chat 服务器上创建新账户。"
          }
        }
      }
    },
    "signin_not_all_features": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست كل الميزات الضرورية مدعومة. تابع استخدام هذا الحساب على مسؤوليتك وبتوقعات منخفضة. ومع ذلك، نقترح إنشاء حساب جديد على خادم Xabber.chat متوافق بالكامل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all necessary features are supported. Proceed using this account at your own risk, and with low expectations. However, we suggest creating a new account on a fully-compatible Xabber.chat server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admiten todas las funciones necesarias. Continúa usando esta cuenta por tu cuenta y riesgo y con expectativas moderadas. No obstante, recomendamos crear una cuenta nueva en un servidor Xabber.chat totalmente compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines fonctionnalités nécessaires ne sont pas prises en charge. Vous pouvez continuer à utiliser ce compte à vos risques et périls, avec des possibilités limitées. Nous vous conseillons toutefois de créer un compte sur un serveur Xabber.chat entièrement compatible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все необходимые функции поддерживаются. Продолжайте пользоваться этим аккаунтом на свой страх и риск. Тем не менее, мы предлагаем создать новую учетную запись на полностью совместимом сервере Xabber.chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并非所有必要功能均受支持。使用此账户需自行承担风险，也不要抱有太高期望。不过，建议在完全兼容的 Xabber.chat 服务器上创建新账户。"
          }
        }
      }
    },
    "signin_proceed_anyway": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتابعة على أي حال"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceed anyway"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar de todos modos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer quand même"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить в любом случае"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然继续"
          }
        }
      }
    },
    "signin_publish_subscribe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشر والاشتراك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish-subscribe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicación-suscripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publication-abonnement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация-подписка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布-订阅"
          }
        }
      }
    },
    "signin_pubsub_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub غير مدعوم. من دون النشر والاشتراك، لا يمكنك استخدام التشفير الحديث أو تعيين صورة المستخدم وغير ذلك. لا يُنصح باستخدام Xabber على هذا الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub is not supported. Without publish-subscribe, you can’t use modern encryption, set user avatar, etc. It is not recommended to use Xabber on this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite PubSub. Sin publicación-suscripción no puedes usar cifrado moderno, establecer un avatar de usuario, etc. No se recomienda usar Xabber en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub n’est pas pris en charge. Sans publication-abonnement, vous ne pouvez pas utiliser le chiffrement moderne, définir un avatar, etc. Il est déconseillé d’utiliser Xabber sur ce serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub не поддерживается. Без подписки на публикацию вы не можете использовать современное шифрование, установить пользовательский аватар и т. д. Не рекомендуется использовать Xabber на этом сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持 PubSub。若无发布-订阅功能，你将无法使用现代加密、设置用户头像等。不建议在此服务器上使用 Xabber。"
          }
        }
      }
    },
    "signin_push_notifications_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات الفورية غير مدعومة. لن يتمكن جهازك من تلقي الرسائل الواردة عندما لا يكون Xabber نشطًا. لا يُنصح باستخدام Xabber على هذا الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push notifications are not supported. Your device won’t be able to receive incoming messages when Xabber is not active. It is not recommended to use Xabber on this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admiten las notificaciones push. Tu dispositivo no podrá recibir mensajes entrantes cuando Xabber no esté activo. No se recomienda usar Xabber en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push ne sont pas prises en charge. Votre appareil ne pourra pas recevoir les messages entrants lorsque Xabber est inactif. Il est déconseillé d’utiliser Xabber sur ce serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-уведомления не поддерживаются. Ваше устройство не сможет принимать входящие сообщения, если Xabber не активен. Не рекомендуется использовать Xabber на этом сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持推送通知。Xabber 未运行时，你的设备将无法接收传入消息。不建议在此服务器上使用 Xabber。"
          }
        }
      }
    },
    "signin_quick_synchronization_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة السريعة غير مدعومة. تتيح هذه الميزة عملًا موثوقًا على الأجهزة المحمولة وتحسّن تجربة المستخدم بدرجة كبيرة. لا يُنصح باستخدام Xabber على الخوادم التي لا تدعم المزامنة السريعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick synchronization is not supported. This feature allows robust work on mobile devices and greatly improves user experience. It is not recommended to use Xabber on servers without quick synchronization."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite la sincronización rápida. Esta función permite un funcionamiento sólido en dispositivos móviles y mejora considerablemente la experiencia de usuario. No se recomienda usar Xabber en servidores sin sincronización rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation rapide n’est pas prise en charge. Cette fonctionnalité assure un fonctionnement fiable sur les appareils mobiles et améliore considérablement l’expérience utilisateur. Il est déconseillé d’utiliser Xabber sur un serveur qui ne prend pas en charge la synchronisation rapide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая синхронизация не поддерживается. Эта функция позволяет надежно работать на мобильных устройствах и значительно улучшает взаимодействия пользователя. Не рекомендуется использовать Xabber на серверах без быстрой синхронизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持快速同步。此功能可让移动设备稳定运行，并显著改善用户体验。不建议在不支持快速同步的服务器上使用 Xabber。"
          }
        }
      }
    },
    "signin_server_capabilities": {
      "comment": "Server capabilities section title on the sign-in screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمكانات الخادم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server capabilities"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidades del servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacités du serveur"
          }
        },
        "ru": {
          "stringUnit": {
