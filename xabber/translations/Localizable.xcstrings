            "state": "translated",
            "value": "In incognito groups, members use pseudonyms, hiding XMPP IDs from others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los grupos de incógnito, los miembros usan seudónimos y ocultan sus ID de XMPP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les groupes incognito, les membres utilisent des pseudonymes et masquent leurs identifiants XMPP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В инкогнито-группах участники используют псевдонимы, скрывая XMPP ID друг от друга."
