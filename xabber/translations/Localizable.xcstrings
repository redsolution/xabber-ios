    "account_data_deletion": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "— ستُحذف بيانات الحساب من هذا الجهاز. لن تتأثر بياناتك على الخادم."
          }
