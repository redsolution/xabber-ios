    "contacts__list__incognito_groups_description": {
      "comment": "Contacts / list: user-visible subtitle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المجموعات المتخفية، يستخدم الأعضاء أسماء مستعارة لإخفاء معرّفات XMPP عن الآخرين."
          }
