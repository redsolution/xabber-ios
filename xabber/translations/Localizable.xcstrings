          "stringUnit": {
            "state": "translated",
            "value": "المنفذ يجب أن يتراوح بين 1 إلى 65535 (الافتراضي: 5222)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must be between 1 and 65535 (default: 5222)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto debe estar entre 1 y 65535 (predeterminado: 5222)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port doit être compris entre 1 et 65535 (défaut : 5222)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
