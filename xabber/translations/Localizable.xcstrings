    "error_file_upload_disco_in_progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still determining whether or not %1$@ server supports file transfer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en déterminant si le serveur %1$@ prend en charge le transfert de fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаем ответа на запрос о наличии функции передачи файлов сервером %1$@"
          }
        }
      }
    },
    "error_file_upload_not_support": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ server does not seem to support file transfer. This may happen because Xabber didn't yet receive server capabilities, or because of some glitch.\n\nRefresh server info in Account settings → Server info. If that does not help, consider using a server that definitely does support file transfer. One such server is Xabber.chat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur %1$@ ne semble pas prendre en charge le transfert de fichiers. Cela peut se produire parce que Xabber n'a pas encore reçu les capacités du serveur, ou à cause d'un problème quelconque.\n\nActualiser les informations du serveur dans Paramètres du compte → Informations du serveur. Si cela n'aide pas, pensez à utiliser un serveur qui supporte définitivement le transfert de fichiers. Un tel serveur est Xabber.chat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер %1$@ не поддерживает передачу файлов. Это могло произойти из-за того, что Xabber еще не получил информацию о функцинале, или из-за какого-нибудь сбоя.\n\nОбновить информацию о сервере можно в настройках учетной записи → Информация о сервере. Если это не помогает, подумайте об использовании сервера, который точно поддерживает передачу файлов, например, Xabber.chat"
          }
        }
      }
    },
