          "stringUnit": {
            "state": "translated",
            "value": "进一步了解加密聊天"
          }
        }
      }
    },
    "intro_encrypted_chat_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://www.xabber.com/learn/encrypted"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "https://www.xabber.com/learn/encrypted"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "https://www.xabber.com/learn/encrypted"
          }
        }
      }
    },
    "intro_encrypted_chat_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائل هذه المحادثة مشفرة من طرف إلى طرف. يجب عليك دائمًا تأكيد هوية جهة اتصالك عن طريق التحقق من بصمات مفاتيح التشفير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages in this chat are encrypted with end-to-end encryption. You must always confirm the identity of your contact by verifying encryption keys fingerprints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de este chat están cifrados de extremo a extremo. Siempre debes confirmar la identidad de tu contacto verificando las huellas digitales de las claves de cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages dans cette conversation sont chiffrés avec un chiffrement de bout en bout. Vous devez toujours confirmer l'identité de votre contact en vérifiant les empreintes digitales des clés de chiffrement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения в этом чате зашифрованы сквозным шифрованием. Вы всегда должны подтверждать личность вашего контакта путём проверки отпечатков ключей шифрования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天中的消息采用端到端加密。你必须始终通过验证加密密钥指纹来确认联系人的身份。"
          }
        }
      }
    },
