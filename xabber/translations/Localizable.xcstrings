    "signin_file_upload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File upload"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка файлов"
          }
        }
      }
    },
    "signin_file_upload_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع الملفات غير مدعوم. بدون رفع الملفات، لن تتمكن من إرسال الصور والرسائل الصوتية والوسائط الأخرى إلى جهات اتصالك. لا يُنصح باستخدام Xabber على الخوادم التي لا تدعم رفع الملفات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File upload is not supported. Without file upload, you will not be able to send images, voice messages and other media to your contacts. It is not recommended to use Xabber on servers without file upload support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite la carga de archivos. Sin ella, no podrás enviar imágenes, mensajes de voz ni otro contenido multimedia a tus contactos. No se recomienda usar Xabber en servidores que no admitan la carga de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement de fichiers n’est pas pris en charge. Sans celui-ci, vous ne pourrez pas envoyer d’images, de messages vocaux ni d’autres médias à vos contacts. Il est déconseillé d’utiliser Xabber sur un serveur qui ne prend pas en charge le téléversement de fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка файлов не поддерживается. Без загрузки файла вы не сможете отправлять изображения, голосовые сообщения и другие медиа вашим контактам. Не рекомендуется использовать Xabber на серверах без поддержки загрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持文件上传。若无文件上传功能，你将无法向联系人发送图片、语音消息和其他媒体。不建议在不支持文件上传的服务器上使用 Xabber。"
          }
        }
      }
    },
    "signin_lets_rock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
