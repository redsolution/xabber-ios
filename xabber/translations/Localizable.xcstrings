    "xmppauthentication_failure__user_message__sign_in_again_to_restore_account_access_your_local_data_was_kept": {
      "comment": "Hard-coded userMessage copy used by XMPPAuthenticationFailure. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول مرة أخرى لاستعادة الوصول إلى الحساب. تم الاحتفاظ ببياناتك المحلية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to restore account access. Your local data was kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión para recuperar el acceso a la cuenta. Tus datos locales se han conservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour rétablir l’accès au compte. Vos données locales ont été conservées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите снова, чтобы восстановить доступ к аккаунту. Локальные данные сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录以恢复账号访问权限。本地数据已保留。"
          }
        }
      }
    },
