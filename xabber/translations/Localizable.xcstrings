    "cloud_storage__cleanup__delete_files_confirmation": {
      "comment": "Cloud Storage / cleanup: user-visible alert or toast message. Cloud Storage / gallery: user-visible alert or toast message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكد حذف الملفات من Cloud Storage. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm deleting files from Cloud Storage. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la eliminación de archivos de Cloud Storage. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la suppression des fichiers de Cloud Storage. Cette action est irréversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите удаление файлов из Cloud Storage. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
