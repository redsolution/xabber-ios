        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocole XMPP"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP протокол"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP 协议"
          }
        }
      }
    },
    "web_client__screen_about__block_1__text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensible Messaging and Presence Protocol (XMPP) is a communications protocol for message-oriented middleware based on XML (Extensible Markup Language). It enables the near-real-time exchange of structured yet extensible data between any two or more network entities. The protocol was originally named Jabber, and was developed by the Jabber open-source community in 1999 for near real-time instant messaging (IM), presence information, and contact list maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensible Messaging and Presence Protocol (XMPP) es un protocolo de comunicaciones para middleware orientado a mensajes basado en XML (Extensible Markup Language). Permite el intercambio, casi en tiempo real, de datos estructurados pero extensibles entre dos o más entidades de red. El protocolo fue originalmente llamado Jabber, y fue desarrollado por la comunidad de código abierto de Jabber en 1999 para mensajería instantánea casi en tiempo real (IM), información de presencia y mantenimiento de la lista de contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensible Messaging and Presence Protocol (XMPP) est un protocole de communication pour les middleware orientés messages basés sur XML (Extensible Markup Language). Il permet l'échange en temps quasi réel de données structurées mais extensibles entre deux ou plusieurs entités réseau. Le protocole s'appelait à l'origine Jabber et a été développé par la communauté open-source Jabber en 1999 pour la messagerie instantanée en temps quasi réel (IM), les informations de présence et la maintenance de la liste de contacts."
          }
        }
      }
    },
    "web_client__screen_about__block_2__header": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بروتوكولات امتداد XMPP"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP Extension Protocols"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolos de extensión XMPP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocoles d'extension XMPP"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Протоколы расширения XMPP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP 扩展协议"
          }
        }
      }
    },
    "web_client__screen_about__block_2__text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP is highly extensible, via extensions known as XEPs (XMPP Extension Protocol). %@ supports a number of popular XEPs that are essential to providing great chat experience for our users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP es altamente extensible, a través de extensiones conocidas como XEPs (XMPP Extension Protocol). %@ soporta numerosos XEPs populares que son esenciales para proporcionar una gran experiencia de chat a nuestros usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP est très extensible, via des extensions appelées XEPs (XMPP Extension Protocol). %@ prend en charge un certain nombre de XEP populaires qui sont essentiels pour fournir une expérience de chat formidable à nos utilisateurs."
          }
        }
      }
    },
    "web_client__screen_about__block_3__header": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المطورون"
          }
        },
