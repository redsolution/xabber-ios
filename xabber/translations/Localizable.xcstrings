    "omemo__dialog_fingerprints__text_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must carefully verify that this device fingerprints match the once visible to your chat partner. For maximum security, this should be done via another communication channel. Preferrably, in person."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы должны тщательно убедиться, что цифровые отпечатки этого устройства совпадают с теми, которые видит ваш собеседник. Для обеспечения максимальной безопасности сверка отпечатков должна осуществляться через другой канал связи. Лучше всего при личной встрече."
          }
        }
      }
    },
    "omemo__dialog_fingerprints__text_learn_more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn more about encryption and safe key exchange"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте больше о шифровании и безопасном обмене ключами"
          }
        }
      }
    },
    "omemo__dialog_fingerprints__text_no_fingerprints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fingerprints yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет цифровых отпечатков"
          }
        }
