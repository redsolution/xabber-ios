    "reorder_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمزامنة حسابات النظام بين الأجهزة تحتاج إلى تمكين الخيار \"مزامنة الكل\" في إعدادات الحساب Xabber"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To synchronize accounts order between devices you need to enable \"Synchronize all\" option in Xabber Account settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sincronizar el orden de las cuentas entre los dispositivos es necesario activar la opción \"Sincronizar todo\" en la configuración de la cuenta de Xabber"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour synchroniser l’ordre des comptes entre les périphériques, vous avez besoin d’activer l’option « Tout synchroniser » dans les paramètres du compte Xabber"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для синхронизации порядка аккаунтов необходимо активировать опцию «Синхронизировать все» в настройках аккаунта Xabber"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要在设备间同步帐户排序，你需要启用 Xabber 帐户设置中的“同步所有”选项"
          }
        }
      }
    },
