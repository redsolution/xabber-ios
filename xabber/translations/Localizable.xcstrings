    "account_settings_terminate_description": {
      "comment": "Legacy account-device list explanation of session termination semantics.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إنهاء الجلسات التي لا تحتاج إليها. تمسح تطبيقات Xabber الرسمية جميع بيانات المستخدم من الجهاز عند إنهاء الجلسة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can terminate sessions you don`t need. Official Xabber clients wipe all user data from the device upon session termination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes finalizar las sesiones que no necesites. Los clientes oficiales de Xabber borran todos los datos del usuario del dispositivo al finalizar una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez mettre fin aux sessions dont vous n’avez pas besoin. Les clients Xabber officiels effacent toutes les données utilisateur de l’appareil à la fin d’une session."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете завершить сеансы, которые вам не нужны. Официальные клиенты Xabber стирают все пользовательские данные с устройства после завершения сеанса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以终止不需要的会话。会话终止后，Xabber 官方客户端会从设备中清除所有用户数据。"
          }
        }
      }
    },
    "account_settings_typing_notification": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال إشعار عند الكتابة"
          }
