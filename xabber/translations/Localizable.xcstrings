        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes unirte a ellos y ayudarnos a mejorar la calidad de traducción contribuyendo con tus traducciones a %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez rejoindre leurs rangs et nous aider à améliorer la qualité de la traduction en contribuant vos traductions à %@"
