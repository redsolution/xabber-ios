    },
    "intro_incognito_group_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identities of users in this group are kept hidden from each other, only group admins can access your real XMPP ID. Be vigilant, do not disclose yourself by being careless."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identités des utilisateurs de ce groupe sont cachées les unes des autres, seuls les administrateurs de groupe peuvent accéder à votre véritable ID XMPP. Soyez vigilant, ne vous divulguez pas en étant insensé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификаторы пользователей в этой группе скрыты от участников, досуп к вашему XMPP ID могут получить только администраторы. Будьте бдительны. Не компрометируйте себя непродуманными действиями."
          }
        }
      }
    },
    "intro_private_chat": {
      "extractionState": "manual",
