    "contacts__footer__circle_filter": {
      "comment": "Contacts-list footer suffix describing the selected circle filters. The first signed-integer argument selects singular or plural but is not displayed; %2$@ is the comma-separated list of circle names.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@circle@"
          },
          "substitutions": {
            "circle": {
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
