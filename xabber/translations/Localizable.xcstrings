    "appearance__theme_preview__message_quote": {
      "comment": "Synthetic interface appearance preview copy; localize because it is visible UI and must demonstrate the selected language and RTL direction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى اليمين. وبقوة، نوعًا ما."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right side. And, uh, with intensity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacia la derecha. Y, eh, con intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Côté droit. Et, euh, avec intensité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправо. И, э-э, поэнергичнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边。然后，呃，再有力度一点。"
