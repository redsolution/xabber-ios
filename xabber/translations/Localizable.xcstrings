    "groupchat_join__description__incognito_invitation": {
      "comment": "Incognito group invitation privacy explanation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت دعوتك إلى دردشة جماعية. إذا قبلت، فلن يظهر معرّف XMPP الخاص بك لأعضاء المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are invited to group chat. If you accept, your XMPP ID will not be visible to group members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a un chat grupal. Si aceptas, tu ID de XMPP no será visible para los miembros del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes invité à une discussion de groupe. Si vous acceptez, votre identifiant XMPP ne sera pas visible par les membres du groupe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас пригласили в групповой чат. Если вы примете приглашение, ваш XMPP ID не будет виден участникам группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀加入群聊。接受邀请后，群成员将看不到你的 XMPP ID。"
          }
        }
      }
    },
    "groupchat_join__description__public_invitation_format": {
      "comment": "Public group invitation privacy explanation. The argument is the account JID visible to group members.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت دعوتك إلى دردشة جماعية. إذا قبلت، فسيظهر الحساب %1$@ لأعضاء المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are invited to group chat. If you accept, the account %1$@ will be visible to group members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a un chat grupal. Si aceptas, la cuenta %1$@ será visible para los miembros del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes invité à une discussion de groupe. Si vous acceptez, le compte %1$@ sera visible par les membres du groupe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас пригласили в групповой чат. Если вы примете приглашение, аккаунт %1$@ будет виден участникам группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀加入群聊。接受邀请后，账户 %1$@ 将对群成员可见。"
          }
        }
      }
    },
