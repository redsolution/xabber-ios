    "devices_terminate_all_other_sessions_message": {
      "comment": "Confirmation message for terminating all sessions except the current device.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ جميع جلسات الأجهزة الأخرى. سيظل هذا الجهاز مسجلاً الدخول. لن تُحذف بيانات الحساب أو الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminate all other device sessions. This device remains signed in. Account and server data is not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza todas las demás sesiones de dispositivos. La sesión de este dispositivo seguirá abierta. No se eliminarán los datos de la cuenta ni del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez fin à toutes les autres sessions d’appareils. Cet appareil restera connecté. Les données du compte et du serveur ne seront pas supprimées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить все остальные сеансы устройств. На этом устройстве вход в аккаунт будет сохранён. Данные аккаунта и данные на сервере не будут удалены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终止所有其他设备会话。此设备将保持登录。不会删除账户和服务器数据。"
          }
        }
      }
    },
