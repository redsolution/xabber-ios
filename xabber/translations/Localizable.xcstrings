    "web_client__screen_about__preamble_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is an open source XMPP messenger for Android, iOS and Web platforms. It is build around open standards, interoperability, design and great user experience. Versions of %2$@ for every platform are built to provide a continuous chat experience between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es un mensajero XMPP de código abierto para plataformas Android, iOS y Web. Se construye alrededor de estándares abiertos, interoperabilidad, diseño y gran experiencia de usuario. Las versiones de %2$@ para cada plataforma están construidas para proporcionar una experiencia de chat continua entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est une messagerie XMPP open source pour Android, iOS et les plateformes Web. Il est construit autour de standards ouverts, d'interopérabilité, de design et d'une grande expérience utilisateur. Les versions de %2$@ pour chaque plateforme sont construites pour fournir une expérience de chat continue entre elles."
          }
        }
      }
    },
