    "dark_theme_suggest_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمة مظلمة جديدة متاحة الآن لـ Xabber. الانضمام إلى الجانب المظلم أو البقاء على الجانب ضوء؟"
          }
