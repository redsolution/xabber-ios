    "edit_contact__table_section_title__the_contact_receives_your_presence_information_you_have_not_sent_a_request": {
      "comment": "Hard-coded tableSectionTitle copy used by EditContactViewController+UITableViewDataSource. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى جهة الاتصال معلومات حضورك.\n\nلم ترسل طلبًا للوصول إلى معلومات حضور جهة الاتصال هذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact receives your presence information.\n\nYou have not sent a request to access presence information of this contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto recibe tu información de presencia.\n\nNo has enviado una solicitud para acceder a la información de presencia de este contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact reçoit vos informations de présence.\n\nVous n’avez pas envoyé de demande pour accéder aux informations de présence de ce contact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт получает информацию о вашем присутствии.\n\nВы не отправляли запрос на доступ к информации о присутствии этого контакта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该联系人会收到你的在线状态信息。\n\n你尚未请求查看该联系人的在线状态信息。"
          }
        }
      }
    },
    "edit_contact__table_section_title__you_receive_presence_information_for_this_contact_and_the_contact_has_sent": {
      "comment": "Hard-coded tableSectionTitle copy used by EditContactViewController+UITableViewDataSource. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى معلومات حضور جهة الاتصال هذه، وقد أرسلت إليك طلبًا للاطلاع على معلومات حضورك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive presence information for this contact, and the contact has sent you a request to see your presence information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes la información de presencia de este contacto y el contacto te ha solicitado ver la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez les informations de présence de ce contact, qui vous a demandé à voir les vôtres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получаете информацию о присутствии этого контакта, а контакт запросил доступ к информации о вашем присутствии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会收到此联系人的在线状态信息，并且该联系人已请求查看你的在线状态信息。"
          }
        }
      }
    },
    "edit_contact__table_section_title__you_receive_presence_information_for_this_contact_but_the_contact_has_not": {
      "comment": "Hard-coded tableSectionTitle copy used by EditContactViewController+UITableViewDataSource. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى معلومات حضور جهة الاتصال هذه، لكنها لم تطلب الاطلاع على معلومات حضورك.\n\nسيتم قبول طلبات الاشتراك الواردة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive presence information for this contact, but the contact has not asked to see yours.\n\nIncoming subscription requests will be accepted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes la información de presencia de este contacto, pero el contacto no ha solicitado ver la tuya.\n\nLas solicitudes de suscripción entrantes se aceptarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez les informations de présence de ce contact, mais il n’a pas demandé à voir les vôtres.\n\nLes demandes d’abonnement entrantes seront acceptées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получаете информацию о присутствии этого контакта, но контакт не запрашивал доступ к вашей.\n\nВходящие запросы подписки будут приниматься автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会收到此联系人的在线状态信息，但对方尚未请求查看你的状态。\n\n收到的订阅请求将自动接受。"
          }
        }
      }
    },
    "edit_contact__table_section_title__you_receive_presence_information_for_this_contact_but_the_contact_has_not__variant_2": {
      "comment": "Hard-coded tableSectionTitle copy used by EditContactViewController+UITableViewDataSource. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى معلومات حضور جهة الاتصال هذه، لكنها لم تطلب الاطلاع على معلومات حضورك.\n\nلن يتم قبول طلبات الاشتراك الواردة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive presence information for this contact, but the contact has not asked to see yours.\n\nIncoming subscription requests will not be accepted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes la información de presencia de este contacto, pero el contacto no ha solicitado ver la tuya.\n\nLas solicitudes de suscripción entrantes no se aceptarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez les informations de présence de ce contact, mais il n’a pas demandé à voir les vôtres.\n\nLes demandes d’abonnement entrantes ne seront pas acceptées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получаете информацию о присутствии этого контакта, но контакт не запрашивал доступ к вашей.\n\nВходящие запросы подписки не будут приниматься автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会收到此联系人的在线状态信息，但对方尚未请求查看你的状态。\n\n收到的订阅请求不会自动接受。"
          }
        }
      }
    },
