        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжимать изображения\nСжимать изображения при отправке с целью уменьшения использования трафика. Некоторые серверы могут иметь ограничения на размер загружаемого файла, используйте эту опцию работы в условиях таких ограничений."
          }
        }
      }
    },
