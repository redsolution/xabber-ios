    "account__quit_dialog__message_format": {
      "comment": "Quit-account confirmation body. The argument is the account JID. Destructive copy: preserve the local-device-only deletion scope.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت على وشك تسجيل الخروج من الحساب %1$@. ستُحذف بيانات الحساب من هذا الجهاز، ولن تتأثر بياناتك على الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are quitting %1$@ account. Account data will be deleted from this device. Your data on server will not be affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas a salir de la cuenta %1$@. Los datos de la cuenta se eliminarán de este dispositivo. Tus datos del servidor no se verán afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous quittez le compte %1$@. Les données du compte seront supprimées de cet appareil. Vos données sur le serveur ne seront pas affectées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выходите из аккаунта %1$@. Данные аккаунта будут удалены с этого устройства. Данные на сервере останутся без изменений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将退出账户 %1$@。该账户的数据将从此设备中删除，服务器上的数据不会受到影响。"
          }
        }
      }
    },
