        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de verificación fue rechazada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de vérification a été rejetée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс проверки отклонён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证会话已被拒绝。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__the_verification_session_was_completed_successfully_now_you_trust_this_contact_s": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتملت جلسة التحقق بنجاح. أصبحت الآن تثق بأجهزة جهة الاتصال هذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification session was completed successfully. Now you trust this contact's devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de verificación se completó correctamente. Ahora confías en los dispositivos de este contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de vérification a réussi. Vous faites désormais confiance aux appareils de ce contact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс проверки успешно завершён. Теперь вы доверяете устройствам этого контакта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证会话已成功完成。你现在信任该联系人的设备。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__you_have_accepted_the_verification_request": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قبلت طلب التحقق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have accepted the verification request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has aceptado la solicitud de verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez accepté la demande de vérification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы приняли запрос на проверку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已接受验证请求。"
          }
        }
      }
    },
    "trusted_devices__secondary_text__you_have_received_an_identity_verification_request_from_this_contact_this_step": {
      "comment": "Hard-coded secondaryText copy used by TrustedDevicesViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تلقيت طلب تحقق من الهوية من جهة الاتصال هذه. هذه الخطوة ضرورية لإنشاء اتصال موثوق بين أجهزتك وضمان اتصالات آمنة ومشفّرة.\n\nاضغط الزر أدناه لعرض رمز التحقق. بعد إنشائه، أرسله بأمان إلى جهة الاتصال لإكمال التحقق من الهوية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have received an identity verification request from this contact. This step is crucial to establish a trusted connection between your devices, ensuring secure and encrypted communications.\n\nPress the button below to display a verification code. Once generated, securely communicate this code to this contact to finalize the identity verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has recibido una solicitud de verificación de identidad de este contacto. Este paso es esencial para establecer una conexión de confianza entre los dispositivos y garantizar comunicaciones seguras y cifradas.\n\nPulsa el botón de abajo para mostrar un código de verificación. Después, comunícalo de forma segura a este contacto para completar la verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez reçu une demande de vérification d’identité de ce contact. Cette étape est essentielle pour établir une connexion de confiance entre vos appareils et garantir des communications sécurisées et chiffrées.\n\nAppuyez sur le bouton ci-dessous pour afficher un code de vérification. Communiquez ensuite ce code de façon sûre à ce contact pour terminer la vérification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получили от этого контакта запрос на проверку личности. Этот шаг необходим для создания доверенного соединения между устройствами и безопасного зашифрованного общения.\n\nНажмите кнопку ниже, чтобы показать код проверки. Затем безопасно передайте его контакту, чтобы завершить проверку личности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你收到了此联系人的身份验证请求。此步骤对于在设备之间建立可信连接并确保通信安全和加密至关重要。\n\n按下方按钮显示验证码。生成后，请通过安全方式将此验证码告知该联系人，以完成身份验证。"
          }
        }
      }
    },
    "trusted_devices__session_status__identity_verification_request_received": {
