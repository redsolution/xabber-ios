    "connection_error_account_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection error: account offline"
          }
        }
      }
    },
    "connection_go_away": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغييب ذاتي\nتعيين حالة الغياب ذاتياً عند قفل الشاشة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-away\nAutomatically set away status on screen lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausencia automática\nAutomáticamente configura el estado como ausente al bloquear la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absence automatique\nPasser au statut \"Absent\" au verrouillage de l'écran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход в состояние \"Отошел\"\nАвтоматически переходить в состояние \"Отошел\" при блокировании экрана"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动离开\n屏幕锁定时自动设置离开状态"
          }
        }
      }
    },
    "connection_go_away_immediately": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فوراً عند قفل الشاشة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediately on screen lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente al bloquearse la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès le verrouillage de l'écran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу после выключения экрана"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕后"
          }
        }
      }
    },
    "connection_go_xa": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"غياب ممتد\" عند الخمول\nتعيين حالة \"غياب ممتد\" لدى قفل الشاشة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Extended away\" when idle\nSet \"Extended away\" on screen lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Ausencia extendida\" al ausentarse\nPoner en \"Ausencia extendidad\" al bloquearse la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absence prolongée en cas d'inactivité\nPasser en absence prolongée au verrouillage de l'écran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Давно отошел\" при неактивности\nУстанавливать статус \"Давно отошел\" при блокировке экрана"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时“远远离开”\n在屏幕锁定时设置“远远离开”"
          }
        }
      }
    },
    "connection_load_images": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحميل صور\nتحميل الصور من رابط الملف تلقائياً. تعطيل للحد من استخدام بيانات الهاتف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load images\nLoad images from file URL automatically. Disable to reduce traffic usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar imágenes\nCargar imágenes automáticamente desde el enlace del archivo. Deshabilitar para reducir el uso de tráfico de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger les images\nCharger les images depuis l'URL du fichier automatiquement. Désactiver pour réduire l'utilisation du réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать изображения\nЗагружать изображения по ссылкам автоматически. Отключите для экономии трафика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载图像\n自动从文件URL加载图像。禁用以降低带宽使用率。"
          }
        }
      }
    },
    "connection_load_vcard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمّل بطاقة vCard\nحمّل وحدّث البيانات الشخصية وصورة طرف الاتصال. عطّلها لتقليل استخدام بيانات الشبكة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load vCard\nLoad and update contact's personal info and avatar. Disable to reduce traffic usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar vCard\nCargar y actualizar la información personal y el avatar del contacto. Desactivar para reducir el uso de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger les vCard\nTélécharger et mettre à jour les détails personnels et les avatars des contacts. Désactivez pour réduire l'utilisation du réseau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать vCard\nЗагружать и обновлять персональную информацию и аватары контактов. Отключение поможет сэкономить трафик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载vCard\n加载和更新联系人的个人信息和头像，禁用以减少流量"
          }
        }
      }
    },
    "connection_priority": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات الأولوية"
          }
        },
        "en": {
