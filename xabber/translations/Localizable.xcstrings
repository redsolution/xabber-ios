          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не переведён на язык, используемый на этом устройстве. Переводы осуществляются сообществом, это означает, что вы можете помочь нам перевести %2$@ на ваш родной язык!"
          }
        }
      }
    },
    "settings__section_interface_language__text_description_translation_platform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use CrowdIn Localisation Management Platform. If you wish to join our translation team, follow this %@ and apply as a translator to your native language."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы используем платформу управления локализацией CrowdIn . Если вы хотите присоединиться к нашей команде переводчиков, перейдите по ссылке %@ и подайте заявку на участие в роли переводчика на ваш родной язык."
          }
        }
      }
