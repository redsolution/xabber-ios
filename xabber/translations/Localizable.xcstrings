    "orbot_required_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كي تستخدم شبكة TOR يجب تثبيت وتفعيل برنامج Orbot. هل ترغيب في تثبيته من المتجر؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In order to process using TOR you must have Orbot installed and activated to proxy traffic through it. Would you like to install it from Google Play?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar TOR debe tener instalado Orbot y activarlo para pasar todo el tráfico a través de él. ¿Quieres instalarlo desde Google Play?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afin d'utiliser TOR, Orbot doit être installé et activé pour relayer les communications. Voulez-vous l'installer à partir de Google Play ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования TOR необходимо установить приложение Orbot и активировать в нём передачу данных. Вы хотите установить его из Google Play?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用TOR，你必须安装并激活Orbot。想要从Google Play安装吗？"
          }
        }
      }
    },
