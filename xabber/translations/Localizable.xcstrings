    "logout_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنهاء الاتصال من حساب Xabber. ولن تكون قادراً على استخدام خدمات Xabber معززة، ولكن XMPP الأساسية ستعمل كالمعتاد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will quit from Xabber Account. You will not be able to use enhanced Xabber services, but basic XMPP will work as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de usar cuenta de Xabber. Usted no podrá utilizar los servicios mejorados de Xabber, pero el XMPP básico funcionará con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez quitter le compte Xabber. Vous ne serez pas en mesure d’utiliser les services améliorés de Xabber, mais le XMPP basique fonctionnera comme auparavant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете из аккаунта Xabber. Вы не сможете использовать расширенные сервисы Xabber, но обычные XMPP аккаунты будут работать как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将退出 Xabber 帐户。您将无法使用增强的 Xabber 服务, 但基本 XMPP 将照常工作。"
          }
        }
      }
    },
