    "xmpp_login__registration_title_avatar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice! Now set up a profile image best representing your identity."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично! Теперь создайте изображение профиля, лучше всего представляющее вашу личность."
          }
        }
      }
    },
    "xmpp_login__registration_title_jid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! Now, choose username and domain for people to find you on Xabber"
          }
        }
      }
    },
    "xmpp_login__registration_title_nickname": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s get Started!\nWhat’s your name?"
