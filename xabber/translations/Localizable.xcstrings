                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "في الدوائر %2$@"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "في الدائرة %2$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "في الدوائر %2$@"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "في الدائرتين %2$@"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "في الدوائر %2$@"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@circle@"
          },
          "substitutions": {
            "circle": {
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "in circle %2$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "in circles %2$@"
