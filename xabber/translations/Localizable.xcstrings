    "account_invalid_port": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنفذ يجب أن يكون رقماً (الافتراضي: 5222)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must be a number (default: 5222)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto debe ser un número (por defecto: 5222)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port doit être un nombre (défaut : 5222)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт должен быть числом (значение по умолчанию: 5222)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口必须是整数（默认：5222）"
          }
        }
      }
    },
    "account_invalid_port_range": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنفذ يجب أن يتراوح بين 1 إلى 65535 (الافتراضي: 5222)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port must be between 1 and 65535 (default: 5222)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto debe estar entre 1 y 65535 (predeterminado: 5222)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port doit être compris entre 1 et 65535 (défaut : 5222)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт должен быть числом между 1 и 65535 (значение по умолчанию: 5222)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口必须介于 1 和 65535 之间 (默认: 5222)"
          }
        }
      }
    },
    "account_invalid_priority": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمة الأولوية يجب أن تكون بين -128 و 127 (الافتراضي: 10)"
          }
