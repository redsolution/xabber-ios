        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在隐身群组中，成员使用化名，对其他人隐藏 XMPP ID。"
          }
        }
      }
    },
    "contacts__list__incoming_requests_description": {
      "comment": "Contacts / list: user-visible subtitle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة طلبات جهات الاتصال الواردة. بعد القبول، يمكن لجهات الاتصال إرسال الرسائل بحرية ومشاركة معلومات التواجد."
