    "subscription_status_description_both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and this contact are sharing presence information with each other."
          }
        }
      }
    },
    "subscription_status_description_out_none_in_from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact receives your presence information.\n \n You have not sent a request to access presence information of this contact."
          }
        }
      }
    },
    "subscription_status_description_out_none_in_not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact is added to your roster, but presence information is not shared in either direction.\n \n Incoming subscription requests will not be accepted automatically."
          }
        }
      }
    },
    "subscription_status_description_out_none_in_request_incoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact has sent you a request to see your presence information.\n \n You have not sent a request to access presence information of this contact."
          }
        }
      }
    },
    "subscription_status_description_out_requested_in_from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have sent a request to see presence information of this contact. It is not yet answered.\n \nThe contact receives your presence information.\n"
          }
        }
      }
    },
    "subscription_status_description_out_requested_in_not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have sent a request to see presence information of this contact. It is not yet answered.\n \n Incoming subscription requests will not be accepted automatically."
          }
        }
      }
    },
    "subscription_status_description_out_requested_in_request_incoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and this contact have both sent each other requests to see each other's presence information. Generally, mutual subscription requests are automatically accepted, so you should not be seeing this description, ever. But since you do, it means that something went wrong, huh."
          }
        }
      }
    },
    "subscription_status_description_out_to_in_not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive presence information for this contact, but the contact has not asked to see yours.\n \n Incoming subscription requests will not be accepted automatically."
          }
        }
      }
    },
    "subscription_status_description_out_to_in_request_incoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive presence information for this contact, and the contact has sent you a request to see your presence information.\n"
          }
        }
      }
    },
