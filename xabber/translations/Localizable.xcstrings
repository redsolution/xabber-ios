          }
        }
      }
    },
    "settings__interface_language__text_description_full_translation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already fully translated to the language used on this device. Translations are provided by the community. If you feel that the translation is imperfect, you can join our translation team and help us make %2$@ better."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ уже полностью переведен на язык, используемый на этом устройстве. Переводы осуществляются сообществом. Если вы считаете, что перевод несовершенен, вы можете присоединиться к нашей команде переводчиков и помочь нам сделать %2$@ лучше."
          }
        }
      }
    },
    "settings__interface_language__text_description_full_translation_platform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use Crowdin Localisation Management Platform. If you wish to participate, follow this %@ and apply as a translator to your native language."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы используем платформу управления локализацией CrowdIn. Если вы хотите присоединиться к нашей команде переводчиков, перейдите по ссылке %@ и подайте заявку на участие в роли переводчика на ваш родной язык."
          }
        }
      }
    },
    "settings__interface_language__text_description_no_translation_platform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use Crowdin Localisation Management Platform. If you wish to join our translation team, follow this %1$@, email us %2$@ and we will add your native language to the list of target languages. Then you will be able to apply as a translator to your native language."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы используем платформу управления локализацией Crowdin. Если вы хотите присоединиться к нашей команде переводов, перейдите по ссылке %1$@. Напишите нам по адресу %2$@ и мы добавим ваш родной язык в список целевых языков. После этого вы сможете перевести приложение на ваш родной язык."
          }
        }
      }
    },
    "settings__interface_language__text_description_unfull_translation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is only partially translated to the language used on this device. Translations are provided by the community, it means that you can help us translate %2$@ to your native language!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ лишь частично переведен на язык, используемый на этом устройстве. Переводы осуществляются сообществом, это означает, что вы можете помочь нам перевести %2$@ на ваш родной язык!"
          }
        }
      }
    },
