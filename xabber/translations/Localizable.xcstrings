    "about_xabber": {
      "comment": "Product description shown on the About screen. Existing trusted inline markup is retained for compatibility.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino هو برنامج مراسلة XMPP <u><b>مفتوح</b> <i>المصدر</i></u> لمنصات Android وiOS والويب. وقد بُني على المعايير المفتوحة وقابلية التشغيل البيني والتصميم وتجربة المستخدم الرائعة. صُممت إصدارات Clandestino لكل منصة لتوفير تجربة دردشة متواصلة بينها.\nستجد مزيدًا من المعلومات على موقعنا الرسمي https://xabber.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino is an <u><b>open</b> <i>source</i></u> XMPP messenger for Android, iOS and Web platforms. It is build around open standards, interoperability, design and great user experience. Versions of Clandestino for every platform are built to provide a continuous chat experience between them.\nYou will find more information on our official website https://xabber.com"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino es un mensajero XMPP de <u><b>código</b> <i>abierto</i></u> para las plataformas Android, iOS y Web. Está basado en estándares abiertos, interoperabilidad, diseño y una excelente experiencia de usuario. Las versiones de Clandestino para cada plataforma están creadas para ofrecer una experiencia de chat continua entre ellas.\nEncontrarás más información en nuestro sitio web oficial https://xabber.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino est un messager XMPP <u><b>à code</b> <i>source ouvert</i></u> pour Android, iOS et le Web. Il repose sur des normes ouvertes, l’interopérabilité, le design et une excellente expérience utilisateur. Les versions de Clandestino pour chaque plateforme sont conçues pour offrir une expérience de messagerie continue entre elles.\nVous trouverez plus d’informations sur notre site officiel https://xabber.com"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino — XMPP-мессенджер с <u><b>открытым</b> <i>исходным кодом</i></u> для платформ Android, iOS и Web. Он основан на открытых стандартах, совместимости, продуманном дизайне и удобстве использования. Версии Clandestino для разных платформ обеспечивают непрерывное общение между устройствами.\nДополнительную информацию можно найти на нашем официальном сайте https://xabber.com"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clandestino 是一款适用于 Android、iOS 和 Web 平台的 <u><b>开放</b><i>源代码</i></u> XMPP 即时通讯应用。它围绕开放标准、互操作性、设计和出色的用户体验而构建。各平台的 Clandestino 版本共同提供连贯的聊天体验。\n请访问我们的官方网站 https://xabber.com 了解更多信息"
          }
        }
      }
    },
