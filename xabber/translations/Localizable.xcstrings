    "appearance__bubble_preview__bubble_message": {
      "comment": "Sample chat message used to preview the bubble message style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأرسل الصورة عندما أصل إلى المنزل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll send the photo when I get home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaré la foto cuando llegue a casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’enverrai la photo quand je rentrerai chez moi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я отправлю фотографию, когда вернусь домой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我到家后会把照片发给你。"
          }
        }
      }
    },
    "appearance__bubble_preview__bubbles_message": {
      "comment": "Sample chat message used to preview the bubbles message style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح المقهى الساعة الثامنة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coffee place opens at eight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cafetería abre a las ocho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le café ouvre à huit heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кофейня открывается в восемь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡店八点开门。"
          }
        }
      }
    },
    "appearance__bubble_preview__curvy_message": {
      "comment": "Sample chat message used to preview the curvy message-bubble style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكننا التحدث مجددًا صباح الغد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can talk again tomorrow morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos volver a hablar mañana por la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On pourra en reparler demain matin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы можем снова поговорить завтра утром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们明天早上可以再聊。"
          }
        }
      }
    },
    "appearance__bubble_preview__no_tail_message": {
      "comment": "Sample chat message used to preview the no-tail message-bubble style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكننا أن نلتقي اليوم بعد الغداء؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can we meet after lunch today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Podemos vernos hoy después de comer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On peut se retrouver après le déjeuner aujourd’hui ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можем встретиться сегодня после обеда?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们今天午饭后能见面吗？"
          }
        }
      }
    },
    "appearance__bubble_preview__smooth_message": {
      "comment": "Sample chat message used to preview the smooth message-bubble style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغادر القطار بعد عشرين دقيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The train leaves in twenty minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tren sale dentro de veinte minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le train part dans vingt minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поезд отправляется через двадцать минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "火车二十分钟后出发。"
          }
        }
      }
    },
    "appearance__bubble_preview__stripes_message": {
      "comment": "Sample chat message used to preview the striped message-bubble style.",
      "extractionState": "manual",
      "localizations": {
