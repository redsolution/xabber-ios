    "appearance__theme_preview__message_answer": {
      "comment": "Synthetic interface appearance preview copy; localize because it is visible UI and must demonstrate the selected language and RTL direction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استدر نحو الكاميرا، من فضلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn toward the camera, please."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira hacia la cámara, por favor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez-vous vers l’objectif, s’il vous plaît."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернитесь к камере, пожалуйста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请转向镜头。"
          }
        }
      }
    },
    "appearance__theme_preview__message_closing": {
      "comment": "Synthetic interface appearance preview copy; localize because it is visible UI and must demonstrate the selected language and RTL direction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل هذا كل شيء؟ بدا لي أنه قال أكثر من ذلك بكثير. 😮"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is that everything? It seemed like he said quite a bit more than that. 😮"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eso es todo? Parecía que había dicho bastante más. 😮"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est tout ? Il me semblait qu’il en avait dit bien plus. 😮"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И это всё? Кажется, он сказал гораздо больше. 😮"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就这些吗？感觉他说的远不止这些。😮"
          }
        }
      }
    },
