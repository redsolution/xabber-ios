          }
        }
      }
    },
    "intro_incognito_group_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى هويات المستخدمين في هذه المجموعة عن بعضهم بعضًا، ولا يمكن الوصول إلى معرّف XMPP الحقيقي الخاص بك إلا لمسؤولي المجموعة. كن متيقظًا، ولا تكشف عن هويتك بسبب الإهمال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identities of users in this group are kept hidden from each other, only group admins can access your real XMPP ID. Be vigilant, do not disclose yourself by being careless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las identidades de los usuarios de este grupo permanecen ocultas entre sí; solo los administradores del grupo pueden acceder a tu ID de XMPP real. Mantente alerta y no reveles tu identidad por descuido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identités des utilisateurs de ce groupe sont cachées les unes des autres, seuls les administrateurs de groupe peuvent accéder à votre véritable ID XMPP. Soyez vigilant, ne vous divulguez pas en étant insensé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификаторы пользователей в этой группе скрыты от участников, досуп к вашему XMPP ID могут получить только администраторы. Будьте бдительны. Не компрометируйте себя непродуманными действиями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组中用户的身份彼此隐藏，只有群组管理员可以访问你的真实 XMPP ID。请保持警惕，不要因疏忽泄露自己的身份。"
          }
        }
      }
    },
