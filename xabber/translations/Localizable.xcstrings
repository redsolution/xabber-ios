    "username_rules": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم قد يحتوي على أحرف صغيرة اللاتينية الحروف والأرقام والنقاط فقط"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username may contain only lowercase latin letters, numbers and dots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario debe contener solamente minúsculas, letras latinas, números y puntos"
