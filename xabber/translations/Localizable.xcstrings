    "credentials_expired__prompt__ownership_explanation": {
      "comment": "Expired credentials prompt: visible label.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطلب منك أحيانًا إدخال كلمة المرور للتأكد من أنك المالك الشرعي لهذا الحساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes we ask for you to enter your password to confirm that you are the rightful owner of this account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces te pedimos que introduzcas tu contraseña para confirmar que eres el propietario legítimo de esta cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous demandons parfois de saisir votre mot de passe afin de confirmer que vous êtes bien le propriétaire de ce compte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иногда мы просим вас ввести пароль, чтобы подтвердить, что вы являетесь владельцем этой учётной записи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有时我们会要求你输入密码，以确认你是此账户的合法所有者"
          }
        }
      }
    },
