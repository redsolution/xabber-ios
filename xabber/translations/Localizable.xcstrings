    "about_extension_protocols": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP قابل للتوسعة بدرجة كبيرة عبر الامتدادات المعروفة باسم XEPs (بروتوكولات امتداد XMPP). يدعم Xabber عددًا من امتدادات XEP الشائعة الضرورية لتوفير تجربة دردشة رائعة لمستخدمينا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP is highly extensible, via extensions known as XEPs (XMPP Extension Protocol). Xabber supports a number of popular XEPs that are essential to providing great chat experience for our users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP es muy extensible, mediante extensiones conocidas como XEP (XMPP Extension Protocol). Xabber admite varios XEP populares que son esenciales para ofrecer a nuestros usuarios una excelente experiencia de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP est hautement extensible grâce à des extensions appelées XEP (XMPP Extension Protocol). Xabber prend en charge plusieurs XEP populaires, essentielles pour offrir à nos utilisateurs une excellente expérience de messagerie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP хорошо расширяется посредством протоколов, известных как XEPs (протоколы расширения XMPP). Xabber поддерживает несколько популярных XEPs, которые необходимы для создания чата для наших пользователей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP 具有高度可扩展性，可通过称为 XEP（XMPP 扩展协议）的扩展来增强功能。Xabber 支持多种常用 XEP，它们对于为用户提供出色的聊天体验至关重要。"
          }
        }
      }
    },
