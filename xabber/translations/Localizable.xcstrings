    "settings_circles_partial_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل %@ من تحديثات قائمة جهات الاتصال. تعيد المحاولة إرسال الفرق المتبقي فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ roster updates failed. Retry sends only the remaining difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjeron errores en %@ actualizaciones de la lista de contactos. Al reintentar, solo se enviará la diferencia restante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mises à jour de la liste ont échoué. Une nouvelle tentative n’enverra que les modifications restantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить %@ изменений ростера. Повторная попытка отправит только оставшуюся разницу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 次联系人列表更新失败。重试时只会发送剩余差异。"
          }
        }
      }
    },
