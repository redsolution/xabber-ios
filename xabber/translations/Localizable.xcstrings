    "intro_saved_messages_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الملاحظات والروابط والملفات والرسائل المُعاد توجيهها هنا. تتزامن رسائلك المحفوظة عبر أجهزتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save notes, links, files, and forwarded messages here. Your saved messages are synchronized across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda aquí notas, enlaces, archivos y mensajes reenviados. Tus mensajes guardados se sincronizan entre tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ici des notes, des liens, des fichiers et des messages transférés. Vos messages enregistrés sont synchronisés sur tous vos appareils."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте здесь заметки, ссылки, файлы и пересланные сообщения. Избранное синхронизируется между вашими устройствами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里保存笔记、链接、文件和转发的消息。已保存的消息会在你的设备间同步。"
          }
        }
      }
    },
