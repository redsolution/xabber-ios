    "summary_xabber_account_in_login": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Xabber مطلوب لاستخدام خدمات Xabber ومزامنة إعدادات الجهاز."
          }
        },
        "en": {
          "stringUnit": {
