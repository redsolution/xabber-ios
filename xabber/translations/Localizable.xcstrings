    "summary_xabber_account_in_login": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Xabber مطلوب لاستخدام خدمات Xabber ومزامنة إعدادات الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber account is required to use Xabber services and sync device settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesaria una cuenta de Xabber para utilizar los servicios de Xabber y sincronizar los ajustes del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Xabber est nécessaire pour utiliser les services de Xabber et synchroniser les paramètres de l’appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
