    "signin_file_upload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File upload"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка файлов"
          }
        }
      }
    },
    "signin_file_upload_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File upload is not supported. Without file upload, you will not be able to send images, voice messages and other media to your contacts. It is not recommended to use Xabber on servers without file upload support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка файлов не поддерживается. Без загрузки файла вы не сможете отправлять изображения, голосовые сообщения и другие медиа вашим контактам. Не рекомендуется использовать Xabber на серверах без поддержки загрузки."
          }
        }
      }
    },
    "signin_lets_rock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's rock!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поехали!"
          }
        }
      }
    },
    "signin_message_archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message archive"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив сообщений"
          }
        }
      }
    },
    "signin_message_archive_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message Archive is not supported. Without Message Archive you can’t synchronize chat history between server and connected clients.  Xabber can not be used on servers that do not support message archive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив сообщений не поддерживается. Без архива сообщений вы не сможете синхронизировать историю чата между сервером и подключенными клиентами. Xabber не может быть использован на серверах, которые не поддерживают архив сообщений."
          }
        }
      }
    },
    "signin_message_editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message editing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование сообщений"
          }
        }
      }
    },
    "signin_message_editing_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message editing is not supported. You will not be able to edit or delete messages from this server’s Message Archive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование сообщений не поддерживается. Вы не сможете редактировать или удалять сообщения из архива сообщений этого сервера."
          }
        }
      }
    },
    "signin_no_message_archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not support message archive. It is impossible for Xabber to work without message archive, so we suggest creating a new account on a fully-compatible Xabber.chat server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не поддерживает архив сообщений. Xabber не может работать без архива сообщений, поэтому мы предлагаем создать новую учетную запись на полностью совместимом сервере Xabber.chat."
          }
        }
      }
    },
    "signin_not_all_features": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all necessary features are supported. Proceed using this account at your own risk, and with low expectations. However, we suggest creating a new account on a fully-compatible Xabber.chat server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не все необходимые функции поддерживаются. Продолжайте пользоваться этим аккаунтом на свой страх и риск. Тем не менее, мы предлагаем создать новую учетную запись на полностью совместимом сервере Xabber.chat."
          }
        }
      }
    },
    "signin_proceed_anyway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceed anyway"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить в любом случае"
          }
        }
      }
    },
    "signin_publish_subscribe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish-subscribe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация-подписка"
          }
        }
      }
    },
    "signin_pubsub_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub is not supported. Without publish-subscribe, you can’t use modern encryption, set user avatar, etc. It is not recommended to use Xabber on this server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PubSub не поддерживается. Без подписки на публикацию вы не можете использовать современное шифрование, установить пользовательский аватар и т. д. Не рекомендуется использовать Xabber на этом сервере."
          }
        }
      }
    },
    "signin_push_notifications_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push notifications are not supported. Your device won’t be able to receive incoming messages when Xabber is not active. It is not recommended to use Xabber on this server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-уведомления не поддерживаются. Ваше устройство не сможет принимать входящие сообщения, если Xabber не активен. Не рекомендуется использовать Xabber на этом сервере."
          }
        }
      }
    },
    "signin_quick_synchronization_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick synchronization is not supported. This feature allows robust work on mobile devices and greatly improves user experience. It is not recommended to use Xabber on servers without quick synchronization."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая синхронизация не поддерживается. Эта функция позволяет надежно работать на мобильных устройствах и значительно улучшает взаимодействия пользователя. Не рекомендуется использовать Xabber на серверах без быстрой синхронизации."
          }
        }
      }
    },
    "signin_server_capabilities": {
      "comment": "Server capabilities section title on the sign-in screen.",
