    "about_extension_protocols": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP is highly extensible, via extensions known as XEPs (XMPP Extension Protocol). Xabber supports a number of popular XEPs that are essential to providing great chat experience for our users."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "XMPP хорошо расширяется посредством протоколов, известных как XEPs (протоколы расширения XMPP). Xabber поддерживает несколько популярных XEPs, которые необходимы для создания чата для наших пользователей."
          }
        }
      }
    },
