    "report_success_developer_operated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال البلاغ. شكرًا لمساعدتك في الحفاظ على أمان الخدمة. تتم مراجعة البلاغات المتعلقة بالخدمات التي يشغّلها المطور خلال 24 ساعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report submitted. Thank you for helping keep the service safe. Reports for developer-operated services are reviewed within 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe enviado. Gracias por ayudar a mantener la seguridad del servicio. Los informes sobre servicios operados por el desarrollador se revisan en un plazo de 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalement envoyé. Merci de nous aider à assurer la sécurité du service. Les signalements concernant les services exploités par le développeur sont examinés sous 24 heures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба отправлена. Спасибо, что помогаете обеспечивать безопасность службы. Жалобы на службы под управлением разработчика рассматриваются в течение 24 часов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已提交。感谢你帮助维护服务安全。针对开发者运营服务的举报会在 24 小时内得到审核。"
          }
        }
      }
    },
    "report_success_third_party": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال البلاغ. نظرًا إلى أن جهة خارجية قد تشغّل هذا الخادم، فقد تعتمد إجراءات الإشراف على مشغّل الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report submitted. Because this server may be operated by a third party, moderation actions may depend on the server operator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe enviado. Como este servidor puede estar operado por un tercero, las medidas de moderación pueden depender del operador del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalement envoyé. Ce serveur pouvant être exploité par un tiers, les mesures de modération peuvent dépendre de son opérateur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба отправлена. Поскольку этим сервером может управлять третья сторона, действия модерации могут зависеть от оператора сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已提交。由于此服务器可能由第三方运营，审核措施可能取决于服务器运营方。"
          }
        }
      }
    },
