          "stringUnit": {
            "state": "translated",
            "value": "您的 %1$@ 帐户将与创建帐户相关联"
          }
        }
      }
    },
    "simple__alert_message__enter_your_password_to_permanently_delete_value_from_clandestino_this_action_can": {
      "comment": "Hard-coded alertMessage copy used by SimpleTableViewController. Each %@ placeholder is a runtime value and must be preserved in translation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة المرور لحذف %@ نهائيًا من Clandestino.\n\nلا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password to permanently delete %@ from Clandestino.\n\nThis action can not be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu contraseña para eliminar permanentemente %@ de Clandestino.\n\nEsta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre mot de passe pour supprimer définitivement %@ de Clandestino.\n\nCette action est irréversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль, чтобы навсегда удалить %@ из Clandestino.\n\nЭто действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入密码以从 Clandestino 中永久删除 %@。\n\n此操作无法撤销。"
          }
        }
      }
    },
