      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask to register on Xabber.com if his xmpp server is old."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить зарегистрироваться на Xabber.com, если его xmpp сервер старый."
          }
        }
      }
    },
    "signin_checking_features_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang on there a second! Checking if %@ supports all necessary features."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите секунду! Проверяем, поддерживает ли %@ все необходимые функции."
          }
        }
      }
    },
    "signin_cloud_storage": {
      "comment": "Cloud Storage capability label on the server sign-in screen.",
