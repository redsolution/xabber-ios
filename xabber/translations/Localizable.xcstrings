          }
        }
      }
    },
    "signin_server_capabilities_partial_failure_subtitle": {
      "comment": "Detailed sign-in status shown when only some server capabilities could be verified.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من بعض إمكانات الخادم الآن. يمكنك المتابعة بأمان؛ سيعيد التطبيق المحاولة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some server capabilities could not be verified right now. You can continue safely; the app will retry automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas capacidades del servidor no se pudieron comprobar ahora. Puedes continuar de forma segura; la aplicación volverá a intentarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines capacités du serveur n’ont pas pu être vérifiées pour le moment. Vous pouvez continuer en toute sécurité ; l’application réessaiera automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые возможности сервера сейчас не удалось проверить. Можно безопасно продолжить работу: приложение повторит попытку автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法验证部分服务器能力。你可以安全地继续；应用会自动重试。"
          }
        }
      }
    },
    "signin_server_capabilities_retryable_failure": {
      "comment": "Retryable server-capability check explanation on the sign-in screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إكمال فحص إمكانات الخادم. هذا مؤقت ولا يعني أن الخادم يفتقر إلى هذه الميزات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server capability check could not be completed. This is temporary and does not mean that the server lacks these features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la comprobación de capacidades del servidor. Es algo temporal y no significa que el servidor carezca de estas funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des capacités du serveur n’a pas pu aboutir. Ce problème est temporaire et ne signifie pas que le serveur ne dispose pas de ces fonctionnalités."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить проверку возможностей сервера. Это временная проблема, которая не означает, что сервер не поддерживает эти функции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成服务器能力检查。这只是暂时情况，并不表示服务器缺少这些功能。"
          }
        }
      }
    },
    "signin_server_capabilities_retryable_subtitle": {
      "comment": "Short sign-in status explaining that server capability discovery will retry automatically.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة فحص إمكانات الخادم تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server capabilities will be checked again automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capacidades del servidor se volverán a comprobar automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capacités du serveur seront de nouveau vérifiées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможности сервера будут повторно проверены автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会自动再次检查服务器能力。"
          }
        }
      }
    },
    "signin_server_capabilities_retryable_title": {
      "comment": "Retryable server-capability alert. Argument 1 is the server domain.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من جميع إمكانات %1$@ الآن. يمكنك المتابعة؛ سيعيد التطبيق المحاولة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify all capabilities of %1$@ right now. You can continue; the app will retry automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido comprobar ahora todas las capacidades de %1$@. Puedes continuar; la aplicación volverá a intentarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier toutes les capacités de %1$@ pour le moment. Vous pouvez continuer ; l’application réessaiera automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось проверить все возможности %1$@. Можно продолжить работу: приложение повторит попытку автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法验证 %1$@ 的全部能力。你可以继续；应用会自动重试。"
          }
        }
      }
    },
    "signin_server_features": {
      "extractionState": "manual",
