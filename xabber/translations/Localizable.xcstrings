    "groupchat_settings_permissions__table_section_title__default_permissions_apply_to_members_unless_a_personal_permission_overrides_them": {
      "comment": "Hard-coded tableSectionTitle copy used by GroupchatSettingsPermissionsViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبّق الأذونات الافتراضية على الأعضاء ما لم يتجاوزها إذن شخصي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default permissions apply to members unless a personal permission overrides them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos predeterminados se aplican a los miembros salvo que un permiso personal los sustituya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations par défaut s’appliquent aux membres, sauf si une autorisation personnelle les remplace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения по умолчанию применяются к участникам, если их не переопределяют персональные разрешения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认权限适用于成员，除非个人权限将其覆盖。"
          }
        }
      }
    },
    "groupchat_settings_permissions__table_section_title__new_member_permissions_replace_the_full_temporary_permission_set": {
      "comment": "Hard-coded tableSectionTitle copy used by GroupchatSettingsPermissionsViewController. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحل أذونات الأعضاء الجدد محل مجموعة الأذونات المؤقتة بالكامل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New-member permissions replace the full temporary permission set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos de nuevos miembros sustituyen todo el conjunto de permisos temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations des nouveaux membres remplacent l’ensemble complet des autorisations temporaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения для новых участников полностью заменяют временный набор разрешений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新成员权限会替换整套临时权限。"
          }
        }
      }
    },
    "groupchat_settings_view_controller_t__error_message__unable_to_send_file_out_of_cloud_storage": {
      "comment": "Hard-coded errorMessage copy used by AccountEditViewController+Flow. Shown to the user or exposed through accessibility/error presentation. Hard-coded errorMessage copy used by AccountInfoViewController+InfoScreenHeaderButtonDelegate. Shown to the user or exposed through accessibility/error presentation. Hard-coded errorMessage copy used by GroupchatSettingsViewControllerT. Shown to the user or exposed through accessibility/error presentation. Hard-coded errorMessage copy used by SettingsViewController+InfoScreenHeaderButtonDelegate. Shown to the user or exposed through accessibility/error presentation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال الملف: نفدت مساحة التخزين السحابي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to send file: out of Cloud Storage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el archivo: sin espacio en Almacenamiento en la nube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer le fichier : espace du Stockage cloud épuisé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить файл: в Облачном хранилище нет места"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送文件：云存储空间不足"
          }
        }
      }
    },
