    "intro_regular_chat_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https://www.xabber.com/learn/regular"
          }
        },
        "fr": {
          "stringUnit": {
