    "try_to_add_a_contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to add a contact"
          }
        }
      }
    },
    "try_to_start_new_chat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to start a new chat"
          }
        }
      }
    },
    "tutorial_description_1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المصدر المفتوح XMPP العميل لاجهزة اندرويد مع دعم الحسابات متعددة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source XMPP client for Android with multiple accounts support"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliente de código abierto XMPP para Android con soporte de múltiples cuentas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободный XMPP клиент для Android с поддержкой нескольких аккаунтов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源 XMPP 客户端, 适用于 android, 支持多个账户"
          }
        }
      }
    },
    "tutorial_description_2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير مقيد باستخدام مزود خدمة واحد. يعمل Xabber مع أي خادم XMPP متوافق مع خدماتنا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not locked into using a single service provider. Xabber works with to any standard-compliant XMPP server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No estás limitado a un único proveedor de servicio. Xabber funciona con cualquier servidor conforme con el estándar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не попадете в зависимость от единственного поставщика услуги. Xabber работает с любым стандартным XMPP сервером"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您不会被锁定使用单个服务提供商。xabber 适用于任何符合标准的 XMPP 服务器"
          }
        }
      }
    },
    "tutorial_description_3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال متعددة للصور وملفات الفيديو والصوت أو الرسائل الصوتية، اعرضها وعدلها بسلاسة في إطار المحادثة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send multiple images, video and audio files or voice messages, viewing and playing them seamlessly in chat window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar múltiples imágenes, archivos de audio y video o mensajes de voz, visualizando y reproduciéndolos sin problemas en la ventana de chat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте изображения, видео и аудио файлы, голосовые сообщения, просматривая их прямо в окне чата"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送多个图像、视频和音频文件或语音消息, 在聊天窗口中无缝查看和播放它们"
          }
        }
      }
    },
    "tutorial_description_4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأقصى قدر من الخصوصية، استخدام الملقم الأمن الجدير بالثقة وتمتع بتشفير للاتصالات الخاصة بك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For maximum privacy, use a trustworthy secure server and end-to-end encryption for your communications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para máxima privacidad, use un servidor seguro confiable y cifrado de extremo a extremo para sus comunicaciones"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для максимальной безопасности, используйте для общения оконечное шифрование и надежные сервера с хорошей репутацией"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了获得最大的隐私, 请使用值得信赖的安全服务器和端到端加密进行通信"
          }
        }
      }
    },
    "tutorial_description_5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصدارات Xabber لاجهزة اندرويد وشبكات الانترنت يعمل على كافة نظم التشغيل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions of Xabber for Android, iOS and Web provide you consistent chat experience on every OS and device type"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiones de Xabber para Android, iOS y Web le proporcionan una experiencia de chat constante en todos los dispositivos y sistemas operativos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версии Xabber одинаково хорошо работают в браузерах и на мобильных устройствах всех типов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android、iOS 和 Web 的 Xabber 版本可在每个操作系统和设备类型上为您提供一致的聊天体验"
          }
        }
      }
    },
    "tutorial_description_6": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Xabber يتيح لك بسهولة مزامنة الحسابات الخاصة بك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber account lets you easily sync your accounts and their settings between devices and platforms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de Xabber le permite sincronizar fácilmente sus cuentas y sus configuraciones entre dispositivos y plataformas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С помощью аккаунта Xabber можно легко синхронизировать настройки приложения между своими устройствами"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber 帐户可让您轻松地在设备和平台之间同步您的帐户及其设置"
          }
        }
      }
    },
    "tutorial_description_7": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك اختيار مخدم موثوق به لنفسك والدردشة مع جهات الاتصال التي تستخدم مخدمات أخرى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose a trustworthy server for yourself and chat with contacts who are using other servers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted puede elegir un servidor confiable para usted y chatear con contactos que están usando otros servidores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете использовать один сервер и общаться с пользователями, использующими другие сервера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以为自己选择值得信赖的服务器, 并与使用其他服务器的联系人聊天"
          }
        }
      }
    },
    "tutorial_description_8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم صحة المعلومات الاجتماعية للدخول بسرعة إلى Xabber والاتصال على الفور بجميع الحسابات الخاصة بك على جهازك جديد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use social authentification to quickly log in to Xabber and instantly connect all your accounts on new device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use autenticación social para entrar rápidamente en Xabber y conectar instantáneamente todas sus cuentas en un nuevo dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Социальная аутентификация позволяет быстро войти в Xabber и сразу загрузить все свои аккаунты и настройки на новое устройство"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用社交认证快速登录 Xabber, 并在新设备上立即连接您的所有帐户"
          }
        }
      }
    },
    "tutorial_description_9": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تطوير Xabber على GitHub بواسطة مجتمع مفتوح. أي شخص مرحب به للمشاركة من خلال الإبلاغ عن الأخطاء أو رمز المساهمة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber is developed on GitHub by an open community. Anyone is welcome to participate by reporting bugs or contributing code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber es desarrollado en GitHub por una comunidad abierta. Cualquiera es bienvenido a participar a través de informes de errores o aportes de código"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа по разработке Xabber организована через GitHub. Мы рады всем участникам проекта: разработчикам, переводчикам, тестерам"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xabber是由开放社区在GitHub上开发的。 欢迎任何人通过报告错误或贡献代码参与"
          }
        }
      }
    },
