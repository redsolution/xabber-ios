    "cache_clear": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح البيانات\nمسح كل البيانات المخزنة على الجهاز. هذا قد يحرر بعض المساحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear cache\nClear all local data. This can free up some space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar caché\nEliminar todos los datos almacenados. Esto puede liberar algo de espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le cache\nSupprime toutes les données locales. Peut libérer de l'espace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить кэш\nУдалить все сохранённые локально данные. Это позволит уменьшить занимаемое программой место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除缓存\n清除所有本地数据，这可以释放一些空间。"
          }
        }
      }
    },
    "cache_clear_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل حقاً تريد حذف سجل المحادثات وكافة البيانات المحلية؟\nلن يتأثر الحساب ولا بيانات قائمة الاتصال. سيتم غلق التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to remove chat history and other local data?\nAccount and roster data are not affected. The app will close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar todo el historial y otros datos almacenados?\nLa información de la cuenta y de la lista de contactos no se verá afectada. La aplicación se cerrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer les historiques des conversations et autres données locales ?\nLes paramètres des comptes et les listes de contacts ne seront pas affectés. L'application sera fermée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите удалить историю переписки, а также другие сохранённые локально данные?\nОбщие настройки и данные учетных записей будут сохранены. Приложение будет закрыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确实要删除聊天记录和其他本地数据吗？\n账户和联系人数据不会受影响，该程序将会关闭。"
          }
        }
      }
    },
