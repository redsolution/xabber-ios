    "subscription_status_description_both": {
      "comment": "Edit Contact subscription footer: both parties currently share presence information.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبادل أنت وجهة الاتصال هذه معلومات الحضور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and this contact are sharing presence information with each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú y este contacto compartís información de presencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous et ce contact partagez vos informations de présence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и этот контакт обмениваетесь информацией о присутствии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你和此联系人正在互相共享在线状态信息。"
          }
        }
      }
    },
    "subscription_status_description_out_none_in_allowed": {
      "comment": "Edit Contact subscription footer: no presence is shared and future incoming subscription requests will be auto-accepted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيفت جهة الاتصال إلى قائمتك، لكن معلومات الحضور لا تتم مشاركتها في أي من الاتجاهين.\n\nسيتم قبول طلبات الاشتراك الواردة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact is added to your roster, but presence information is not shared in either direction.\n\nIncoming subscription requests will be accepted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto se ha añadido a tu lista, pero la información de presencia no se comparte en ninguna dirección.\n\nLas solicitudes de suscripción entrantes se aceptarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact est ajouté à votre liste, mais les informations de présence ne sont partagées dans aucun sens.\n\nLes demandes d’abonnement entrantes seront acceptées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт добавлен в ваш список, но информация о присутствии не передаётся ни в одном направлении.\n\nВходящие запросы на подписку будут приниматься автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人已添加到你的联系人列表，但双方均未共享在线状态信息。\n\n传入的订阅请求将自动接受。"
          }
        }
      }
    },
    "subscription_status_description_out_none_in_from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact receives your presence information.\n \n You have not sent a request to access presence information of this contact."
          }
        }
      }
    },
    "subscription_status_description_out_none_in_not_allowed": {
      "comment": "Edit Contact subscription footer: no presence is shared and future incoming subscription requests will require manual approval.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيفت جهة الاتصال إلى قائمتك، لكن معلومات الحضور لا تتم مشاركتها في أي من الاتجاهين.\n\nلن يتم قبول طلبات الاشتراك الواردة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact is added to your roster, but presence information is not shared in either direction.\n \n Incoming subscription requests will not be accepted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto se ha añadido a tu lista, pero la información de presencia no se comparte en ninguna dirección.\n\nLas solicitudes de suscripción entrantes no se aceptarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact est ajouté à votre liste, mais les informations de présence ne sont partagées dans aucun sens.\n\nLes demandes d’abonnement entrantes ne seront pas acceptées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт добавлен в ваш список, но информация о присутствии не передаётся ни в одном направлении.\n\nВходящие запросы на подписку не будут приниматься автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人已添加到你的联系人列表，但双方均未共享在线状态信息。\n\n传入的订阅请求不会自动接受。"
          }
        }
      }
    },
    "subscription_status_description_out_none_in_request_incoming": {
      "comment": "Edit Contact subscription footer: the contact requested the user's presence while the user has not requested the contact's presence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلت إليك جهة الاتصال طلبًا للاطلاع على معلومات حضورك.\n\nلم ترسل طلبًا للوصول إلى معلومات حضور جهة الاتصال هذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact has sent you a request to see your presence information.\n \n You have not sent a request to access presence information of this contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto te ha enviado una solicitud para ver tu información de presencia.\n\nNo has enviado una solicitud para acceder a la información de presencia de este contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact vous a envoyé une demande pour voir vos informations de présence.\n\nVous n’avez pas envoyé de demande pour accéder aux informations de présence de ce contact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт отправил вам запрос на получение информации о вашем присутствии.\n\nВы не отправляли запрос на доступ к информации о присутствии этого контакта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人已向你发送查看在线状态信息的请求。\n\n你尚未发送访问该联系人在线状态信息的请求。"
          }
        }
      }
    },
    "subscription_status_description_out_requested_in_allowed": {
      "comment": "Edit Contact subscription footer: the user's presence request is pending and future incoming requests will be auto-accepted.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلت طلبًا للاطلاع على معلومات حضور جهة الاتصال هذه، ولم تتم الإجابة عنه بعد.\n\nسيتم قبول طلبات الاشتراك الواردة تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have sent a request to see presence information of this contact. It is not yet answered.\n\nIncoming subscription requests will be accepted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has enviado una solicitud para ver la información de presencia de este contacto. Todavía no ha recibido respuesta.\n\nLas solicitudes de suscripción entrantes se aceptarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé une demande pour voir les informations de présence de ce contact. Elle n’a pas encore reçu de réponse.\n\nLes demandes d’abonnement entrantes seront acceptées automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправили запрос на получение информации о присутствии этого контакта. Ответ пока не получен.\n\nВходящие запросы на подписку будут приниматься автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已发送查看此联系人在线状态信息的请求，但尚未收到回复。\n\n传入的订阅请求将自动接受。"
          }
        }
      }
    },
    "subscription_status_description_out_requested_in_from": {
      "comment": "Edit Contact subscription footer: the user's request is pending while the contact already receives the user's presence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أرسلت طلبًا للاطلاع على معلومات حضور جهة الاتصال هذه، ولم تتم الإجابة عنه بعد.\n\nتتلقى جهة الاتصال معلومات حضورك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have sent a request to see presence information of this contact. It is not yet answered.\n \nThe contact receives your presence information.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has enviado una solicitud para ver la información de presencia de este contacto. Todavía no ha recibido respuesta.\n\nEl contacto recibe tu información de presencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé une demande pour voir les informations de présence de ce contact. Elle n’a pas encore reçu de réponse.\n\nLe contact reçoit vos informations de présence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправили запрос на получение информации о присутствии этого контакта. Ответ пока не получен.\n\nКонтакт получает информацию о вашем присутствии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
