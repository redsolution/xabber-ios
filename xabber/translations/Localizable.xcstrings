            "state": "translated",
            "value": "El valor de la prioridad debe ser un número entre -128 y 127 (por defecto: 0)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorité doit être un nombre compris entre -128 et 127 (défaut : 10)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритет должен быть между -128 и 127 (значение по умолчанию: 0)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
