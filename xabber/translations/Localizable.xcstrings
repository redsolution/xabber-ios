    "notifications__category__information_description": {
      "comment": "Notifications list: attributed visible copy.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديثات ونصائح ورسائل نظام من مشغلي الخوادم وجهات اتصال مختلفة لإبقائك على اطلاع بالميزات والصيانة وأخبار التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates, tips, and system messages from server operators and various contacts to keep you informed about features, maintenance, and app-related news."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones, consejos y mensajes del sistema de operadores del servidor y distintos contactos sobre funciones, mantenimiento y novedades de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour, conseils et messages système des opérateurs de serveur et de différents contacts concernant les fonctionnalités, la maintenance et l’actualité de l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления, советы и системные сообщения от операторов серверов и контактов о функциях, обслуживании и новостях приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自服务器运营方和各个联系人的更新、提示及系统消息，让你及时了解功能、维护和应用相关新闻。"
          }
        }
      }
    },
