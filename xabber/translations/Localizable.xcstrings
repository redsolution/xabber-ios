    "cloud_storage__cleanup__cleanup_failed_message": {
      "comment": "Cloud Storage / cleanup: user-visible alert or toast message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تغيير Cloud Storage. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Storage was not changed. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Storage no se modificó. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Storage n’a pas été modifié. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Storage не изменено. Проверьте соединение и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud Storage 未更改。请检查连接后重试。"
          }
        }
      }
    },
    "cloud_storage__cleanup__cleanup_preview_advisory": {
      "comment": "Cloud Storage / cleanup: user-visible label text. Argument 1 is the target free-space percentage; migrate to a numeric placeholder and escape the literal percent sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع القائمة الإرشادية للملفات المحددة لتحرير %@%% من المساحة. سيتحقق الخادم من التنظيف مجددًا عند التأكيد. الصور الرمزية مستثناة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review the advisory list of files selected to reach %@%% free space. The server validates the cleanup again on confirmation. Avatars are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la lista orientativa de archivos seleccionados para liberar el %@%% del espacio. El servidor volverá a validar la limpieza al confirmar. Los avatares están excluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez la liste indicative des fichiers sélectionnés pour libérer %@%% d’espace. Le serveur vérifiera de nouveau le nettoyage lors de la confirmation. Les avatars sont exclus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите предварительный список файлов, выбранных для освобождения %@%% места. При подтверждении сервер повторно проверит очистку. Аватары не удаляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查为释放 %@%% 空间而选择的文件建议列表。确认时服务器会再次验证清理内容。头像不会被删除。"
          }
        }
      }
    },
    "cloud_storage__cleanup__cleanup_preview_advisory_compact": {
      "comment": "Cloud Storage / cleanup: user-visible label text. Argument 1 is the target free-space percentage; migrate to a numeric placeholder and escape the literal percent sign.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الملفات المحددة لتحرير %@%% من المساحة. المعاينة إرشادية؛ سيتحقق الخادم من التنظيف مجددًا عند التأكيد. الصور الرمزية مستثناة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the files selected to reach %@%% free space. The preview is advisory; the server validates the cleanup again when you confirm. Avatars are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los archivos seleccionados para liberar el %@%% del espacio. La vista previa es orientativa; el servidor volverá a validar la limpieza al confirmar. Los avatares están excluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les fichiers sélectionnés pour libérer %@%% d’espace. L’aperçu est indicatif ; le serveur vérifiera de nouveau le nettoyage lors de la confirmation. Les avatars sont exclus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите файлы, выбранные для освобождения %@%% места. Список предварительный; при подтверждении сервер повторно проверит очистку. Аватары не удаляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查为释放 %@%% 空间而选择的文件。预览仅供参考；确认时服务器会再次验证清理内容。头像不会被删除。"
          }
        }
      }
    },
