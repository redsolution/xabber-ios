    "connection_start_at_boot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل عند بدء النظام\nتشغيل التطبيق عند بدء نظام التشغيل Android. هذا الإعداد لن يعمل إذا تم تثبيت Xabber على بطاقة الذاكرة SD."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start when Android boots\nStart the application when Android boots. This doesn't work when Xabber is installed on SD card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar al encender Android\nInicia la aplicación cuando se enciende Android. Esta opción no funciona si Xabber está instalada en la tarjeta SD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer avec Android\nL'application sera lancée au démarrage d'Android. Ne fonctionne pas quand Xabber est installé sur une carte SD."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать при включении телефона\nЗапускать приложение при включении телефона. Функция не будет работать, если Xabber установлен на SD-карту"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随Android启动\n当Android启动时启动该程序。如果Xabber被安装在SD卡上，此功能将会失效。"
          }
        }
      }
    },
    "connection_state_sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация"
          }
        }
      }
