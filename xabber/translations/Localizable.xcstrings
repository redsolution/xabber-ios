    "chat_search_result_ambiguous_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطابق عدة رسائل مع هذه النتيجة، لذا لم تُفتح أي منها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several messages match this result, so none was opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios mensajes coinciden con este resultado, por lo que no se abrió ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs messages correspondent à ce résultat. Aucun n’a donc été ouvert."
          }
