    "notifications_settings__system__footer": {
      "comment": "Notification settings section title or explanatory footer shown in Settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إدارة معاينات شاشة القفل والأذونات والشارات وتسليم الإشعارات في إعدادات iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Screen previews, permissions, badges and notification delivery are controlled in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas en la pantalla bloqueada, los permisos, los distintivos y la entrega de notificaciones se controlan en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus sur l’écran verrouillé, les autorisations, les pastilles et la distribution des notifications sont gérés dans les réglages iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр на экране блокировки, разрешения, значки и доставка уведомлений настраиваются в настройках iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕预览、权限、角标和通知送达方式由 iOS“设置”控制。"
          }
        }
      }
    },
