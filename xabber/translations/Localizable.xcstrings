    "device_verification__session__close_verification": {
      "comment": "Device Verification / session: VoiceOver label. Security-sensitive copy: preserve identity and trust semantics.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق التحقق"
          }
