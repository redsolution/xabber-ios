    "sync_not_allowed_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن مزامنة حسابات مع إعدادات غير صحيحه (مضيف مخصصة، إرث SSL، الوكيل)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts with non-standard settings (custom host, legacy SSL, proxy) can not be synchronized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden sincronizar cuentas con configuraciones no estándar (proxy, host personalizado, legado SSL,)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes avec des paramètres non standards (hôte personnalisé, legacy SSL, proxy) ne peuvent pas être synchronisés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунты с нестандартными настройками (нестандартный порт, старый SSL, прокси) не могут быть синхронизированы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "具有非标准设置 (自定义主机、旧式 SSL、代理) 的帐户无法同步。"
          }
        }
      }
    },
    "sync_security_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم مزامنة كلمات المرور الخاصة بك.(إلا إذا كنت تستخدم الرموز المميزة)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your passwords are never synchronized and are safe from theft. But you have to enter them on every device (unless you use tokens, which you should)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas nunca se sincronizan y estén a salvo de robo. Pero tiene que introducirla en todos los dispositivos (a menos que use un autentificador, recomendado)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли не синхронизируются и не могут быть скомпрометированы, но Вам придется самостоятельно вводить пароли на всех устройствах (кроме тех случаев, когда подключение происходит с помощью токенов)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密码永远不会同步, 并且不会被窃取。但你必须在每台设备上输入它们 (除非你使用令牌, 你应该这样做)"
          }
        }
      }
    },
