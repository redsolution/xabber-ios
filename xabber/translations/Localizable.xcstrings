    "appearance__interface_preview__message_lunch": {
      "comment": "Synthetic interface appearance preview copy; localize because it is visible UI and must demonstrate the selected language and RTL direction.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنلتقِ لتناول الغداء الساعة الثانية. أعرف مكانًا سيعجبك. ☕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s meet for lunch at two. I know a place you’ll love. ☕"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedemos para comer a las dos. Conozco un sitio que te encantará. ☕"
