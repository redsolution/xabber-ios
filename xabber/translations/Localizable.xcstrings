    "intro_private_chat_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private chat with incognito user. Messages are routed through group server and your identities are kept secret from each other. Be vigilant, do not disclose yourself by being careless."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat privé avec un utilisateur incognito. Les messages sont acheminés via le serveur de groupe et vos identités sont gardées secrètes. Soyez vigilant, ne vous divulguez pas en étant insensé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный чат с собеседником из инкогнито группы. Сообщения маршрутизируются через сервер группового чата, а ваши реальные идентификаторы скрыты друг от друга. Будьте бдительны. Не компрометируйте себя непродуманными действиями."
          }
        }
      }
    },
