      }
    },
    "report_error_network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال البلاغ. يرجى التحقق من اتصالك والمحاولة مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report could not be submitted. Please check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el informe. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signalement n’a pas pu être envoyé. Vérifiez votre connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить жалобу. Проверьте подключение и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法提交举报。请检查网络连接后重试。"
          }
        }
      }
    },
    "report_error_server": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال البلاغ بسبب خطأ في الخادم. يرجى المحاولة لاحقًا أو التواصل مع الدعم عبر %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report could not be submitted due to a server error. Please try again later or contact support at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el informe debido a un error del servidor. Inténtalo de nuevo más tarde o ponte en contacto con soporte en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signalement n’a pas pu être envoyé en raison d’une erreur du serveur. Réessayez plus tard ou contactez l’assistance à l’adresse %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить жалобу из-за ошибки сервера. Повторите попытку позже или обратитесь в службу поддержки по адресу %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于服务器错误，无法提交举报。请稍后重试，或通过 %@ 联系支持人员。"
          }
        }
      }
    },
    "report_error_validation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تحديد سبب قبل إرسال البلاغ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select a reason before submitting your report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un motivo antes de enviar el informe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un motif avant d’envoyer votre signalement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой жалобы выберите причину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交举报前请选择原因。"
          }
        }
      }
    },
    "report_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعدنا البلاغات على مراجعة المحتوى المرفوض والسلوك المسيء. تتم مراجعة البلاغات المتعلقة بالخدمات التي يشغّلها المطور خلال 24 ساعة. أما خوادم XMPP التابعة لجهات خارجية، فقد تعتمد إجراءات الإشراف فيها على مشغّل الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports help us review objectionable content and abusive behavior. For developer-operated services, reports are reviewed within 24 hours. For third-party XMPP servers, moderation actions may depend on the server operator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes nos ayudan a revisar contenido censurable y conductas abusivas. En los servicios operados por el desarrollador, los informes se revisan en un plazo de 24 horas. En servidores XMPP de terceros, las medidas de moderación pueden depender del operador del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements nous aident à examiner les contenus répréhensibles et les comportements abusifs. Pour les services exploités par le développeur, les signalements sont examinés sous 24 heures. Pour les serveurs XMPP tiers, les mesures de modération peuvent dépendre de l’opérateur du serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобы помогают нам проверять неприемлемый контент и недопустимое поведение. Жалобы на службы под управлением разработчика рассматриваются в течение 24 часов. Для сторонних серверов XMPP действия модерации могут зависеть от оператора сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报有助于我们审核不当内容和滥用行为。对于开发者运营的服务，举报会在 24 小时内得到审核。对于第三方 XMPP 服务器，审核措施可能取决于服务器运营方。"
          }
        }
      }
    },
