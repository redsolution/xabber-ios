    "blocked_group_invitations_summary_full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking is used to mark group invitations as 'read'. If you remove these entries from the block list, you might see invitation dialog again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo se utiliza para marcar las invitaciones de grupo como 'leídas'. Si elimina estas entradas de la lista de bloqueos, puede que vuelva a ver el diálogo de invitaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage est utilisé pour marquer les invitations de groupe comme « ratées». Si vous supprimez ces entrées de la liste de blocs, vous pouvez voir la boîte de dialogue d'invitation à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка используется для пометки приглашений в группы как 'прочитанное'. Если вы удалите эти записи из списка блокировок, приглашение может отобразиться заново."
          }
