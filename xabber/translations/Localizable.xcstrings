    "username_rules": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم قد يحتوي على أحرف صغيرة اللاتينية الحروف والأرقام والنقاط فقط"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username may contain only lowercase latin letters, numbers and dots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario debe contener solamente minúsculas, letras latinas, números y puntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’utilisateur ne peut contenir que des lettres latines minuscules, des nombres et des points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя может содержать только строчные латинские буквы, цифры и точки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名只能包含小写拉丁文字母、数字和点"
          }
        }
      }
    },
    "username_rules_dots": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم يجب أن لا يحتوي على نقطتين في صف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username must not contain two dots in a row"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario no puede contener dos puntos seguidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’utilisateur ne doit pas contenir deux points d’affilé"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя не может содержать две точки подряд"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名不能在一行中包含两个点"
          }
        }
      }
    },
    "username_rules_first_symbol": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم يجب أن يبدأ بحرف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username must start with letter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario debe comenzar con una letra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d'utilisateur doit commencer par une lettre"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя должно начинаться с буквы"
          }
        },
