{
  "sourceLanguage": "en",
  "strings": {
    "NFCReaderUsageDescription": {
      "comment": "System NFC permission dialog shown when communicating with a YubiKey.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ تقنية NFC للاتصال بمفتاح YubiKey الخاص بك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses NFC to communicate with your YubiKey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa NFC para comunicarse con tu YubiKey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise le NFC pour communiquer avec votre YubiKey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует NFC для взаимодействия с вашим YubiKey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 使用 NFC 与您的 YubiKey 通信。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "System camera permission dialog shown before taking a photo to send in chat.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ الكاميرا لمسح رموز QR والتقاط الصور وإجراء مكالمات الفيديو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses the camera to scan QR codes, take photos, and make video calls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa la cámara para escanear códigos QR, tomar fotos y realizar videollamadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise l’appareil photo pour scanner des codes QR, prendre des photos et passer des appels vidéo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует камеру для сканирования QR-кодов, съёмки фотографий и видеовызовов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 使用相机扫描二维码、拍摄照片和进行视频通话。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "System Face ID permission dialog shown when biometric protection is enabled.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ بصمة الوجه لحماية بياناتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses Face ID to protect your data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa Face ID para proteger tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise Face ID pour protéger vos données."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует Face ID для защиты ваших данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 使用面容 ID 保护您的数据。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "System local-network permission dialog used for peer-to-peer voice calls.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ الشبكة المحلية لإجراء مكالمات صوتية ومكالمات فيديو مباشرة بين الأجهزة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses the local network to establish peer-to-peer voice and video calls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa la red local para establecer llamadas de voz y videollamadas entre pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise le réseau local pour établir des appels vocaux et vidéo pair à pair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует локальную сеть для одноранговых голосовых и видеовызовов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 使用本地网络建立点对点语音和视频通话。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "System location permission dialog shown when the user sends their current location in chat.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ موقعك عندما تختار إرسال موقعك الحالي في محادثة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses your location when you choose to send your current location in a chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa tu ubicación cuando decides enviar tu ubicación actual en un chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise votre position lorsque vous choisissez d’envoyer votre position actuelle dans une discussion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует вашу геопозицию, когда вы решаете отправить текущее местоположение в чат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您选择在聊天中发送当前位置时，__APP_NAME__ 会使用您的位置信息。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "System microphone permission dialog used for voice messages and voice calls.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم __APP_NAME__ الميكروفون لإرسال الرسائل الصوتية وإجراء المكالمات الصوتية ومكالمات الفيديو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ uses the microphone to send voice messages and make voice and video calls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ usa el micrófono para enviar mensajes de voz y realizar llamadas de voz y videollamadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ utilise le microphone pour envoyer des messages vocaux et passer des appels vocaux et vidéo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ использует микрофон для отправки голосовых сообщений, голосовых и видеовызовов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 使用麦克风发送语音消息和进行语音及视频通话。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "System photo-library add permission dialog shown when saving a downloaded photo.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ __APP_NAME__ الصور التي تلتقطها في التطبيق في مكتبة الصور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ saves photos you take in the app to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ guarda en tu fototeca las fotos que tomas en la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ enregistre dans votre photothèque les photos prises dans l’application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ сохраняет сделанные в приложении фотографии в медиатеку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ 会将您在应用中拍摄的照片保存到照片图库。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "System photo-library permission dialog shown when attaching an existing photo to a message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل __APP_NAME__ إلى مكتبة الصور عندما تختار صورًا أو مقاطع فيديو للرسائل وصور الملف الشخصي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ accesses your photo library when you choose photos or videos for messages and profile pictures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ accede a tu fototeca cuando eliges fotos o vídeos para mensajes e imágenes de perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ accède à votre photothèque lorsque vous choisissez des photos ou des vidéos pour les messages et les photos de profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "__APP_NAME__ получает доступ к медиатеке, когда вы выбираете фото или видео для сообщений и изображений профиля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您为消息和个人资料图片选择照片或视频时，__APP_NAME__ 会访问您的照片图库。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
