+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:altered preKey:oneTimeKey.publicKey preKeyID:1 error:&error]);
+    XCTAssertNotNil(error);
+}
