+- (void)testRemotePreKeyIDSurvivesAcknowledgementAndRestoredSessionsWithoutMutation {
+    NSError *error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    OMEMO2IdentityKeyPair *alice = [context generateIdentityWithError:&error];
+    OMEMO2IdentityKeyPair *bob = [context generateIdentityWithError:&error];
+    OMEMO2KeyPair *signedKey = [context generateKeyPairWithError:&error];
+    OMEMO2KeyPair *oneTimeKey = [context generateKeyPairWithError:&error];
+    NSData *signature = [context signData:signedKey.publicKey identity:bob error:&error];
+    OMEMO2Bundle *bundle = [[OMEMO2Bundle alloc] initWithIdentityKey:bob.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:7 signature:signature preKey:oneTimeKey.publicKey preKeyID:11 error:&error];
+    OMEMO2Session *sender = [context initiateSessionWithIdentity:alice bundle:bundle error:&error];
+    XCTAssertNotNil(sender);
+    NSData *pendingSnapshot = [sender serializedDataWithError:&error];
+    XCTAssertEqual(sender.remotePreKeyID, 11u);
+    XCTAssertTrue(sender.isKeyExchangePending);
+    XCTAssertEqualObjects([sender serializedDataWithError:&error], pendingSnapshot);
+    OMEMO2Session *restored = [context restoreSessionWithData:pendingSnapshot error:&error];
+    XCTAssertEqual(restored.remotePreKeyID, 11u);
+    XCTAssertTrue(restored.isKeyExchangePending);
+    OMEMO2Ciphertext *first = [sender encryptData:[self material:48 byte:0x47] error:&error];
+    NSData *plaintext = nil;
+    OMEMO2Session *receiver = [context acceptKeyExchange:first identity:bob signedPreKey:signedKey signedPreKeyID:7 preKey:oneTimeKey preKeyID:11 plaintext:&plaintext error:&error];
+    XCTAssertNotNil(receiver);
+    NSData *receiverSnapshot = [receiver serializedDataWithError:&error];
+    XCTAssertEqual(receiver.remotePreKeyID, 0u);
+    XCTAssertEqualObjects([receiver serializedDataWithError:&error], receiverSnapshot);
+    restored = [context restoreSessionWithData:receiverSnapshot error:&error];
+    XCTAssertEqual(restored.remotePreKeyID, 0u);
+    OMEMO2Ciphertext *reply = [receiver encryptData:[self material:32 byte:0] error:&error];
+    XCTAssertEqualObjects([sender decryptCiphertext:reply error:&error], [self material:32 byte:0]);
+    XCTAssertFalse(sender.isKeyExchangePending);
+    NSData *acknowledgedSnapshot = [sender serializedDataWithError:&error];
+    XCTAssertEqual(sender.remotePreKeyID, 11u);
+    XCTAssertEqualObjects([sender serializedDataWithError:&error], acknowledgedSnapshot);
+    restored = [context restoreSessionWithData:acknowledgedSnapshot error:&error];
+    XCTAssertEqual(restored.remotePreKeyID, 11u);
+    XCTAssertFalse(restored.isKeyExchangePending);
+    XCTAssertNil(error);
+}
