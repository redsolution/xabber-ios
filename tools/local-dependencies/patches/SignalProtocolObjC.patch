+#import "OMEMO2.h"
+#import "SignalCommonCryptoProvider.h"
+#import "SignalError.h"
+@import SignalProtocolC;
+
+static BOOL OMEMO2Result(int result, NSError **error) {
+    if (result >= 0) { return YES; }
+    if (error) { *error = ErrorFromSignalErrorCode(result); }
+    return NO;
+}
+
+static const uint8_t *OMEMO2Bytes(NSData *data) {
+    static const uint8_t empty = 0;
+    return data.length ? data.bytes : &empty;
+}
+
+static NSData *OMEMO2Data(signal_buffer *buffer) {
+    return [NSData dataWithBytes:signal_buffer_data(buffer) length:signal_buffer_len(buffer)];
+}
+
+static BOOL OMEMO2KeyID(uint32_t keyID) {
+    return keyID > 0 && keyID <= INT32_MAX;
+}
+
+static void OMEMO2Wipe(void *data, size_t length) {
+    volatile uint8_t *bytes = data;
+    while (length--) { *bytes++ = 0; }
+}
+
+static int OMEMO2ValidatePublicKey(NSData *data, signal_context *context) {
+    ec_public_key *publicKey = NULL;
+    ec_private_key *privateKey = NULL;
+    uint8_t scalar[32] = {0}, agreement[32] = {0};
+    scalar[31] = 64;
+    int result = omemo_public_key_decode(&publicKey, data.bytes, context);
+    if (result >= 0) { result = curve_decode_private_point(&privateKey, scalar, sizeof(scalar), context); }
+    if (result >= 0) { result = omemo_calculate_agreement(agreement, publicKey, privateKey); }
+    SIGNAL_UNREF(publicKey); SIGNAL_UNREF(privateKey);
+    OMEMO2Wipe(scalar, sizeof(scalar));
+    OMEMO2Wipe(agreement, sizeof(agreement));
+    return result;
+}
+
+@interface OMEMO2KeyPair ()
+@property (nonatomic, assign) ec_key_pair *nativeKeyPair;
+- (nullable instancetype)initWithNativeKeyPair:(ec_key_pair *)pair error:(NSError **)error;
+@end
+
+@interface OMEMO2IdentityKeyPair ()
+@property (nonatomic, assign) ec_key_pair *nativeKeyPair;
+- (nullable instancetype)initWithNativeKeyPair:(ec_key_pair *)pair error:(NSError **)error;
+@end
+
+@interface OMEMO2Context ()
+@property (nonatomic, assign) signal_context *nativeContext;
+@property (nonatomic, strong) SignalCommonCryptoProvider *provider;
+@property (nonatomic, strong) NSRecursiveLock *lock;
+@end
+
+@interface OMEMO2Session ()
+@property (nonatomic, assign) omemo_session *nativeSession;
+@property (nonatomic, strong) OMEMO2Context *context;
+- (instancetype)initWithNativeSession:(omemo_session *)session context:(OMEMO2Context *)context;
+@end
+
+@implementation OMEMO2KeyPair
+- (nullable instancetype)initWithNativeKeyPair:(ec_key_pair *)pair error:(NSError **)error {
+    uint8_t publicKey[32];
+    signal_buffer *privateKey = NULL;
+    int result = omemo_public_key_encode(publicKey, ec_key_pair_get_public(pair));
+    if (result >= 0) { result = ec_private_key_serialize(&privateKey, ec_key_pair_get_private(pair)); }
+    if (!OMEMO2Result(result, error)) { signal_buffer_bzero_free(privateKey); return nil; }
+    if ((self = [super init])) {
+        SIGNAL_REF(pair);
+        _nativeKeyPair = pair;
+        _publicKey = [NSData dataWithBytes:publicKey length:sizeof(publicKey)];
+        _privateKey = OMEMO2Data(privateKey);
+    }
+    signal_buffer_bzero_free(privateKey);
+    return self;
+}
+- (void)dealloc { SIGNAL_UNREF(_nativeKeyPair); }
+@end
+
+@implementation OMEMO2IdentityKeyPair
+- (nullable instancetype)initWithNativeKeyPair:(ec_key_pair *)pair error:(NSError **)error {
+    uint8_t identity[32], fingerprint[32];
+    signal_buffer *privateKey = NULL;
+    int result = omemo_identity_key_encode(identity, ec_key_pair_get_public(pair));
+    if (result >= 0) { result = omemo_public_key_encode(fingerprint, ec_key_pair_get_public(pair)); }
+    if (result >= 0) { result = ec_private_key_serialize(&privateKey, ec_key_pair_get_private(pair)); }
+    if (!OMEMO2Result(result, error)) { signal_buffer_bzero_free(privateKey); return nil; }
+    if ((self = [super init])) {
+        SIGNAL_REF(pair);
+        _nativeKeyPair = pair;
+        _publicKey = [NSData dataWithBytes:identity length:sizeof(identity)];
+        _fingerprintPublicKey = [NSData dataWithBytes:fingerprint length:sizeof(fingerprint)];
+        _privateKey = OMEMO2Data(privateKey);
+    }
+    signal_buffer_bzero_free(privateKey);
+    return self;
+}
+- (void)dealloc { SIGNAL_UNREF(_nativeKeyPair); }
+@end
+
+@implementation OMEMO2Bundle
+- (nullable instancetype)initWithIdentityKey:(NSData *)identityKey signedPreKey:(NSData *)signedPreKey signedPreKeyID:(uint32_t)signedPreKeyID signature:(NSData *)signature preKey:(NSData *)preKey preKeyID:(uint32_t)preKeyID error:(NSError **)error {
+    if (!identityKey || !signedPreKey || !signature || !preKey || identityKey.length != 32 || signedPreKey.length != 32 || preKey.length != 32 || signature.length != 64 || !OMEMO2KeyID(signedPreKeyID) || !OMEMO2KeyID(preKeyID)) {
+        OMEMO2Result(SG_ERR_INVAL, error); return nil;
+    }
+    signal_context *validationContext = NULL;
+    ec_public_key *key = NULL;
+    int result = signal_context_create(&validationContext, NULL);
+    if (result >= 0) { result = omemo_identity_key_decode(&key, identityKey.bytes, validationContext); }
+    SIGNAL_UNREF(key); key = NULL;
+    if (result >= 0) { result = OMEMO2ValidatePublicKey(signedPreKey, validationContext); }
+    if (result >= 0) { result = OMEMO2ValidatePublicKey(preKey, validationContext); }
+    if (result >= 0) { result = omemo_identity_verify(identityKey.bytes, signedPreKey.bytes, signedPreKey.length, signature.bytes); }
+    if (validationContext) { signal_context_destroy(validationContext); }
+    if (!OMEMO2Result(result, error)) { return nil; }
+    if ((self = [super init])) {
+        _identityKey = [identityKey copy]; _signedPreKey = [signedPreKey copy];
+        _signature = [signature copy]; _preKey = [preKey copy];
+        _signedPreKeyID = signedPreKeyID; _preKeyID = preKeyID;
+    }
+    return self;
+}
+@end
+
+@implementation OMEMO2Ciphertext
+- (nullable instancetype)initWithData:(NSData *)data keyExchange:(BOOL)keyExchange error:(NSError **)error {
+    if (!data || data.length == 0) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    omemo_message message = {0};
+    omemo_authenticated_message authenticated = {0};
+    omemo_key_exchange exchange = {0};
+    int result;
+    if (keyExchange) {
+        result = omemo_key_exchange_decode(&exchange, data.bytes, data.length);
+        if (result >= 0) { result = omemo_message_decode(&message, signal_buffer_data(exchange.message.message), signal_buffer_len(exchange.message.message)); }
+    } else {
+        result = omemo_authenticated_message_decode(&authenticated, data.bytes, data.length);
+        if (result >= 0) { result = omemo_message_decode(&message, signal_buffer_data(authenticated.message), signal_buffer_len(authenticated.message)); }
+    }
+    if (OMEMO2Result(result, error) && (self = [super init])) {
+        _data = [data copy]; _keyExchange = keyExchange;
+        _counter = message.n; _previousCounter = message.pn;
+        _ratchetKey = [NSData dataWithBytes:message.dh_pub length:sizeof(message.dh_pub)];
+        if (keyExchange) {
+            _ephemeralKey = [NSData dataWithBytes:exchange.ek length:sizeof(exchange.ek)];
+            _identityKey = [NSData dataWithBytes:exchange.ik length:sizeof(exchange.ik)];
+            _signedPreKeyID = exchange.spk_id; _preKeyID = exchange.pk_id;
+        }
+    } else { self = nil; }
+    omemo_message_clear(&message);
+    omemo_authenticated_message_clear(&authenticated);
+    omemo_key_exchange_clear(&exchange);
+    return self;
+}
+@end
+
+@implementation OMEMO2Context
+- (nullable instancetype)initWithError:(NSError **)error {
+    if (!(self = [super init])) { return nil; }
+    _lock = [[NSRecursiveLock alloc] init];
+    _provider = [[SignalCommonCryptoProvider alloc] init];
+    int result = signal_context_create(&_nativeContext, NULL);
+    if (result >= 0) {
+        signal_crypto_provider provider = [_provider cryptoProvider];
+        result = signal_context_set_crypto_provider(_nativeContext, &provider);
+    }
+    if (!OMEMO2Result(result, error)) { return nil; }
+    return self;
+}
+- (void)dealloc { if (_nativeContext) { signal_context_destroy(_nativeContext); } }
+
+- (nullable OMEMO2IdentityKeyPair *)generateIdentityWithError:(NSError **)error {
+    [_lock lock];
+    ec_key_pair *pair = NULL;
+    int result = curve_generate_key_pair(_nativeContext, &pair);
+    OMEMO2IdentityKeyPair *identity = OMEMO2Result(result, error) ? [[OMEMO2IdentityKeyPair alloc] initWithNativeKeyPair:pair error:error] : nil;
+    SIGNAL_UNREF(pair);
+    [_lock unlock];
+    return identity;
+}
+- (nullable OMEMO2KeyPair *)generateKeyPairWithError:(NSError **)error {
+    [_lock lock];
+    ec_key_pair *pair = NULL;
+    int result = curve_generate_key_pair(_nativeContext, &pair);
+    OMEMO2KeyPair *keyPair = OMEMO2Result(result, error) ? [[OMEMO2KeyPair alloc] initWithNativeKeyPair:pair error:error] : nil;
+    SIGNAL_UNREF(pair);
+    [_lock unlock];
+    return keyPair;
+}
+
+- (nullable ec_key_pair *)nativeKeyPairWithPrivateKey:(NSData *)data error:(NSError **)error {
+    if (!data || data.length != 32) { OMEMO2Result(SG_ERR_INVAL, error); return NULL; }
+    ec_key_pair *pair = NULL;
+    int result = omemo_key_pair_from_private(&pair, data.bytes, _nativeContext);
+    if (!OMEMO2Result(result, error)) { SIGNAL_UNREF(pair); return NULL; }
+    return pair;
+}
+- (nullable OMEMO2IdentityKeyPair *)identityWithPrivateKey:(NSData *)privateKey error:(NSError **)error {
+    [_lock lock];
+    ec_key_pair *pair = [self nativeKeyPairWithPrivateKey:privateKey error:error];
+    OMEMO2IdentityKeyPair *identity = pair ? [[OMEMO2IdentityKeyPair alloc] initWithNativeKeyPair:pair error:error] : nil;
+    SIGNAL_UNREF(pair); [_lock unlock]; return identity;
+}
+- (nullable OMEMO2KeyPair *)keyPairWithPrivateKey:(NSData *)privateKey error:(NSError **)error {
+    [_lock lock];
+    ec_key_pair *pair = [self nativeKeyPairWithPrivateKey:privateKey error:error];
+    OMEMO2KeyPair *keyPair = pair ? [[OMEMO2KeyPair alloc] initWithNativeKeyPair:pair error:error] : nil;
+    SIGNAL_UNREF(pair); [_lock unlock]; return keyPair;
+}
+- (nullable NSData *)signData:(NSData *)data identity:(OMEMO2IdentityKeyPair *)identity error:(NSError **)error {
+    if (!data || !identity) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    [_lock lock];
+    uint8_t signature[64];
+    int result = omemo_identity_sign(signature, ec_key_pair_get_private(identity.nativeKeyPair), OMEMO2Bytes(data), data.length, _nativeContext);
+    NSData *output = OMEMO2Result(result, error) ? [NSData dataWithBytes:signature length:sizeof(signature)] : nil;
+    [_lock unlock]; return output;
+}
++ (BOOL)verifySignature:(NSData *)signature data:(NSData *)data identityKey:(NSData *)identityKey error:(NSError **)error {
+    if (!signature || !data || !identityKey || signature.length != 64 || identityKey.length != 32) { return OMEMO2Result(SG_ERR_INVAL, error); }
+    return OMEMO2Result(omemo_identity_verify(identityKey.bytes, OMEMO2Bytes(data), data.length, signature.bytes), error);
+}
+- (nullable OMEMO2Session *)initiateSessionWithIdentity:(OMEMO2IdentityKeyPair *)identity bundle:(OMEMO2Bundle *)bundle error:(NSError **)error {
+    if (!identity || !bundle) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    omemo_session_bundle nativeBundle = {0};
+    memcpy(nativeBundle.identity_key, bundle.identityKey.bytes, 32);
+    memcpy(nativeBundle.signed_pre_key, bundle.signedPreKey.bytes, 32);
+    memcpy(nativeBundle.signed_pre_key_signature, bundle.signature.bytes, 64);
+    memcpy(nativeBundle.one_time_pre_key, bundle.preKey.bytes, 32);
+    nativeBundle.signed_pre_key_id = bundle.signedPreKeyID; nativeBundle.one_time_pre_key_id = bundle.preKeyID;
