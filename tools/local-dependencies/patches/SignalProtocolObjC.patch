+- (void)testPendingKeyExchangeCounterPersistenceAuthenticationRollbackAndAcknowledgment {
+    NSError *error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    OMEMO2IdentityKeyPair *alice = [context generateIdentityWithError:&error];
+    OMEMO2IdentityKeyPair *bob = [context generateIdentityWithError:&error];
+    OMEMO2KeyPair *signedKey = [context generateKeyPairWithError:&error];
+    OMEMO2KeyPair *oneTimeKey = [context generateKeyPairWithError:&error];
+    NSData *signature = [context signData:signedKey.publicKey identity:bob error:&error];
+    OMEMO2Bundle *bundle = [[OMEMO2Bundle alloc] initWithIdentityKey:bob.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:7 signature:signature preKey:oneTimeKey.publicKey preKeyID:11 error:&error];
+    OMEMO2Session *sender = [context initiateSessionWithIdentity:alice bundle:bundle error:&error];
+    NSData *content = [self material:48 byte:0x47];
+    OMEMO2Ciphertext *first = [sender encryptData:content error:&error];
+    OMEMO2Ciphertext *second = [sender encryptData:content error:&error];
+    XCTAssertTrue(first.isKeyExchange);
+    XCTAssertTrue(second.isKeyExchange);
+    XCTAssertEqual(first.counter, 0u);
+    XCTAssertEqual(second.counter, 1u);
+    XCTAssertEqualObjects(first.ephemeralKey, second.ephemeralKey);
+    XCTAssertEqualObjects(first.ratchetKey, second.ratchetKey);
+    NSData *snapshot = [sender serializedDataWithError:&error];
+    sender = [context restoreSessionWithData:snapshot error:&error];
+    OMEMO2Ciphertext *third = [sender encryptData:content error:&error];
+    XCTAssertEqual(third.counter, 2u);
+    XCTAssertEqualObjects(third.ephemeralKey, first.ephemeralKey);
+    NSData *decrypted = nil;
+    OMEMO2Session *receiver = [context acceptKeyExchange:first identity:bob signedPreKey:signedKey signedPreKeyID:7 preKey:oneTimeKey preKeyID:11 plaintext:&decrypted error:&error];
+    XCTAssertNotNil(receiver);
+    XCTAssertEqualObjects(content, decrypted);
+    XCTAssertEqualObjects(content, [receiver decryptCiphertext:third error:&error]);
+    XCTAssertEqualObjects(content, [receiver decryptCiphertext:second error:&error]);
+    NSData *receiverSnapshot = [receiver serializedDataWithError:&error];
+    error = nil;
+    XCTAssertNil([receiver decryptCiphertext:second error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertEqualObjects(receiverSnapshot, [receiver serializedDataWithError:&error]);
+    OMEMO2Ciphertext *next = [sender encryptData:content error:&error];
+    NSMutableData *tampered = [next.data mutableCopy];
+    ((uint8_t *)tampered.mutableBytes)[tampered.length - 1] ^= 1;
+    OMEMO2Ciphertext *damaged = [[OMEMO2Ciphertext alloc] initWithData:tampered keyExchange:YES error:&error];
+    XCTAssertNotNil(damaged);
+    error = nil;
+    XCTAssertNil([receiver decryptCiphertext:damaged error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertEqualObjects(receiverSnapshot, [receiver serializedDataWithError:&error]);
+    XCTAssertEqualObjects(content, [receiver decryptCiphertext:next error:&error]);
+    OMEMO2Ciphertext *reply = [receiver encryptData:[self material:32 byte:0] error:&error];
+    XCTAssertFalse(reply.isKeyExchange);
+    XCTAssertEqualObjects([self material:32 byte:0], [sender decryptCiphertext:reply error:&error]);
+    XCTAssertFalse(sender.isKeyExchangePending);
+    OMEMO2Ciphertext *regular = [sender encryptData:content error:&error];
+    XCTAssertFalse(regular.isKeyExchange);
+    XCTAssertEqualObjects(content, [receiver decryptCiphertext:regular error:&error]);
+    XCTAssertNil(error);
+}
