+@property (nonatomic, readonly, getter=isKeyExchangePending) BOOL keyExchangePending;
+@property (nonatomic, readonly) uint32_t sendCounter;
+/// Initiator's remote one-time pre-key ID, preserved after acknowledgement; zero for responders.
+@property (nonatomic, readonly) uint32_t remotePreKeyID;
+@property (nonatomic, readonly) uint32_t receiveCounter;
+@property (nonatomic, readonly) uint32_t previousCounter;
+@property (nonatomic, readonly) NSUInteger skippedKeyCount;
