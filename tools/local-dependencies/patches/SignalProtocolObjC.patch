+ * session and update OPK consumption atomically; do not remove OPK earlier. */
+- (nullable OMEMO2Session *)acceptKeyExchange:(OMEMO2Ciphertext *)keyExchange
+                                  identity:(OMEMO2IdentityKeyPair *)identity
+                              signedPreKey:(OMEMO2KeyPair *)signedPreKey
+                            signedPreKeyID:(uint32_t)signedPreKeyID
+                                    preKey:(OMEMO2KeyPair *)preKey
+                                  preKeyID:(uint32_t)preKeyID
+                                 plaintext:(NSData * _Nullable * _Nullable)plaintext
+                                     error:(NSError * _Nullable * _Nullable)error;
