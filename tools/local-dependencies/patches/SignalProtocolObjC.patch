diff --git a/Testing/SignalProtocolTests/OMEMO2Tests.m b/Testing/SignalProtocolTests/OMEMO2Tests.m
new file mode 100644
index 0000000..967c29c
--- /dev/null
+++ b/Testing/SignalProtocolTests/OMEMO2Tests.m
@@ -0,0 +1,279 @@
+#import <XCTest/XCTest.h>
+@import SignalProtocolObjC;
+
+@interface OMEMO2Tests : XCTestCase
+@end
+
+@implementation OMEMO2Tests
+
+- (NSData *)hex:(NSString *)hex {
+    NSMutableData *data = [NSMutableData dataWithLength:hex.length / 2];
+    for (NSUInteger i = 0; i < data.length; ++i) {
+        unsigned int value = 0;
+        [[NSScanner scannerWithString:[hex substringWithRange:NSMakeRange(i * 2, 2)]] scanHexInt:&value];
+        ((uint8_t *)data.mutableBytes)[i] = (uint8_t)value;
+    }
+    return data;
+}
+
+- (void)testRFC8032SignatureVerificationAndIdentityRestoration {
+    NSData *publicKey = [self hex:@"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"];
+    NSData *signature = [self hex:@"e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"];
+    NSError *error = nil;
+    XCTAssertTrue([OMEMO2Context verifySignature:signature data:[NSData data] identityKey:publicKey error:&error]);
+    XCTAssertNil(error);
+    XCTAssertFalse([OMEMO2Context verifySignature:signature data:[self hex:@"01"] identityKey:publicKey error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    OMEMO2IdentityKeyPair *original = [context generateIdentityWithError:&error];
+    OMEMO2IdentityKeyPair *restored = [context identityWithPrivateKey:original.privateKey error:&error];
+    XCTAssertEqualObjects(original.publicKey, restored.publicKey);
+    XCTAssertEqualObjects(original.fingerprintPublicKey, restored.fingerprintPublicKey);
+    XCTAssertEqualObjects(original.privateKey, restored.privateKey);
+    NSData *message = [self hex:@"010203"];
+    NSData *generated = [context signData:message identity:restored error:&error];
+    XCTAssertTrue([OMEMO2Context verifySignature:generated data:message identityKey:original.publicKey error:&error]);
+    XCTAssertNil(error);
+}
+
+- (void)testRFC7748PrivateImportAndMutableInputIsolation {
+    NSError *error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    NSMutableData *alicePrivate = [[self hex:@"77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"] mutableCopy];
+    NSData *expectedPublic = [self hex:@"8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"];
+    NSData *expectedIdentity = [self hex:@"8120f299c37ae1ca64a179f638a6c6fafde968f1c33705e28c413c7579d9884f"];
+    NSData *expectedPrivate = [self hex:@"70076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c6a"];
+    OMEMO2KeyPair *keyPair = [context keyPairWithPrivateKey:alicePrivate error:&error];
