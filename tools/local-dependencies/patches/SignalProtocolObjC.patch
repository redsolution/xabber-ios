+    [_lock unlock]; return output;
+}
+- (nullable OMEMO2Session *)acceptKeyExchange:(OMEMO2Ciphertext *)keyExchange identity:(OMEMO2IdentityKeyPair *)identity signedPreKey:(OMEMO2KeyPair *)signedPreKey signedPreKeyID:(uint32_t)signedPreKeyID preKey:(OMEMO2KeyPair *)preKey preKeyID:(uint32_t)preKeyID plaintext:(NSData **)plaintext error:(NSError **)error {
+    if (plaintext) { *plaintext = nil; }
+    if (!keyExchange || !keyExchange.isKeyExchange || !identity || !signedPreKey || !preKey || !OMEMO2KeyID(signedPreKeyID) || !OMEMO2KeyID(preKeyID)) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    [_lock lock];
+    omemo_session *session = NULL; signal_buffer *decrypted = NULL;
+    int result = omemo_session_begin_bob(&session, &decrypted, keyExchange.data.bytes, keyExchange.data.length, identity.nativeKeyPair, signedPreKeyID, signedPreKey.nativeKeyPair, preKeyID, preKey.nativeKeyPair, _nativeContext);
+    OMEMO2Session *output = nil;
+    if (OMEMO2Result(result, error)) {
+        output = [[OMEMO2Session alloc] initWithNativeSession:session context:self];
+        if (plaintext) { *plaintext = OMEMO2Data(decrypted); }
+    }
+    signal_buffer_bzero_free(decrypted); [_lock unlock]; return output;
+}
+- (nullable OMEMO2Session *)restoreSessionWithData:(NSData *)data error:(NSError **)error {
+    if (!data || data.length == 0) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    [_lock lock];
+    omemo_session *session = NULL;
+    int result = omemo_session_deserialize(&session, data.bytes, data.length, _nativeContext);
+    OMEMO2Session *output = OMEMO2Result(result, error) ? [[OMEMO2Session alloc] initWithNativeSession:session context:self] : nil;
+    [_lock unlock]; return output;
+}
+@end
+
+@implementation OMEMO2Session
+- (instancetype)initWithNativeSession:(omemo_session *)session context:(OMEMO2Context *)context {
+    if ((self = [super init])) { _nativeSession = session; _context = context; }
+    return self;
+}
+- (void)dealloc { omemo_session_free(_nativeSession); }
+- (BOOL)isKeyExchangePending { [_context.lock lock]; BOOL value = omemo_session_has_pending_key_exchange(_nativeSession) != 0; [_context.lock unlock]; return value; }
+- (uint32_t)sendCounter { [_context.lock lock]; uint32_t value = omemo_session_get_send_counter(_nativeSession); [_context.lock unlock]; return value; }
+- (uint32_t)remotePreKeyID { [_context.lock lock]; uint32_t value = omemo_session_get_remote_pre_key_id(_nativeSession); [_context.lock unlock]; return value; }
+- (uint32_t)receiveCounter { [_context.lock lock]; uint32_t value = omemo_session_get_receive_counter(_nativeSession); [_context.lock unlock]; return value; }
+- (uint32_t)previousCounter { [_context.lock lock]; uint32_t value = omemo_session_get_previous_counter(_nativeSession); [_context.lock unlock]; return value; }
+- (NSUInteger)skippedKeyCount { [_context.lock lock]; size_t value = omemo_session_get_skipped_count(_nativeSession); [_context.lock unlock]; return value; }
+- (NSData *)ephemeralKey { [_context.lock lock]; uint8_t key[32]; int result = omemo_session_get_ephemeral_key(_nativeSession, key); NSData *data = result >= 0 ? [NSData dataWithBytes:key length:sizeof(key)] : nil; [_context.lock unlock]; return data; }
+- (NSData *)ratchetKey { [_context.lock lock]; uint8_t key[32]; int result = omemo_session_get_ratchet_key(_nativeSession, key); NSData *data = result >= 0 ? [NSData dataWithBytes:key length:sizeof(key)] : nil; [_context.lock unlock]; return data; }
+- (NSData *)remoteIdentityKey { [_context.lock lock]; uint8_t key[32]; int result = omemo_session_get_remote_identity(_nativeSession, key); NSData *data = result >= 0 ? [NSData dataWithBytes:key length:sizeof(key)] : nil; [_context.lock unlock]; return data; }
+- (nullable OMEMO2Ciphertext *)encryptData:(NSData *)data error:(NSError **)error {
+    if (!data) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    [_context.lock lock];
+    signal_buffer *encrypted = NULL; int isKeyExchange = 0;
+    int result = omemo_session_encrypt(_nativeSession, &encrypted, &isKeyExchange, OMEMO2Bytes(data), data.length);
+    OMEMO2Ciphertext *output = OMEMO2Result(result, error) ? [[OMEMO2Ciphertext alloc] initWithData:OMEMO2Data(encrypted) keyExchange:isKeyExchange != 0 error:error] : nil;
+    signal_buffer_free(encrypted); [_context.lock unlock]; return output;
+}
+- (nullable NSData *)decryptCiphertext:(OMEMO2Ciphertext *)ciphertext error:(NSError **)error {
+    if (!ciphertext) { OMEMO2Result(SG_ERR_INVAL, error); return nil; }
+    [_context.lock lock];
+    signal_buffer *decrypted = NULL;
+    int result = omemo_session_decrypt(_nativeSession, &decrypted, ciphertext.data.bytes, ciphertext.data.length, ciphertext.isKeyExchange);
+    NSData *output = OMEMO2Result(result, error) ? OMEMO2Data(decrypted) : nil;
+    signal_buffer_bzero_free(decrypted); [_context.lock unlock]; return output;
+}
+- (nullable NSData *)serializedDataWithError:(NSError **)error {
+    [_context.lock lock]; signal_buffer *serialized = NULL;
+    int result = omemo_session_serialize(&serialized, _nativeSession);
+    NSData *output = OMEMO2Result(result, error) ? OMEMO2Data(serialized) : nil;
+    signal_buffer_bzero_free(serialized); [_context.lock unlock]; return output;
+}
+@end
