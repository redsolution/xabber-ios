+- (void)testMalformedWireAndLegacyStateAreRejected {
+    NSError *error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    XCTAssertNil([[OMEMO2Ciphertext alloc] initWithData:[self material:0 byte:0] keyExchange:NO error:&error]);
