+- (void)testSHA512ProviderMatchesIndependentKnownVector {
+    SignalCommonCryptoProvider *object = [[SignalCommonCryptoProvider alloc] init];
+    signal_crypto_provider provider = [object cryptoProvider];
+    const uint8_t input[] = {'a', 'b', 'c'};
+    const uint8_t expected[64] = {
+        0xdd,0xaf,0x35,0xa1,0x93,0x61,0x7a,0xba,0xcc,0x41,0x73,0x49,0xae,0x20,0x41,0x31,
+        0x12,0xe6,0xfa,0x4e,0x89,0xa9,0x7e,0xa2,0x0a,0x9e,0xee,0xe6,0x4b,0x55,0xd3,0x9a,
+        0x21,0x92,0x99,0x2a,0x27,0x4f,0xc1,0xa8,0x36,0xba,0x3c,0x23,0xa3,0xfe,0xeb,0xbd,
+        0x45,0x4d,0x44,0x23,0x64,0x3c,0xe8,0x0e,0x2a,0x9a,0xc9,0x4f,0xa5,0x4c,0xa4,0x9f
+    };
+    void *digest = NULL;
+    signal_buffer *output = NULL;
+    XCTAssertEqual(provider.sha512_digest_init_func(&digest, provider.user_data), 0);
+    XCTAssertEqual(provider.sha512_digest_update_func(digest, input, sizeof(input), provider.user_data), 0);
+    XCTAssertEqual(provider.sha512_digest_final_func(digest, &output, provider.user_data), 0);
+    XCTAssertEqual(signal_buffer_len(output), sizeof(expected));
+    XCTAssertEqual(memcmp(signal_buffer_data(output), expected, sizeof(expected)), 0);
+    signal_buffer_bzero_free(output);
+    provider.sha512_digest_cleanup_func(digest, provider.user_data);
+}
