++ (BOOL)verifySignature:(NSData *)signature data:(NSData *)data identityKey:(NSData *)identityKey error:(NSError * _Nullable * _Nullable)error;
+- (nullable OMEMO2Session *)initiateSessionWithIdentity:(OMEMO2IdentityKeyPair *)identity bundle:(OMEMO2Bundle *)bundle error:(NSError * _Nullable * _Nullable)error;
