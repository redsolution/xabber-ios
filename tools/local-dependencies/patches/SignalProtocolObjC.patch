+    XCTAssertEqual(signature.length, 64u);
+    OMEMO2Bundle *bundle = [[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:signature preKey:oneTimeKey.publicKey preKeyID:1 error:&error];
+    XCTAssertNotNil(bundle);
+    XCTAssertNil(error);
+    XCTAssertNotNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:INT32_MAX signature:signature preKey:oneTimeKey.publicKey preKeyID:INT32_MAX error:&error]);
+    XCTAssertNil(error);
+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:signature preKey:oneTimeKey.publicKey preKeyID:0 error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:UINT32_MAX signature:signature preKey:oneTimeKey.publicKey preKeyID:1 error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:signature preKey:[NSData data] preKeyID:1 error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:[self material:33 byte:5] signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:signature preKey:oneTimeKey.publicKey preKeyID:1 error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    XCTAssertNil([[OMEMO2Bundle alloc] initWithIdentityKey:identity.publicKey signedPreKey:signedKey.publicKey signedPreKeyID:1 signature:signature preKey:[self material:32 byte:0] preKeyID:1 error:&error]);
+    XCTAssertNotNil(error);
+    error = nil;
+    NSData *invalidSPK = [self material:32 byte:0];
+    NSData *invalidSPKSignature = [context signData:invalidSPK identity:identity error:&error];
+    XCTAssertNotNil(invalidSPKSignature);
