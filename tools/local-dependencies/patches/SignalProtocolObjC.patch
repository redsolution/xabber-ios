+- (void)testBundleAndCiphertextCopyMutableInputs {
+    NSError *error = nil;
+    OMEMO2Context *context = [[OMEMO2Context alloc] initWithError:&error];
+    OMEMO2IdentityKeyPair *senderIdentity = [context generateIdentityWithError:&error];
+    OMEMO2IdentityKeyPair *identity = [context generateIdentityWithError:&error];
+    OMEMO2KeyPair *signedKey = [context generateKeyPairWithError:&error];
+    OMEMO2KeyPair *oneTimeKey = [context generateKeyPairWithError:&error];
+    NSData *signature = [context signData:signedKey.publicKey identity:identity error:&error];
+    NSMutableData *mutableIdentity = [identity.publicKey mutableCopy];
+    NSMutableData *mutableSPK = [signedKey.publicKey mutableCopy];
+    NSMutableData *mutableOPK = [oneTimeKey.publicKey mutableCopy];
+    NSMutableData *mutableSignature = [signature mutableCopy];
+    OMEMO2Bundle *bundle = [[OMEMO2Bundle alloc] initWithIdentityKey:mutableIdentity signedPreKey:mutableSPK signedPreKeyID:1 signature:mutableSignature preKey:mutableOPK preKeyID:1 error:&error];
+    XCTAssertNotNil(bundle);
+    memset(mutableIdentity.mutableBytes, 0, mutableIdentity.length);
+    memset(mutableSPK.mutableBytes, 0, mutableSPK.length);
+    memset(mutableOPK.mutableBytes, 0, mutableOPK.length);
+    memset(mutableSignature.mutableBytes, 0, mutableSignature.length);
+    XCTAssertEqualObjects(bundle.identityKey, identity.publicKey);
+    XCTAssertEqualObjects(bundle.signedPreKey, signedKey.publicKey);
+    XCTAssertEqualObjects(bundle.preKey, oneTimeKey.publicKey);
+    XCTAssertEqualObjects(bundle.signature, signature);
+    XCTAssertFalse([bundle.identityKey isKindOfClass:[NSMutableData class]]);
+    OMEMO2Session *session = [context initiateSessionWithIdentity:senderIdentity bundle:bundle error:&error];
+    OMEMO2Ciphertext *encrypted = [session encryptData:[self material:48 byte:0x58] error:&error];
+    NSMutableData *wire = [encrypted.data mutableCopy];
+    OMEMO2Ciphertext *parsed = [[OMEMO2Ciphertext alloc] initWithData:wire keyExchange:encrypted.isKeyExchange error:&error];
+    XCTAssertNotNil(parsed);
+    memset(wire.mutableBytes, 0, wire.length);
+    XCTAssertEqualObjects(parsed.data, encrypted.data);
+    XCTAssertEqualObjects(parsed.ratchetKey, encrypted.ratchetKey);
+    XCTAssertEqualObjects(parsed.ephemeralKey, encrypted.ephemeralKey);
+    XCTAssertFalse([parsed.data isKindOfClass:[NSMutableData class]]);
+    XCTAssertNil(error);
+}
