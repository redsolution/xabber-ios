+    assert(omemo_public_key_encode(f.bundle.one_time_pre_key, ec_key_pair_get_public(f.opk)) == 0);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
