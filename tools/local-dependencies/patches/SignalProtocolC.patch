+static void test_skipped_key_snapshot_migration(void)
+{
+    fixture f;
+    signal_buffer *messages[3], *record, *upgraded, *plain = NULL, *next;
+    omemo_session *restored = NULL;
+    uint8_t ek[32], restored_ek[32];
+    int kex;
+    unsigned i;
+    fixture_create(&f);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
+    for(i = 0; i < 3; ++i) messages[i] = encrypt_test_message(f.alice, i, &kex);
+    begin_bob(&f, messages[2], 2);
+    record = legacy_v1_snapshot(f.bob);
+    assert(signal_buffer_len(record) == 356 + 2 * 68 && signal_buffer_data(record)[8] == 1);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_get_receive_counter(restored) == 3);
+    assert(omemo_session_get_skipped_count(restored) == 2);
+    upgraded = snapshot(restored);
+    assert(signal_buffer_data(upgraded)[8] == 2);
+    assert(signal_buffer_len(upgraded) == 364 + 2 * 76);
+    assert(read_be_u64(signal_buffer_data(upgraded) + 356) == 0);
+    assert(read_be_u64(signal_buffer_data(upgraded) + 364 + 68) == 0);
+    assert(read_be_u64(signal_buffer_data(upgraded) + 364 + 76 + 68) == 0);
+    omemo_session_free(f.bob); f.bob = restored; restored = NULL;
+    signal_buffer_bzero_free(record); signal_buffer_bzero_free(upgraded);
+
+    record = legacy_v1_snapshot(f.alice);
+    assert(omemo_session_get_ephemeral_key(f.alice, ek) == 0);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_has_pending_key_exchange(restored));
+    assert(omemo_session_get_send_counter(restored) == 3);
+    assert(omemo_session_get_ephemeral_key(restored, restored_ek) == 0 && memcmp(ek, restored_ek, 32) == 0);
+    omemo_session_free(f.alice); f.alice = restored; restored = NULL;
+    next = encrypt_test_message(f.alice, 3, &kex);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(next), signal_buffer_len(next), 1) == 0);
+    check_plain(plain, 3, 48); plain = NULL;
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(messages[0]), signal_buffer_len(messages[0]), 1) == 0);
+    check_plain(plain, 0, 48); plain = NULL;
+    signal_buffer_free(next);
+    for(i = 4; i <= 1000; ++i) {
+        next = encrypt_test_message(f.alice, i, &kex);
+        assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(next), signal_buffer_len(next), 1) == 0);
+        check_plain(plain, i, 48); plain = NULL;
+        signal_buffer_free(next);
+    }
+    assert(omemo_session_get_skipped_count(f.bob) == 1); /* Full v1 grace: 999 events. */
+    next = encrypt_test_message(f.alice, 1001, &kex);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(next), signal_buffer_len(next), 1) == 0);
+    check_plain(plain, 1001, 48); plain = NULL;
+    assert(omemo_session_get_skipped_count(f.bob) == 0);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(messages[1]), signal_buffer_len(messages[1]), 1) == SG_ERR_DUPLICATE_MESSAGE);
+    assert(plain == NULL);
+    signal_buffer_bzero_free(record); signal_buffer_free(next);
+    for(i = 0; i < 3; ++i) signal_buffer_free(messages[i]);
+    fixture_clear(&f);
+}
