+static void test_skipped_key_event_snapshot_validation(void)
+{
+    fixture f;
+    signal_buffer *delayed, *message, *record, *plain = NULL;
+    omemo_session *restored = NULL;
+    int kex;
+    fixture_create(&f);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
+    delayed = encrypt_test_message(f.alice, 0, &kex);
+    message = encrypt_test_message(f.alice, 1, &kex);
+    begin_bob(&f, message, 1);
+    record = snapshot(f.bob);
+    assert(signal_buffer_data(record)[8] == 2);
+    assert(read_be_u64(signal_buffer_data(record) + 356) == 1);
+    assert(read_be_u64(signal_buffer_data(record) + 364 + 68) == 1);
+    write_be_u64(signal_buffer_data(record) + 364 + 68, 2);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == SG_ERR_INVALID_MESSAGE);
+    write_be_u64(signal_buffer_data(record) + 364 + 68, 0);
+    write_be_u64(signal_buffer_data(record) + 356, 1000);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == SG_ERR_INVALID_MESSAGE);
+
+    /* Near UINT64_MAX, preserve relative ages instead of wrapping or pinning
+     * keys forever. A successful decrypt rebases the local event epoch. */
+    write_be_u64(signal_buffer_data(record) + 356, UINT64_MAX);
+    write_be_u64(signal_buffer_data(record) + 364 + 68, UINT64_MAX - 998);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    omemo_session_free(f.bob); f.bob = restored; restored = NULL;
+    signal_buffer_free(message); message = encrypt_test_message(f.alice, 2, &kex);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(message), signal_buffer_len(message), 1) == 0);
+    check_plain(plain, 2, 48); plain = NULL;
+    assert(omemo_session_get_skipped_count(f.bob) == 1);
+    signal_buffer_free(message); message = encrypt_test_message(f.alice, 3, &kex);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(message), signal_buffer_len(message), 1) == 0);
+    check_plain(plain, 3, 48); plain = NULL;
+    assert(omemo_session_get_skipped_count(f.bob) == 0);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(delayed), signal_buffer_len(delayed), 1) == SG_ERR_DUPLICATE_MESSAGE);
+    assert(plain == NULL);
+    signal_buffer_free(delayed); signal_buffer_free(message); signal_buffer_bzero_free(record);
+    fixture_clear(&f);
+}
+
+/* The selected remote OPK ID is public session metadata. It remains useful
+ * after ACK and restoring old snapshots, without app-side snapshot parsing. */
+static void test_remote_pre_key_id_persistence(void)
+{
+    fixture f;
+    signal_buffer *first, *reply = NULL, *plain = NULL, *record, *before;
+    omemo_session *restored = NULL;
+    uint8_t zeros[32] = {0};
+    int is_kex;
+    fixture_create(&f);
+    assert(omemo_session_get_remote_pre_key_id(NULL) == 0);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
+    assert(omemo_session_has_pending_key_exchange(f.alice));
+    before = snapshot(f.alice);
+    assert(omemo_session_get_remote_pre_key_id(f.alice) == f.bundle.one_time_pre_key_id);
+    assert_unchanged(f.alice, before);
+    signal_buffer_bzero_free(before);
+
+    record = legacy_v1_snapshot(f.alice);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_has_pending_key_exchange(restored));
+    assert(omemo_session_get_remote_pre_key_id(restored) == f.bundle.one_time_pre_key_id);
+    omemo_session_free(restored); restored = NULL;
+    signal_buffer_bzero_free(record);
+
+    first = encrypt_test_message(f.alice, 1, &is_kex);
+    assert(is_kex == 1);
+    begin_bob(&f, first, 1);
+    before = snapshot(f.bob);
+    assert(omemo_session_get_remote_pre_key_id(f.bob) == 0);
+    assert_unchanged(f.bob, before);
+    signal_buffer_bzero_free(before);
+    record = snapshot(f.bob);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_get_remote_pre_key_id(restored) == 0);
+    omemo_session_free(restored); restored = NULL;
+    signal_buffer_bzero_free(record);
+
+    assert(omemo_session_encrypt(f.bob, &reply, &is_kex, zeros, sizeof(zeros)) == 0);
+    assert(is_kex == 0);
+    assert(omemo_session_decrypt(f.alice, &plain, signal_buffer_data(reply), signal_buffer_len(reply), 0) == 0);
+    check_plain(plain, 0, sizeof(zeros));
+    assert(!omemo_session_has_pending_key_exchange(f.alice));
+    before = snapshot(f.alice);
+    assert(omemo_session_get_remote_pre_key_id(f.alice) == f.bundle.one_time_pre_key_id);
+    assert_unchanged(f.alice, before);
+    signal_buffer_bzero_free(before);
+    record = snapshot(f.alice);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(!omemo_session_has_pending_key_exchange(restored));
+    assert(omemo_session_get_remote_pre_key_id(restored) == f.bundle.one_time_pre_key_id);
+    omemo_session_free(restored); restored = NULL;
+    signal_buffer_bzero_free(record);
+    record = legacy_v1_snapshot(f.alice);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(!omemo_session_has_pending_key_exchange(restored));
+    assert(omemo_session_get_remote_pre_key_id(restored) == f.bundle.one_time_pre_key_id);
+    omemo_session_free(restored);
+    signal_buffer_bzero_free(record);
+    signal_buffer_free(first); signal_buffer_free(reply);
+    fixture_clear(&f);
+}
+
+int main(void)
+{
+    test_remote_pre_key_id_persistence();
+    test_independent_x3dh_ratchet_vector();
+    test_lifecycle();
+    test_failure_rollback();
+    test_uninitialized_receive_chain();
+    test_provider_failure_rollback();
+    test_bundle_and_profile_guards();
+    test_skip_limit_fifo();
+    test_skipped_key_event_retention();
+    test_skipped_key_snapshot_migration();
+    test_skipped_key_event_snapshot_validation();
+    puts("OMEMO2 session tests passed");
+    return 0;
+}
diff --git a/tests/test_omemo_wire.c b/tests/test_omemo_wire.c
new file mode 100644
index 0000000..8074921
--- /dev/null
+++ b/tests/test_omemo_wire.c
@@ -0,0 +1,312 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "signal_protocol.h"
+#include "omemo_wire.h"
+
+/* Independently written from XEP-0384 section 12 tags/lengths, not produced by
+ * the codec under test. Keys/ciphertext are deliberately synthetic. */
+static const uint8_t inner_fixture[] = {
+    0x08, 0x01, 0x10, 0x00, 0x1a, 0x20,
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+    0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+    0x22, 0x10,
+    0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7,
+    0xa8, 0xa9, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf
+};
+static const uint8_t auth_fixture[] = {
+    0x0a, 0x10,
+    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+    0x12, 0x38,
+    0x08, 0x01, 0x10, 0x00, 0x1a, 0x20,
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+    0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+    0x22, 0x10,
+    0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7,
+    0xa8, 0xa9, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf
+};
+
+static void assert_bytes(signal_buffer *actual, const uint8_t *expected, size_t len)
+{
+    assert(actual);
+    assert(signal_buffer_len(actual) == len);
+    assert(memcmp(signal_buffer_const_data(actual), expected, len) == 0);
+}
+
+static void create_kex_fixture(uint8_t kex_fixture[151])
+{
+    size_t i;
+    /* pk_id=123, spk_id=456, two raw 32-byte keys, auth length=76. */
+    kex_fixture[0] = 0x08; kex_fixture[1] = 0x7b;
+    kex_fixture[2] = 0x10; kex_fixture[3] = 0xc8; kex_fixture[4] = 0x03;
+    kex_fixture[5] = 0x1a; kex_fixture[6] = 0x20;
+    for(i = 0; i < 32; ++i) kex_fixture[7 + i] = (uint8_t)(32 + i);
+    kex_fixture[39] = 0x22; kex_fixture[40] = 0x20;
+    for(i = 0; i < 32; ++i) kex_fixture[41 + i] = (uint8_t)(64 + i);
+    kex_fixture[73] = 0x2a; kex_fixture[74] = 0x4c;
+    memcpy(kex_fixture + 75, auth_fixture, sizeof(auth_fixture));
+}
+
+static void test_independent_fixtures(void)
+{
+    omemo_message inner = {0};
+    omemo_authenticated_message auth = {0};
+    omemo_key_exchange kex = {0};
+    signal_buffer *encoded = 0;
+    uint8_t kex_fixture[151];
+    size_t i;
+    assert(omemo_message_decode(&inner, inner_fixture, sizeof(inner_fixture)) == 0);
+    assert(inner.n == 1 && inner.pn == 0);
+    for(i = 0; i < 32; ++i) assert(inner.dh_pub[i] == i);
+    assert_bytes(inner.ciphertext, inner_fixture + 40, 16);
+    assert(omemo_message_encode(&encoded, &inner) == 0);
+    assert_bytes(encoded, inner_fixture, sizeof(inner_fixture));
+    signal_buffer_free(encoded);
+    omemo_message_clear(&inner);
+    assert(!inner.ciphertext);
+
+    assert(omemo_authenticated_message_decode(&auth, auth_fixture, sizeof(auth_fixture)) == 0);
+    assert_bytes(auth.message, inner_fixture, sizeof(inner_fixture));
+    for(i = 0; i < 16; ++i) assert(auth.mac[i] == i + 16);
+    assert(omemo_authenticated_message_encode(&encoded, &auth) == 0);
+    assert_bytes(encoded, auth_fixture, sizeof(auth_fixture));
+    signal_buffer_free(encoded);
+
+    create_kex_fixture(kex_fixture);
+    assert(omemo_key_exchange_decode(&kex, kex_fixture, sizeof(kex_fixture)) == 0);
+    assert(kex.pk_id == 123 && kex.spk_id == 456);
+    for(i = 0; i < 32; ++i) {
+        assert(kex.ik[i] == 32 + i);
+        assert(kex.ek[i] == 64 + i);
+    }
+    assert(omemo_key_exchange_encode(&encoded, &kex) == 0);
+    assert_bytes(encoded, kex_fixture, sizeof(kex_fixture));
+    signal_buffer_free(encoded);
+    omemo_key_exchange_clear(&kex);
+    assert(!kex.message.message);
+    omemo_authenticated_message_clear(&auth);
+}
+
+static void test_original_inner_bytes(void)
+{
+    uint8_t reordered[85];
+    uint8_t authenticated[105];
+    /* Every unknown protobuf wire kind, including a matching unknown group.
+     * These are legal data and must be retained for MAC verification. */
+    static const uint8_t unknown[] = {
+        0x78, 0x80, 0x01, /* field 15, varint 128 */
+        0x79, 1, 2, 3, 4, 5, 6, 7, 8, /* fixed64 */
+        0x7a, 0x02, 0x5a, 0xa5, /* bytes */
+        0x7b, 0x08, 0x01, 0x7c, /* group */
+        0x7d, 1, 2, 3, 4 /* fixed32 */
+    };
+    omemo_authenticated_message auth = {0};
+    omemo_message inner = {0};
+    signal_buffer *encoded = 0;
+    size_t len = sizeof(inner_fixture) + sizeof(unknown);
+    assert(len <= sizeof(reordered));
+    /* Move n,pn after DH/ciphertext and keep extra fields inside the MAC input. */
+    memcpy(reordered, inner_fixture + 4, sizeof(inner_fixture) - 4);
+    memcpy(reordered + sizeof(inner_fixture) - 4, unknown, sizeof(unknown));
+    memcpy(reordered + len - 4, inner_fixture, 4);
+    authenticated[0] = 0x12;
+    authenticated[1] = (uint8_t)len;
+    memcpy(authenticated + 2, reordered, len);
+    memcpy(authenticated + 2 + len, auth_fixture, 18);
+    assert(omemo_authenticated_message_decode(&auth, authenticated, len + 20) == 0);
+    assert_bytes(auth.message, reordered, len);
+    assert(omemo_message_decode(&inner, reordered, len) == 0);
+    assert(inner.n == 1 && inner.pn == 0);
+    assert(omemo_authenticated_message_encode(&encoded, &auth) == 0);
+    /* Canonical outer fields may change order, original inner must not. */
+    assert(memcmp(signal_buffer_const_data(encoded) + 20, reordered, len) == 0);
+    signal_buffer_free(encoded);
+    omemo_message_clear(&inner);
+    omemo_authenticated_message_clear(&auth);
+}
+
+static void reject_inner(const uint8_t *data, size_t len)
+{
+    omemo_message inner = {0};
+    assert(omemo_message_decode(&inner, data, len) == SG_ERR_INVALID_PROTO_BUF);
+    assert(!inner.ciphertext);
+}
+
+static void test_malformed(void)
+{
+    uint8_t bad[256];
+    size_t i;
+    static const uint8_t tag_zero[] = {0};
+    static const uint8_t overflow[] = {0x08, 0x80, 0x80, 0x80, 0x80, 0x10};
+    static const uint8_t varint_overflow[] = {0x78, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x02};
+    static const uint8_t bad_wire[] = {0x0a, 0};
+    static const uint8_t bad_group[] = {0x7b, 0x74};
+    static const uint8_t stray_group_end[] = {0x7c};
+    static const uint8_t length_overflow[] = {0x1a, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01};
+    omemo_authenticated_message auth = {0};
+    omemo_key_exchange kex = {0};
+    omemo_message inner = {0};
+    signal_buffer *encoded = 0;
+    reject_inner(tag_zero, sizeof(tag_zero));
+    reject_inner(overflow, sizeof(overflow));
+    reject_inner(varint_overflow, sizeof(varint_overflow));
+    reject_inner(bad_wire, sizeof(bad_wire));
+    reject_inner(bad_group, sizeof(bad_group));
+    reject_inner(stray_group_end, sizeof(stray_group_end));
+    reject_inner(length_overflow, sizeof(length_overflow));
+    for(i = 0; i < 38; ++i) reject_inner(inner_fixture, i);
+    for(i = 39; i < sizeof(inner_fixture); ++i) reject_inner(inner_fixture, i);
+    /* Repeated known fields are rejected even when their values agree. */
+    memcpy(bad, inner_fixture, sizeof(inner_fixture));
+    bad[sizeof(inner_fixture)] = 0x08; bad[sizeof(inner_fixture) + 1] = 0x01;
+    reject_inner(bad, sizeof(inner_fixture) + 2);
+    memcpy(bad, inner_fixture, sizeof(inner_fixture));
+    bad[5] = 31;
+    reject_inner(bad, sizeof(inner_fixture));
+    memcpy(bad, inner_fixture, sizeof(inner_fixture));
+    bad[39] = 15;
+    reject_inner(bad, sizeof(inner_fixture) - 1);
+    bad[39] = 0;
+    reject_inner(bad, 40);
+    /* Header-only serialization is legal, but cannot be authenticated data. */
+    assert(omemo_message_decode(&inner, inner_fixture, 38) == 0);
+    assert(!inner.ciphertext);
+    assert(omemo_message_encode(&encoded, &inner) == 0);
+    assert_bytes(encoded, inner_fixture, 38);
+    signal_buffer_free(encoded);
+    omemo_message_clear(&inner);
+    memcpy(bad, auth_fixture, 20);
+    bad[19] = 38;
+    memcpy(bad + 20, inner_fixture, 38);
+    assert(omemo_authenticated_message_decode(&auth, bad, 58) == SG_ERR_INVALID_PROTO_BUF);
+    for(i = 0; i < sizeof(auth_fixture); ++i) {
+        assert(omemo_authenticated_message_decode(&auth, auth_fixture, i) == SG_ERR_INVALID_PROTO_BUF);
+        assert(!auth.message);
+    }
+    memcpy(bad, auth_fixture, sizeof(auth_fixture));
+    bad[1] = 8;
+    assert(omemo_authenticated_message_decode(&auth, bad, sizeof(auth_fixture)) == SG_ERR_INVALID_PROTO_BUF);
+    memcpy(bad, auth_fixture, sizeof(auth_fixture));
+    memcpy(bad + sizeof(auth_fixture), auth_fixture, 18);
+    assert(omemo_authenticated_message_decode(&auth, bad, sizeof(auth_fixture) + 18) == SG_ERR_INVALID_PROTO_BUF);
+    assert(omemo_key_exchange_decode(&kex, inner_fixture, sizeof(inner_fixture)) == SG_ERR_INVALID_PROTO_BUF);
+    assert(!kex.message.message);
+    /* Oversized claims are rejected before reading memory or allocating. */
+    reject_inner(inner_fixture, (size_t)OMEMO_WIRE_MAX_MESSAGE_LENGTH + 1);
+    assert(omemo_authenticated_message_decode(&auth, auth_fixture, (size_t)OMEMO_WIRE_MAX_MESSAGE_LENGTH + 1) == SG_ERR_INVALID_PROTO_BUF);
+    assert(omemo_key_exchange_decode(&kex, inner_fixture, (size_t)OMEMO_WIRE_MAX_MESSAGE_LENGTH + 1) == SG_ERR_INVALID_PROTO_BUF);
+}
+
+static void test_key_exchange_malformed(void)
+{
+    uint8_t fixture[151];
+    uint8_t bad[320];
+    omemo_key_exchange kex = {0};
+    size_t i;
+    static const size_t starts[] = {0, 2, 5, 39, 73};
+    static const size_t ends[] = {2, 5, 39, 73, 151};
+    create_kex_fixture(fixture);
+    for(i = 0; i < sizeof(fixture); ++i) {
+        assert(omemo_key_exchange_decode(&kex, fixture, i) == SG_ERR_INVALID_PROTO_BUF);
+        assert(!kex.message.message);
+    }
+    for(i = 0; i < 5; ++i) {
+        size_t field_len = ends[i] - starts[i];
+        /* Every required field rejects duplicate input. */
+        memcpy(bad, fixture, sizeof(fixture));
+        memcpy(bad + sizeof(fixture), fixture + starts[i], field_len);
+        assert(omemo_key_exchange_decode(&kex, bad, sizeof(fixture) + field_len) == SG_ERR_INVALID_PROTO_BUF);
+        assert(!kex.message.message);
+        /* Every required field rejects omission. */
+        memcpy(bad, fixture, starts[i]);
+        memcpy(bad + starts[i], fixture + ends[i], sizeof(fixture) - ends[i]);
+        assert(omemo_key_exchange_decode(&kex, bad, sizeof(fixture) - field_len) == SG_ERR_INVALID_PROTO_BUF);
+        assert(!kex.message.message);
+        /* Every known field rejects its incompatible protobuf wire type. */
+        memcpy(bad, fixture, sizeof(fixture));
+        bad[starts[i]] ^= 2;
+        assert(omemo_key_exchange_decode(&kex, bad, sizeof(fixture)) == SG_ERR_INVALID_PROTO_BUF);
+        assert(!kex.message.message);
+    }
+    memcpy(bad, fixture, sizeof(fixture));
+    bad[6] = 33; /* Signal's type-prefixed identity key is not an OMEMO key. */
+    assert(omemo_key_exchange_decode(&kex, bad, sizeof(fixture)) == SG_ERR_INVALID_PROTO_BUF);
+    memcpy(bad, fixture, sizeof(fixture));
+    bad[40] = 31;
+    assert(omemo_key_exchange_decode(&kex, bad, sizeof(fixture)) == SG_ERR_INVALID_PROTO_BUF);
+    /* Reordered outer fields with an unknown bytes field remain legal. */
+    memcpy(bad, fixture + 73, 78);
+    memcpy(bad + 78, fixture, 73);
+    bad[151] = 0x32; bad[152] = 1; bad[153] = 0xff;
+    assert(omemo_key_exchange_decode(&kex, bad, 154) == 0);
+    assert(kex.pk_id == 123 && kex.spk_id == 456);
+    assert_bytes(kex.message.message, inner_fixture, sizeof(inner_fixture));
+    omemo_key_exchange_clear(&kex);
+}
+
+static void test_resource_bounds(void)
+{
+    omemo_message inner = {0};
+    signal_buffer *encoded = 0;
+    uint8_t groups[122];
+    size_t i;
+    memcpy(groups, inner_fixture, sizeof(inner_fixture));
+    for(i = 0; i < 32; ++i) groups[sizeof(inner_fixture) + i] = 0x7b;
+    for(i = 0; i < 32; ++i) groups[sizeof(inner_fixture) + 32 + i] = 0x7c;
+    assert(omemo_message_decode(&inner, groups, sizeof(inner_fixture) + 64) == 0);
+    omemo_message_clear(&inner);
+    groups[sizeof(inner_fixture) + 32] = 0x7b;
+    groups[sizeof(inner_fixture) + 65] = 0x7c;
+    reject_inner(groups, sizeof(inner_fixture) + 66);
+    /* The full serialized message, including tags/lengths, must fit the cap. */
+    inner.ciphertext = signal_buffer_alloc(OMEMO_WIRE_MAX_MESSAGE_LENGTH);
+    assert(inner.ciphertext);
+    assert(omemo_message_encode(&encoded, &inner) == SG_ERR_INVAL && !encoded);
+    omemo_message_clear(&inner);
+}
+
+static void test_scalar_edges_and_arguments(void)
+{
+    omemo_message inner = {0};
+    omemo_message decoded = {0};
+    omemo_authenticated_message auth = {0};
+    omemo_key_exchange kex = {0};
+    signal_buffer *encoded = 0;
+    uint8_t block[16] = {0};
+    inner.n = UINT32_MAX;
+    inner.pn = UINT32_MAX;
+    inner.ciphertext = signal_buffer_create(block, sizeof(block));
+    assert(inner.ciphertext);
+    assert(omemo_message_encode(&encoded, &inner) == 0);
+    assert(signal_buffer_const_data(encoded)[1] == 0xff);
+    assert(omemo_message_decode(&decoded, signal_buffer_const_data(encoded), signal_buffer_len(encoded)) == 0);
+    assert(decoded.n == UINT32_MAX && decoded.pn == UINT32_MAX);
+    omemo_message_clear(&decoded);
+    signal_buffer_free(encoded);
+    omemo_message_clear(&inner);
+    assert(omemo_message_encode(0, &inner) == SG_ERR_INVAL);
+    assert(omemo_message_encode(&encoded, 0) == SG_ERR_INVAL && !encoded);
+    assert(omemo_message_decode(0, inner_fixture, sizeof(inner_fixture)) == SG_ERR_INVAL);
+    assert(omemo_message_decode(&inner, 0, 1) == SG_ERR_INVAL);
+    assert(omemo_authenticated_message_encode(&encoded, &auth) == SG_ERR_INVAL && !encoded);
+    assert(omemo_key_exchange_encode(&encoded, &kex) == SG_ERR_INVAL && !encoded);
+}
+
+int main(void)
+{
+    test_independent_fixtures();
+    test_original_inner_bytes();
+    test_malformed();
+    test_key_exchange_malformed();
+    test_resource_bounds();
+    test_scalar_edges_and_arguments();
+    puts("OMEMO wire tests passed");
+    return 0;
+}
