+static uint32_t read_be_u32(const uint8_t *bytes)
+{
+    return ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
+            ((uint32_t)bytes[2] << 8) | bytes[3];
+}
+
+static uint64_t read_be_u64(const uint8_t *bytes)
+{
+    return ((uint64_t)read_be_u32(bytes) << 32) | read_be_u32(bytes + 4);
+}
+
+static void write_be_u64(uint8_t *bytes, uint64_t value)
+{
+    unsigned i;
+    for(i = 0; i < 8; ++i) bytes[i] = (uint8_t)(value >> (56 - i * 8));
+}
+
+/* Materialize the exact old local format, including retained MK bytes. No
+ * deserialize/serialize implementation is used to manufacture this fixture. */
+static signal_buffer *legacy_v1_snapshot(const omemo_session *session)
+{
+    signal_buffer *current = snapshot(session), *legacy;
+    const uint8_t *bytes = signal_buffer_const_data(current);
+    size_t count = read_be_u32(bytes + 352), i;
+    if(bytes[8] == 1) return current;
+    assert(bytes[8] == 2 && signal_buffer_len(current) == 364 + count * 76);
+    legacy = signal_buffer_alloc(356 + count * 68);
+    assert(legacy);
+    memcpy(signal_buffer_data(legacy), bytes, 356);
+    signal_buffer_data(legacy)[8] = 1;
+    for(i = 0; i < count; ++i) memcpy(signal_buffer_data(legacy) + 356 + i * 68,
+            bytes + 364 + i * 76, 68);
+    signal_buffer_bzero_free(current);
+    return legacy;
+}
