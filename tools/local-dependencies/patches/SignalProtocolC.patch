+static int fail_hmac_init(void **hmac_context, const uint8_t *key, size_t len, void *user_data)
+{ (void)key; (void)len; (void)user_data; *hmac_context = NULL; return SG_ERR_UNKNOWN; }
+static int fail_hmac_update(void *hmac_context, const uint8_t *data, size_t len, void *user_data)
+{ (void)hmac_context; (void)data; (void)len; (void)user_data; return SG_ERR_UNKNOWN; }
+static int fail_hmac_final(void *hmac_context, signal_buffer **output, void *user_data)
+{ (void)hmac_context; (void)user_data; *output = NULL; return SG_ERR_UNKNOWN; }
+static int fail_random(uint8_t *data, size_t len, void *user_data)
+{ (void)data; (void)len; (void)user_data; return SG_ERR_UNKNOWN; }
+static int fail_cipher(signal_buffer **output, int cipher, const uint8_t *key, size_t key_len,
+        const uint8_t *iv, size_t iv_len, const uint8_t *input, size_t input_len, void *user_data)
+{ (void)cipher; (void)key; (void)key_len; (void)iv; (void)iv_len; (void)input; (void)input_len; (void)user_data;
+  *output = NULL; return SG_ERR_UNKNOWN; }
