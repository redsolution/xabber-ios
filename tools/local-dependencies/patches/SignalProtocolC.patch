diff --git a/protobuf/OMEMO.proto b/protobuf/OMEMO.proto
new file mode 100644
index 0000000..07256c6
--- /dev/null
+++ b/protobuf/OMEMO.proto
@@ -0,0 +1,23 @@
+syntax = "proto2";
+
+// XEP-0384 0.9.1, section 12. Wire keys are raw 32-byte public keys.
+message OMEMOMessage {
+    required uint32 n = 1;
+    required uint32 pn = 2;
+    required bytes dh_pub = 3;
+    optional bytes ciphertext = 4;
+}
+
+message OMEMOAuthenticatedMessage {
+    required bytes mac = 1;
+    // Exact serialized OMEMOMessage bytes used by the authentication MAC.
+    required bytes message = 2;
+}
+
+message OMEMOKeyExchange {
+    required uint32 pk_id = 1;
+    required uint32 spk_id = 2;
+    required bytes ik = 3;
+    required bytes ek = 4;
+    required OMEMOAuthenticatedMessage message = 5;
+}
