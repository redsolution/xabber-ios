+    assert(omemo_key_exchange_encode(&bad, &kex) == 0);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(bad), signal_buffer_len(bad), 1) == SG_ERR_STALE_KEY_EXCHANGE);
