+/* N04's local event policy is independent of the wire counter and of sends.
+ * A skipped key survives 999 later accepted receives and expires on the
+ * 1000th. The creation receive itself gives the key age zero. */
+static void test_skipped_key_event_retention(void)
+{
+    fixture f;
+    signal_buffer *delayed, *first, *message, *plain = NULL, *record, *bad = NULL;
+    omemo_session *candidate = NULL;
+    omemo_key_exchange exchange = {0};
+    int kex;
+    unsigned i;
+    fixture_create(&f);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
+    delayed = encrypt_test_message(f.alice, 0, &kex);
+    first = encrypt_test_message(f.alice, 1, &kex);
+    begin_bob(&f, first, 1);
+    for(i = 2; i <= 1000; ++i) {
+        message = encrypt_test_message(f.alice, i, &kex);
+        assert(omemo_session_decrypt(f.bob, &plain,
+                signal_buffer_data(message), signal_buffer_len(message), 1) == 0);
+        check_plain(plain, i, 48); plain = NULL;
+        signal_buffer_free(message);
+        if(i == 500) {
+            record = snapshot(f.bob);
+            assert(omemo_session_deserialize(&candidate, signal_buffer_data(record),
+                    signal_buffer_len(record), f.context) == 0);
+            omemo_session_free(f.bob); f.bob = candidate; candidate = NULL;
+            signal_buffer_bzero_free(record);
+        }
+    }
+    assert(omemo_session_get_skipped_count(f.bob) == 1);
+
+    /* At the expiry boundary, sends and failed/duplicate receives do not age
+     * the retained key. Authenticating on a discarded application clone does
+     * not commit either the event or its erasure to the original session. */
+    message = encrypt_test_message(f.bob, 99, &kex);
+    signal_buffer_free(message);
+    assert(omemo_session_get_skipped_count(f.bob) == 1);
+    message = encrypt_test_message(f.alice, 1001, &kex);
+    assert(omemo_key_exchange_decode(&exchange, signal_buffer_data(message), signal_buffer_len(message)) == 0);
+    exchange.message.mac[0] ^= 1;
+    assert(omemo_key_exchange_encode(&bad, &exchange) == 0);
+    record = snapshot(f.bob);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(bad), signal_buffer_len(bad), 1) == SG_ERR_INVALID_MAC);
+    assert(plain == NULL); assert_unchanged(f.bob, record);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(first), signal_buffer_len(first), 1) == SG_ERR_DUPLICATE_MESSAGE);
+    assert(plain == NULL); assert_unchanged(f.bob, record);
+    assert(omemo_session_deserialize(&candidate, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_decrypt(candidate, &plain, signal_buffer_data(message), signal_buffer_len(message), 1) == 0);
+    check_plain(plain, 1001, 48); plain = NULL;
+    assert(omemo_session_get_skipped_count(candidate) == 0);
+    omemo_session_free(candidate); candidate = NULL;
+    assert_unchanged(f.bob, record);
+    assert(omemo_session_deserialize(&candidate, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    assert(omemo_session_decrypt(candidate, &plain, signal_buffer_data(delayed), signal_buffer_len(delayed), 1) == 0);
+    check_plain(plain, 0, 48); plain = NULL;
+    omemo_session_free(candidate); candidate = NULL;
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(message), signal_buffer_len(message), 1) == 0);
+    check_plain(plain, 1001, 48); plain = NULL;
+    assert(omemo_session_get_skipped_count(f.bob) == 0);
+    /* This remains a replay/stale candidate, not proof of authenticity. */
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(delayed), signal_buffer_len(delayed), 1) == SG_ERR_DUPLICATE_MESSAGE);
+    assert(plain == NULL);
+    signal_buffer_free(delayed); signal_buffer_free(first); signal_buffer_free(message);
+    signal_buffer_free(bad); signal_buffer_bzero_free(record);
+    omemo_key_exchange_clear(&exchange); fixture_clear(&f);
+}
