+    signal_buffer_free(bad); kex.message.mac[0] ^= 1; kex.ik[0] ^= 1;
+    assert(omemo_key_exchange_encode(&bad, &kex) == 0);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(bad), signal_buffer_len(bad), 1) < 0);
+    assert_unchanged(f.bob, before); signal_buffer_free(bad); kex.ik[0] ^= 1;
