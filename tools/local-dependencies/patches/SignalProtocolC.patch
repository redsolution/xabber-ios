+    first = encrypt_test_message(f.alice, 1, &is_kex);
+    assert(omemo_key_exchange_decode(&kex, signal_buffer_data(first), signal_buffer_len(first)) == 0);
+    kex.message.mac[0] ^= 1;
+    assert(omemo_key_exchange_encode(&bad, &kex) == 0);
+    assert(omemo_session_begin_bob(&f.bob, &plain, signal_buffer_data(bad), signal_buffer_len(bad),
