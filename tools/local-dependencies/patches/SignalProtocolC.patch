diff --git a/tests/omemo/reference_vector.py b/tests/omemo/reference_vector.py
new file mode 100644
index 0000000..3cb510f
--- /dev/null
+++ b/tests/omemo/reference_vector.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Independent OMEMO2 session vector; all private inputs below are public test data.
+
+Only Python's standard library and the OpenSSL command line are required.
+Uses a literal RFC7748 integer Montgomery ladder, hashlib/HMAC for RFC5869,
+and OpenSSL AES-CBC rather than libsignal or its CommonCrypto test provider.
+Outputs the constants checked by tests/test_omemo_session.c.
+"""
+
+import hashlib
+import hmac
+import json
+import subprocess
+
+P = 2**255 - 19
+
+
+def x25519(private, public_u=9):
+    scalar = (int.from_bytes(private, "little") & ((1 << 254) - 8)) | (1 << 254)
+    x1 = public_u % P
+    x2, z2, x3, z3, swap = 1, 0, x1, 1, 0
+    for bit in range(254, -1, -1):
+        current = (scalar >> bit) & 1
+        swap ^= current
+        if swap:
+            x2, x3, z2, z3 = x3, x2, z3, z2
+        swap = current
+        a = (x2 + z2) % P
+        aa = a * a % P
+        b = (x2 - z2) % P
+        bb = b * b % P
+        e = (aa - bb) % P
+        c = (x3 + z3) % P
+        d = (x3 - z3) % P
+        da = d * a % P
+        cb = c * b % P
+        x3 = (da + cb) ** 2 % P
+        z3 = x1 * (da - cb) ** 2 % P
+        x2 = aa * bb % P
+        z2 = e * (aa + 121665 * e) % P
+    if swap:
+        x2, x3, z2, z3 = x3, x2, z3, z2
+    return (x2 * pow(z2, P - 2, P) % P).to_bytes(32, "little")
+
+
+def dh(private, remote_private):
+    return x25519(private, int.from_bytes(x25519(remote_private), "little"))
+
+
+def ed_identity(private):
+    """Birational Montgomery->Edwards mapping with the XEdDSA x sign zero."""
+    u = int.from_bytes(x25519(private), "little")
+    return ((u - 1) * pow(u + 1, P - 2, P) % P).to_bytes(32, "little")
+
+
+def mac(key, data):
+    return hmac.new(key, data, hashlib.sha256).digest()
+
+
+def hkdf(ikm, salt, info, length):
+    prk = mac(salt, ikm)
+    output, previous, counter = b"", b"", 1
+    while len(output) < length:
+        previous = mac(prk, previous + info + bytes([counter]))
+        output += previous
+        counter += 1
+    return output[:length]
+
+
+def main():
+    # These exact inputs are intentionally nonsecret, fixed test scalars.
+    alice_ik = bytes(range(1, 33))
+    bob_ik = bytes(range(65, 97))
+    bob_spk = bytes(range(129, 161))
+    bob_opk = bytes(range(193, 225))
+    alice_ek = bytes(range(33, 65))
+    alice_dh = bytes(range(97, 129))
+    zero = bytes(32)
+    x3dh_input = b"\xff" * 32 + b"".join([
+        dh(alice_ik, bob_spk), dh(alice_ek, bob_ik),
+        dh(alice_ek, bob_spk), dh(alice_ek, bob_opk),
+    ])
+    secret = hkdf(x3dh_input, zero, b"OMEMO X3DH", 32)
+    root_chain = hkdf(dh(alice_dh, bob_spk), secret, b"OMEMO Root Chain", 64)
+    message_key = mac(root_chain[32:], b"\x01")
+    next_chain = mac(root_chain[32:], b"\x02")
+    material = hkdf(message_key, zero, b"OMEMO Message Key Material", 80)
+    ciphertext = subprocess.run([
+        "openssl", "enc", "-aes-256-cbc", "-K", material[:32].hex(),
+        "-iv", material[64:].hex(),
+    ], input=b"\x01" * 48, capture_output=True, check=True).stdout
+    assert len(ciphertext) == 64
+    ad = ed_identity(alice_ik) + ed_identity(bob_ik)
+    # protobuf: n=0 field1; pn=0 field2; dh32 field3; ciphertext64 field4.
+    inner = b"\x08\x00\x10\x00\x1a\x20" + x25519(alice_dh) + b"\x22\x40" + ciphertext
+    results = {
+        "x3dh_secret": secret,
+        "initial_root": root_chain[:32], "initial_send_chain": root_chain[32:],
+        "ephemeral_public": x25519(alice_ek), "ratchet_public": x25519(alice_dh),
+        "first_message_key": message_key, "next_send_chain": next_chain,
+        "first_message_material": material, "associated_data": ad,
+        "first_ciphertext": ciphertext, "first_inner_protobuf": inner,
+        "first_mac16": mac(material[32:64], ad + inner)[:16],
+        "forged_zero_chain_material": hkdf(mac(zero, b"\x01"), zero, b"OMEMO Message Key Material", 80),
+    }
+    print(json.dumps({key: value.hex() for key, value in results.items()}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
