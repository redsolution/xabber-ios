+static void test_lifecycle(void)
+{
+    fixture f;
+    signal_buffer *messages[3], *plain = NULL, *record;
+    omemo_session *restored = NULL;
+    omemo_key_exchange kex[2] = {{0}, {0}};
+    int is_kex, i;
+    uint8_t ek[32], zeros[32] = {0};
+    fixture_create(&f);
+    assert(omemo_session_begin_alice(&f.alice, f.alice_ik, &f.bundle, f.context) == 0);
+    assert(omemo_session_has_pending_key_exchange(f.alice));
+    for(i = 0; i < 3; ++i) {
+        messages[i] = encrypt_test_message(f.alice, (unsigned)(i + 1), &is_kex);
+        assert(is_kex == 1);
+        assert(omemo_session_get_send_counter(f.alice) == (uint32_t)i + 1);
+    }
+    assert(omemo_key_exchange_decode(&kex[0], signal_buffer_data(messages[0]), signal_buffer_len(messages[0])) == 0);
+    assert(omemo_key_exchange_decode(&kex[1], signal_buffer_data(messages[1]), signal_buffer_len(messages[1])) == 0);
+    assert(memcmp(kex[0].ek, kex[1].ek, 32) == 0);
+    assert(omemo_session_get_ephemeral_key(f.alice, ek) == 0 && memcmp(ek, kex[0].ek, 32) == 0);
+    begin_bob(&f, messages[1], 2); /* First KEX may arrive out of order. */
+    assert(omemo_session_get_receive_counter(f.bob) == 2);
+    assert(omemo_session_get_skipped_count(f.bob) == 1);
+    record = snapshot(f.bob);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    omemo_session_free(f.bob); f.bob = restored;
+    signal_buffer_bzero_free(record);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(messages[0]), signal_buffer_len(messages[0]), 1) == 0);
+    check_plain(plain, 1, 48);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(messages[0]), signal_buffer_len(messages[0]), 1) == SG_ERR_DUPLICATE_MESSAGE);
+    assert(plain == NULL);
+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(messages[2]), signal_buffer_len(messages[2]), 1) == 0);
+    check_plain(plain, 3, 48);
+    signal_buffer_free(messages[0]);
+    assert(omemo_session_encrypt(f.bob, &messages[0], &is_kex, zeros, sizeof(zeros)) == 0);
+    assert(is_kex == 0);
+    record = snapshot(f.alice);
+    assert(omemo_session_deserialize(&restored, signal_buffer_data(record), signal_buffer_len(record), f.context) == 0);
+    omemo_session_free(f.alice); f.alice = restored;
+    signal_buffer_bzero_free(record);
+    assert(omemo_session_decrypt(f.alice, &plain, signal_buffer_data(messages[0]), signal_buffer_len(messages[0]), 0) == 0);
+    check_plain(plain, 0, 32);
+    assert(!omemo_session_has_pending_key_exchange(f.alice));
+    signal_buffer_free(messages[1]); messages[1] = encrypt_test_message(f.alice, 4, &is_kex);
