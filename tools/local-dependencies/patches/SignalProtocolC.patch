+++ b/src/omemo_keys.h
@@ -0,0 +1,34 @@
+#ifndef OMEMO_KEYS_H
+#define OMEMO_KEYS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "curve.h"
+#include "signal_protocol.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* XEP-0384 0.9.1 §4.2. Legacy Signal key encoding is unchanged. */
+int omemo_public_key_encode(uint8_t output[32], const ec_public_key *key);
+int omemo_public_key_decode(ec_public_key **key, const uint8_t input[32], signal_context *context);
+/* RFC7748 private-scalar decoding; derives a matching clamped key pair. */
+int omemo_key_pair_from_private(ec_key_pair **pair, const uint8_t input[32], signal_context *context);
+/* Curve25519 local identities use XEdDSA with sign bit zero; remote Ed25519
+ * identities retain their original wire bytes in the caller's associated data. */
+int omemo_identity_key_encode(uint8_t output[32], const ec_public_key *key);
+int omemo_identity_key_decode(ec_public_key **key, const uint8_t input[32], signal_context *context);
+int omemo_identity_sign(uint8_t signature[64], const ec_private_key *key,
+        const uint8_t *message, size_t message_len, signal_context *context);
+/* Returns 0 only for a valid RFC8032-compatible signature; errors are negative. */
+int omemo_identity_verify(const uint8_t identity[32], const uint8_t *message,
+        size_t message_len, const uint8_t signature[64]);
+/* Rejects an all-zero shared secret; output is cleared on failure. */
+int omemo_calculate_agreement(uint8_t output[32], const ec_public_key *public_key,
+        const ec_private_key *private_key);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/omemo_session.c b/src/omemo_session.c
new file mode 100644
index 0000000..6628f98
--- /dev/null
+++ b/src/omemo_session.c
@@ -0,0 +1,732 @@
+#include "omemo_session.h"
+
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "curve.h"
+#include "omemo_keys.h"
+#include "omemo_wire.h"
+#include "signal_protocol.h"
+#include "signal_protocol_internal.h"
+
+/* Private local persistence format. No Signal wire or storage parser can
+ * mistake this profile for a legacy session. Multi-byte integers are BE.
+ * v1: Header[12], counters[12], IDs[8], AD[64], EKpub[32], EKpriv[32],
+ * DHpub[32], DHpriv[32], DHremote[32], root[32], send[32], receive[32],
+ * skipped-count[4], followed by FIFO (DH[32], N[4], MK[32]) entries.
+ * v2: The same prefix through skipped-count, receive-events[8], followed by
+ * FIFO (DH[32], N[4], MK[32], created-event[8]) entries. v1 imports preserve
+ * every key and initialize event ages to zero, without resetting the ratchet. */
+static const uint8_t session_magic[8] = {'O','M','E','M','O','2','S',0};
+#define SESSION_V1_FIXED_LENGTH 356u
+#define SESSION_V1_SKIPPED_LENGTH 68u
+#define SESSION_FIXED_LENGTH 364u
+#define SESSION_SKIPPED_LENGTH 76u
+/* Local bounded retention policy: erase after this many subsequent accepted
+ * receive events. Independent of XEP's MAX_SKIP derivation/FIFO bound. */
+#define SESSION_SKIP_MAX_RECEIVE_EVENTS UINT64_C(1000)
+#define FLAG_SEND 1u
+#define FLAG_RECEIVE 2u
+#define FLAG_REMOTE 4u
+#define FLAG_PENDING 8u
+#define FLAG_EK_PRIVATE 16u
+
+typedef struct skipped_key {
+    uint8_t dh[32];
+    uint32_t n;
+    uint8_t mk[32];
+    uint64_t created_event;
+} skipped_key;
+
+struct omemo_session {
+    signal_context *context; /* Unowned; must outlive this session. */
+    ec_key_pair *dhs;
+    uint8_t role; /* 1 Alice, 2 Bob; role and AD order never change. */
+    uint8_t flags;
+    uint32_t ns, nr, pn, spk_id, pk_id;
+    uint8_t ad[64], ek[32], ek_private[32], dhr[32];
+    uint8_t root[32], cks[32], ckr[32];
+    uint64_t receive_events;
+    size_t skipped_count;
+    skipped_key skipped[OMEMO_SESSION_MAX_SKIP];
+};
+
+/* XEP-0384 §5.3.2 constrains SPK/OPK IDs despite protobuf's uint32 type. */
+static int valid_id(uint32_t id)
+{
+    return id > 0 && id <= INT32_MAX;
+}
+
+static int valid_plaintext(const uint8_t *plain, size_t len)
+{
+    uint8_t any = 0;
+    size_t i;
+    if(!plain) return 0;
+    if(len == OMEMO_SESSION_PLAINTEXT_LENGTH) return 1;
+    if(len != OMEMO_SESSION_EMPTY_PLAINTEXT_LENGTH) return 0;
+    for(i = 0; i < len; ++i) any |= plain[i];
+    return any == 0;
+}
+
+static int validate_pair(const ec_key_pair *pair, signal_context *context)
+{
+    ec_key_pair *derived = NULL;
+    signal_buffer *private_bytes = NULL;
+    int result;
+    if(!pair || !ec_key_pair_get_public(pair) || !ec_key_pair_get_private(pair)) return SG_ERR_INVAL;
+    result = ec_private_key_serialize(&private_bytes, ec_key_pair_get_private(pair));
+    if(result < 0) return result;
+    /* Legacy curve_generate_public_key/donna expect a pre-clamped scalar;
+     * the opt-in import helper applies RFC7748 before deriving the public key. */
+    if(signal_buffer_len(private_bytes) != 32) result = SG_ERR_INVALID_KEY;
+    else result = omemo_key_pair_from_private(&derived, signal_buffer_data(private_bytes), context);
+    signal_buffer_bzero_free(private_bytes);
+    if(result < 0) return result;
+    if(result >= 0 && ec_public_key_compare(ec_key_pair_get_public(derived), ec_key_pair_get_public(pair)) != 0) result = SG_ERR_INVALID_KEY;
+    SIGNAL_UNREF(derived);
+    return result;
+}
+
+static int private_encode(uint8_t output[32], const ec_private_key *key)
+{
+    signal_buffer *buffer = NULL;
+    int result = ec_private_key_serialize(&buffer, key);
+    if(result >= 0) {
+        if(signal_buffer_len(buffer) != 32) result = SG_ERR_INVALID_KEY;
+        else memcpy(output, signal_buffer_data(buffer), 32);
+    }
+    signal_buffer_bzero_free(buffer);
+    return result;
+}
+
+static int hmac(signal_context *context, uint8_t output[32], const uint8_t key[32],
+        const uint8_t *first, size_t first_len, const uint8_t *second, size_t second_len)
+{
+    void *hmac_context = NULL;
+    signal_buffer *mac = NULL;
+    int result = signal_hmac_sha256_init(context, &hmac_context, key, 32);
+    if(result < 0) goto complete;
+    result = signal_hmac_sha256_update(context, hmac_context, first, first_len);
+    if(result < 0) goto complete;
+    if(second_len) {
+        result = signal_hmac_sha256_update(context, hmac_context, second, second_len);
+        if(result < 0) goto complete;
+    }
+    result = signal_hmac_sha256_final(context, hmac_context, &mac);
+    if(result < 0) goto complete;
+    if(!mac || signal_buffer_len(mac) != 32) { result = SG_ERR_UNKNOWN; goto complete; }
+    memcpy(output, signal_buffer_data(mac), 32);
+complete:
+    if(hmac_context) signal_hmac_sha256_cleanup(context, hmac_context);
+    signal_buffer_bzero_free(mac);
+    return result;
+}
+
+static int derive(signal_context *context, uint8_t *output, size_t output_len,
+        const uint8_t *input, size_t input_len, const uint8_t salt[32], const char *info)
+{
+    /* RFC5869 extract/expand, using the same provider as legacy Signal but
+     * with initialized cleanup state and explicit erasure of all intermediates.
+     * The OMEMO profile requires at most 80 bytes (three SHA256 blocks). */
+    uint8_t prk[32] = {0}, previous[32] = {0}, block[97] = {0};
+    size_t info_len = strlen(info), offset = 0, previous_len = 0, amount;
+    uint8_t counter = 1;
+    int result;
+    if(!output || !output_len || output_len > 80 || info_len > 64) return SG_ERR_INVAL;
+    result = hmac(context, prk, salt, input, input_len, NULL, 0);
+    while(result >= 0 && offset < output_len) {
+        memcpy(block, previous, previous_len);
+        memcpy(block + previous_len, info, info_len);
+        block[previous_len + info_len] = counter++;
+        result = hmac(context, previous, prk, block, previous_len + info_len + 1, NULL, 0);
+        if(result < 0) break;
+        amount = output_len - offset < sizeof(previous) ? output_len - offset : sizeof(previous);
+        memcpy(output + offset, previous, amount);
+        offset += amount;
+        previous_len = sizeof(previous);
+    }
+    if(result < 0) signal_explicit_bzero(output, output_len);
+    signal_explicit_bzero(prk, sizeof(prk));
+    signal_explicit_bzero(previous, sizeof(previous));
+    signal_explicit_bzero(block, sizeof(block));
+    return result;
+}
+
+static int kdf_chain(signal_context *context, uint8_t chain[32], uint8_t message_key[32])
+{
+    uint8_t next[32] = {0};
+    const uint8_t message_label = 1, chain_label = 2;
+    int result = hmac(context, message_key, chain, &message_label, 1, NULL, 0);
+    if(result >= 0) result = hmac(context, next, chain, &chain_label, 1, NULL, 0);
+    if(result >= 0) memcpy(chain, next, 32);
+    else signal_explicit_bzero(message_key, 32);
+    signal_explicit_bzero(next, sizeof(next));
+    return result;
+}
+
+static int kdf_root(omemo_session *session, uint8_t chain[32], const uint8_t remote[32])
+{
+    ec_public_key *public_key = NULL;
+    uint8_t dh[32] = {0}, material[64] = {0};
+    int result = omemo_public_key_decode(&public_key, remote, session->context);
+    if(result >= 0) result = omemo_calculate_agreement(dh, public_key, ec_key_pair_get_private(session->dhs));
+    if(result >= 0) result = derive(session->context, material, sizeof(material), dh, sizeof(dh), session->root, "OMEMO Root Chain");
+    if(result >= 0) {
+        memcpy(session->root, material, 32);
+        memcpy(chain, material + 32, 32);
+    }
+    SIGNAL_UNREF(public_key);
+    signal_explicit_bzero(dh, sizeof(dh));
+    signal_explicit_bzero(material, sizeof(material));
+    return result;
+}
+
+static int x3dh(omemo_session *session, ec_private_key *our_ik, ec_private_key *our_ek,
+        ec_private_key *our_spk, ec_private_key *our_opk,
+        const uint8_t remote_ik[32], const uint8_t remote_ek[32],
+        const uint8_t remote_spk[32], const uint8_t remote_opk[32])
+{
+    uint8_t material[160] = {0}, salt[32] = {0};
+    ec_public_key *ik = NULL, *ek = NULL, *spk = NULL, *opk = NULL;
+    int result = omemo_identity_key_decode(&ik, remote_ik, session->context);
+    memset(material, 0xff, 32); /* X3DH Curve25519 domain separation F. */
+    if(result < 0) goto complete;
+    if(session->role == 1) {
+        result = omemo_public_key_decode(&spk, remote_spk, session->context);
+        if(result >= 0) result = omemo_public_key_decode(&opk, remote_opk, session->context);
+        if(result >= 0) result = omemo_calculate_agreement(material + 32, spk, our_ik);
+        if(result >= 0) result = omemo_calculate_agreement(material + 64, ik, our_ek);
+        if(result >= 0) result = omemo_calculate_agreement(material + 96, spk, our_ek);
+        if(result >= 0) result = omemo_calculate_agreement(material + 128, opk, our_ek);
+    }
+    else {
+        result = omemo_public_key_decode(&ek, remote_ek, session->context);
+        if(result >= 0) result = omemo_calculate_agreement(material + 32, ik, our_spk);
+        if(result >= 0) result = omemo_calculate_agreement(material + 64, ek, our_ik);
+        if(result >= 0) result = omemo_calculate_agreement(material + 96, ek, our_spk);
+        if(result >= 0) result = omemo_calculate_agreement(material + 128, ek, our_opk);
+    }
+    if(result >= 0) result = derive(session->context, session->root, 32,
+            material, sizeof(material), salt, "OMEMO X3DH");
+complete:
+    SIGNAL_UNREF(ik); SIGNAL_UNREF(ek); SIGNAL_UNREF(spk); SIGNAL_UNREF(opk);
+    signal_explicit_bzero(material, sizeof(material));
+    return result;
+}
+
+void omemo_session_free(omemo_session *session)
+{
+    if(!session) return;
+    SIGNAL_UNREF(session->dhs);
+    signal_explicit_bzero(session, sizeof(*session));
+    free(session);
+}
+
+static omemo_session *session_copy(const omemo_session *session)
+{
+    omemo_session *copy = malloc(sizeof(*copy));
+    if(!copy) return NULL;
+    memcpy(copy, session, sizeof(*copy));
+    SIGNAL_REF(copy->dhs);
+    return copy;
+}
+
+static void session_commit(omemo_session *session, omemo_session *candidate)
+{
+    ec_key_pair *old_pair = session->dhs;
+    memcpy(session, candidate, sizeof(*session));
+    candidate->dhs = NULL;
+    SIGNAL_UNREF(old_pair);
+    omemo_session_free(candidate);
+}
+
+int omemo_session_begin_alice(omemo_session **output, ec_key_pair *identity,
+        const omemo_session_bundle *bundle, signal_context *context)
+{
+    omemo_session *session = NULL;
+    ec_key_pair *ephemeral = NULL;
+    int result;
+    if(!output) return SG_ERR_INVAL;
+    *output = NULL;
+    if(!identity || !bundle || !context) return SG_ERR_INVAL;
+    if(!valid_id(bundle->signed_pre_key_id) || !valid_id(bundle->one_time_pre_key_id)) return SG_ERR_INVALID_KEY_ID;
+    result = validate_pair(identity, context);
+    if(result >= 0) result = omemo_identity_verify(bundle->identity_key,
+            bundle->signed_pre_key, 32, bundle->signed_pre_key_signature);
+    if(result < 0) return result;
+    session = calloc(1, sizeof(*session));
+    if(!session) return SG_ERR_NOMEM;
+    session->context = context;
+    session->role = 1;
+    session->spk_id = bundle->signed_pre_key_id;
+    session->pk_id = bundle->one_time_pre_key_id;
+    result = omemo_identity_key_encode(session->ad, ec_key_pair_get_public(identity));
+    if(result < 0) goto complete;
+    memcpy(session->ad + 32, bundle->identity_key, 32);
+    result = curve_generate_key_pair(context, &ephemeral);
+    if(result >= 0) result = omemo_public_key_encode(session->ek, ec_key_pair_get_public(ephemeral));
+    if(result >= 0) result = private_encode(session->ek_private, ec_key_pair_get_private(ephemeral));
+    if(result >= 0) result = x3dh(session, ec_key_pair_get_private(identity), ec_key_pair_get_private(ephemeral),
+            NULL, NULL, bundle->identity_key, NULL, bundle->signed_pre_key, bundle->one_time_pre_key);
+    if(result >= 0) result = curve_generate_key_pair(context, &session->dhs);
+    if(result >= 0) result = kdf_root(session, session->cks, bundle->signed_pre_key);
+    if(result < 0) goto complete;
+    memcpy(session->dhr, bundle->signed_pre_key, 32);
+    session->flags = FLAG_SEND | FLAG_REMOTE | FLAG_PENDING | FLAG_EK_PRIVATE;
+    *output = session; session = NULL;
+complete:
+    SIGNAL_UNREF(ephemeral);
+    omemo_session_free(session);
+    return result;
+}
+
+static int authenticated_encrypt(omemo_session *session, omemo_authenticated_message *auth,
+        const uint8_t mk[32], const uint8_t *plaintext, size_t plaintext_len)
+{
+    omemo_message message = {0};
+    uint8_t material[80] = {0}, salt[32] = {0}, mac[32] = {0};
+    int result = derive(session->context, material, sizeof(material), mk, 32, salt, "OMEMO Message Key Material");
+    if(result >= 0) result = omemo_public_key_encode(message.dh_pub, ec_key_pair_get_public(session->dhs));
+    if(result >= 0) result = signal_encrypt(session->context, &message.ciphertext, SG_CIPHER_AES_CBC_PKCS5,
+            material, 32, material + 64, 16, plaintext, plaintext_len);
+    message.n = session->ns;
+    message.pn = session->pn;
+    if(result >= 0) result = omemo_message_encode(&auth->message, &message);
+    if(result >= 0) result = hmac(session->context, mac, material + 32,
+            session->ad, sizeof(session->ad), signal_buffer_data(auth->message), signal_buffer_len(auth->message));
+    if(result >= 0) memcpy(auth->mac, mac, 16);
+    else omemo_authenticated_message_clear(auth);
+    signal_explicit_bzero(material, sizeof(material));
+    signal_explicit_bzero(mac, sizeof(mac));
+    omemo_message_clear(&message);
+    return result;
+}
+
+int omemo_session_encrypt(omemo_session *session, signal_buffer **output, int *is_key_exchange,
+        const uint8_t *plaintext, size_t plaintext_len)
+{
+    omemo_session *candidate = NULL;
+    omemo_key_exchange kex = {0};
+    uint8_t mk[32] = {0};
+    int result;
+    if(!output || !is_key_exchange) return SG_ERR_INVAL;
+    *output = NULL; *is_key_exchange = 0;
+    if(!session || !valid_plaintext(plaintext, plaintext_len)) return SG_ERR_INVAL;
+    if(!(session->flags & FLAG_SEND)) return SG_ERR_NO_SESSION;
+    if(session->ns == UINT32_MAX) return SG_ERR_INVALID_MESSAGE;
+    candidate = session_copy(session);
+    if(!candidate) return SG_ERR_NOMEM;
+    result = kdf_chain(candidate->context, candidate->cks, mk);
+    if(result >= 0) result = authenticated_encrypt(candidate, &kex.message, mk, plaintext, plaintext_len);
+    if(result >= 0 && (candidate->flags & FLAG_PENDING)) {
+        kex.pk_id = candidate->pk_id;
+        kex.spk_id = candidate->spk_id;
+        memcpy(kex.ik, candidate->ad, 32);
+        memcpy(kex.ek, candidate->ek, 32);
+        result = omemo_key_exchange_encode(output, &kex);
+    }
+    else if(result >= 0) result = omemo_authenticated_message_encode(output, &kex.message);
+    if(result >= 0) {
+        *is_key_exchange = !!(candidate->flags & FLAG_PENDING);
+        candidate->ns++;
+        session_commit(session, candidate); candidate = NULL;
+    }
+    omemo_session_free(candidate);
+    omemo_key_exchange_clear(&kex);
+    signal_explicit_bzero(mk, sizeof(mk));
+    return result;
+}
+
+static void skipped_remove(omemo_session *session, size_t index)
+{
+    if(index + 1 < session->skipped_count) memmove(session->skipped + index,
+            session->skipped + index + 1, (session->skipped_count - index - 1) * sizeof(skipped_key));
+    session->skipped_count--;
+    signal_explicit_bzero(session->skipped + session->skipped_count, sizeof(skipped_key));
+}
+
+static void receive_events_rebase(omemo_session *session)
+{
+    size_t i;
+    if(session->receive_events != UINT64_MAX) return;
+    /* All retained ages are strictly below the policy bound. Changing the
+     * local epoch preserves those ages and makes room for the next event. */
+    for(i = 0; i < session->skipped_count; ++i) {
+        session->skipped[i].created_event = SESSION_SKIP_MAX_RECEIVE_EVENTS -
+                (session->receive_events - session->skipped[i].created_event);
+    }
+    session->receive_events = SESSION_SKIP_MAX_RECEIVE_EVENTS;
+}
+
+static void receive_event_commit(omemo_session *session)
+{
+    size_t i = 0;
+    session->receive_events++;
+    while(i < session->skipped_count) {
+        if(session->receive_events - session->skipped[i].created_event >= SESSION_SKIP_MAX_RECEIVE_EVENTS)
+            skipped_remove(session, i);
+        else ++i;
+    }
+}
+
+static int skip_keys(omemo_session *session, uint32_t until, size_t *budget)
+{
+    uint64_t count = until > session->nr ? (uint64_t)until - session->nr : 0;
+    uint8_t mk[32] = {0};
+    int result = SG_SUCCESS;
+    if(count > *budget) return SG_ERR_INVALID_MESSAGE;
+    if(!(session->flags & FLAG_RECEIVE)) return count ? SG_ERR_INVALID_MESSAGE : SG_SUCCESS;
+    *budget -= (size_t)count;
+    while(session->nr < until) {
+        result = kdf_chain(session->context, session->ckr, mk);
+        if(result < 0) break;
+        if(session->skipped_count == OMEMO_SESSION_MAX_SKIP) skipped_remove(session, 0);
+        memcpy(session->skipped[session->skipped_count].dh, session->dhr, 32);
+        session->skipped[session->skipped_count].n = session->nr;
+        memcpy(session->skipped[session->skipped_count].mk, mk, 32);
+        /* Age zero at the successful receive that creates this key. The whole
+         * candidate is discarded if that receive fails authentication. */
+        session->skipped[session->skipped_count].created_event = session->receive_events + 1;
+        session->skipped_count++;
+        session->nr++;
+    }
+    signal_explicit_bzero(mk, sizeof(mk));
+    return result;
+}
+
+static int ratchet_receive(omemo_session *session, const omemo_message *message, size_t *budget)
+{
+    ec_key_pair *fresh = NULL;
+    int result = skip_keys(session, message->pn, budget);
+    if(result < 0) return result;
+    session->pn = session->ns;
+    session->ns = 0;
+    session->nr = 0;
+    memcpy(session->dhr, message->dh_pub, 32);
+    session->flags |= FLAG_REMOTE;
+    result = kdf_root(session, session->ckr, session->dhr);
+    if(result >= 0) result = curve_generate_key_pair(session->context, &fresh);
+    if(result < 0) return result;
+    SIGNAL_UNREF(session->dhs);
+    session->dhs = fresh;
+    result = kdf_root(session, session->cks, session->dhr);
+    if(result >= 0) session->flags |= FLAG_SEND | FLAG_RECEIVE;
+    return result;
+}
+
+static int authenticated_decrypt(omemo_session *session, signal_buffer **output,
+        const omemo_authenticated_message *auth, const omemo_message *message, const uint8_t mk[32])
+{
+    uint8_t material[80] = {0}, salt[32] = {0}, mac[32] = {0};
+    int result = derive(session->context, material, sizeof(material), mk, 32, salt, "OMEMO Message Key Material");
+    if(result >= 0) result = hmac(session->context, mac, material + 32,
+            session->ad, sizeof(session->ad), signal_buffer_data(auth->message), signal_buffer_len(auth->message));
+    if(result >= 0 && signal_constant_memcmp(mac, auth->mac, 16) != 0) result = SG_ERR_INVALID_MAC;
+    if(result >= 0) result = signal_decrypt(session->context, output, SG_CIPHER_AES_CBC_PKCS5,
+            material, 32, material + 64, 16, signal_buffer_data(message->ciphertext), signal_buffer_len(message->ciphertext));
+    if(result >= 0 && (!*output || !valid_plaintext(signal_buffer_data(*output), signal_buffer_len(*output)))) result = SG_ERR_INVALID_MESSAGE;
+    if(result < 0) { signal_buffer_bzero_free(*output); *output = NULL; }
+    signal_explicit_bzero(material, sizeof(material));
+    signal_explicit_bzero(mac, sizeof(mac));
+    return result;
+}
+
+static int decrypt_auth(omemo_session *session, signal_buffer **output, const omemo_authenticated_message *auth)
+{
+    omemo_message message = {0};
+    omemo_session *candidate = NULL;
+    uint8_t mk[32] = {0};
+    size_t index, budget = OMEMO_SESSION_MAX_SKIP;
+    int result = omemo_message_decode(&message, signal_buffer_data(auth->message), signal_buffer_len(auth->message));
+    if(result < 0) return result;
+    if(!message.ciphertext || message.n == UINT32_MAX) { result = SG_ERR_INVALID_MESSAGE; goto complete; }
+    candidate = session_copy(session);
+    if(!candidate) { result = SG_ERR_NOMEM; goto complete; }
+    receive_events_rebase(candidate);
+    for(index = 0; index < candidate->skipped_count; ++index) {
+        if(candidate->skipped[index].n == message.n && memcmp(candidate->skipped[index].dh, message.dh_pub, 32) == 0) {
+            memcpy(mk, candidate->skipped[index].mk, 32);
+            result = authenticated_decrypt(candidate, output, auth, &message, mk);
+            if(result >= 0) skipped_remove(candidate, index);
+            goto authenticated;
+        }
+    }
+    if(!(candidate->flags & FLAG_REMOTE) || memcmp(candidate->dhr, message.dh_pub, 32) != 0) {
+        result = ratchet_receive(candidate, &message, &budget);
+        if(result < 0) goto complete;
+    }
+    /* Alice has no receiving chain until Bob's first DH ratchet. A message
+     * reusing Bob's initial SPK must never derive from an all-zero CK. */
+    if(!(candidate->flags & FLAG_RECEIVE)) { result = SG_ERR_INVALID_MESSAGE; goto complete; }
+    if(message.n < candidate->nr) { result = SG_ERR_DUPLICATE_MESSAGE; goto complete; }
+    result = skip_keys(candidate, message.n, &budget);
+    if(result >= 0) result = kdf_chain(candidate->context, candidate->ckr, mk);
+    if(result >= 0) { candidate->nr++; result = authenticated_decrypt(candidate, output, auth, &message, mk); }
+authenticated:
+    if(result >= 0) {
+        receive_event_commit(candidate);
+        candidate->flags &= (uint8_t)~FLAG_PENDING;
+        /* Keep EK private until session deletion to satisfy XEP persistence;
+         * only EK public is needed for matching delayed key exchanges. */
+        session_commit(session, candidate); candidate = NULL;
+    }
+complete:
+    omemo_session_free(candidate);
+    omemo_message_clear(&message);
+    signal_explicit_bzero(mk, sizeof(mk));
+    return result;
+}
+
+int omemo_session_decrypt(omemo_session *session, signal_buffer **output,
+        const uint8_t *ciphertext, size_t ciphertext_len, int is_key_exchange)
+{
+    omemo_key_exchange kex = {0};
+    int result;
+    if(!output) return SG_ERR_INVAL;
+    *output = NULL;
+    if(!session || !ciphertext || (is_key_exchange != 0 && is_key_exchange != 1)) return SG_ERR_INVAL;
+    if(is_key_exchange) {
+        result = omemo_key_exchange_decode(&kex, ciphertext, ciphertext_len);
+        if(result < 0) goto complete;
+        if(session->role != 2 || memcmp(session->ek, kex.ek, 32) != 0) { result = SG_ERR_STALE_KEY_EXCHANGE; goto complete; }
+        if(memcmp(session->ad, kex.ik, 32) != 0) { result = SG_ERR_UNTRUSTED_IDENTITY; goto complete; }
+        if(session->pk_id != kex.pk_id || session->spk_id != kex.spk_id) { result = SG_ERR_INVALID_KEY_ID; goto complete; }
+    }
+    else {
+        result = omemo_authenticated_message_decode(&kex.message, ciphertext, ciphertext_len);
+        if(result < 0) goto complete;
+    }
+    result = decrypt_auth(session, output, &kex.message);
+complete:
+    omemo_key_exchange_clear(&kex);
+    return result;
+}
+
+int omemo_session_begin_bob(omemo_session **output, signal_buffer **plaintext,
+        const uint8_t *key_exchange, size_t key_exchange_len, ec_key_pair *identity,
+        uint32_t signed_pre_key_id, ec_key_pair *signed_pre_key,
+        uint32_t one_time_pre_key_id, ec_key_pair *one_time_pre_key, signal_context *context)
+{
+    omemo_key_exchange kex = {0};
+    omemo_session *session = NULL;
+    int result;
+    if(!output || !plaintext) return SG_ERR_INVAL;
+    *output = NULL; *plaintext = NULL;
+    if(!key_exchange || !identity || !signed_pre_key || !one_time_pre_key || !context) return SG_ERR_INVAL;
+    if(!valid_id(signed_pre_key_id) || !valid_id(one_time_pre_key_id)) return SG_ERR_INVALID_KEY_ID;
+    result = omemo_key_exchange_decode(&kex, key_exchange, key_exchange_len);
+    if(result < 0) goto complete;
+    if(kex.spk_id != signed_pre_key_id || kex.pk_id != one_time_pre_key_id) { result = SG_ERR_INVALID_KEY_ID; goto complete; }
+    result = validate_pair(identity, context);
+    if(result >= 0) result = validate_pair(signed_pre_key, context);
+    if(result >= 0) result = validate_pair(one_time_pre_key, context);
+    if(result < 0) goto complete;
+    session = calloc(1, sizeof(*session));
+    if(!session) { result = SG_ERR_NOMEM; goto complete; }
+    session->context = context;
+    session->role = 2;
+    session->spk_id = signed_pre_key_id;
+    session->pk_id = one_time_pre_key_id;
+    session->dhs = signed_pre_key;
+    SIGNAL_REF(session->dhs);
+    memcpy(session->ek, kex.ek, 32);
+    memcpy(session->ad, kex.ik, 32);
+    result = omemo_identity_key_encode(session->ad + 32, ec_key_pair_get_public(identity));
+    if(result >= 0) result = x3dh(session, ec_key_pair_get_private(identity), NULL,
+            ec_key_pair_get_private(signed_pre_key), ec_key_pair_get_private(one_time_pre_key), kex.ik, kex.ek, NULL, NULL);
+    if(result >= 0) result = decrypt_auth(session, plaintext, &kex.message);
+    if(result >= 0) { *output = session; session = NULL; }
+complete:
+    omemo_key_exchange_clear(&kex);
+    omemo_session_free(session);
+    return result;
+}
+
+static void put_u32(uint8_t **cursor, uint32_t value)
+{
+    (*cursor)[0] = (uint8_t)(value >> 24); (*cursor)[1] = (uint8_t)(value >> 16);
+    (*cursor)[2] = (uint8_t)(value >> 8); (*cursor)[3] = (uint8_t)value;
+    *cursor += 4;
+}
+
+static uint32_t get_u32(const uint8_t **cursor)
+{
+    uint32_t value = ((uint32_t)(*cursor)[0] << 24) | ((uint32_t)(*cursor)[1] << 16) |
+            ((uint32_t)(*cursor)[2] << 8) | (*cursor)[3];
+    *cursor += 4;
+    return value;
+}
+
+static void put_u64(uint8_t **cursor, uint64_t value)
+{
+    put_u32(cursor, (uint32_t)(value >> 32));
+    put_u32(cursor, (uint32_t)value);
+}
+
+static uint64_t get_u64(const uint8_t **cursor)
+{
+    uint64_t high = get_u32(cursor);
+    return (high << 32) | get_u32(cursor);
+}
+
+static void put_bytes(uint8_t **cursor, const uint8_t *source, size_t len)
+{
+    memcpy(*cursor, source, len); *cursor += len;
+}
+
+static void get_bytes(const uint8_t **cursor, uint8_t *destination, size_t len)
+{
+    memcpy(destination, *cursor, len); *cursor += len;
+}
+
+int omemo_session_serialize(signal_buffer **output, const omemo_session *session)
+{
+    signal_buffer *record = NULL;
+    uint8_t *cursor, public_key[32] = {0}, private_key[32] = {0};
+    size_t length, i;
+    int result;
+    if(!output) return SG_ERR_INVAL;
+    *output = NULL;
+    if(!session || !session->dhs || session->skipped_count > OMEMO_SESSION_MAX_SKIP) return SG_ERR_INVAL;
+    result = omemo_public_key_encode(public_key, ec_key_pair_get_public(session->dhs));
+    if(result >= 0) result = private_encode(private_key, ec_key_pair_get_private(session->dhs));
+    if(result < 0) goto complete;
+    length = SESSION_FIXED_LENGTH + session->skipped_count * SESSION_SKIPPED_LENGTH;
+    record = signal_buffer_alloc(length);
+    if(!record) { result = SG_ERR_NOMEM; goto complete; }
+    cursor = signal_buffer_data(record);
+    put_bytes(&cursor, session_magic, sizeof(session_magic));
+    *cursor++ = 2; *cursor++ = session->role; *cursor++ = session->flags; *cursor++ = 0;
+    put_u32(&cursor, session->ns); put_u32(&cursor, session->nr); put_u32(&cursor, session->pn);
+    put_u32(&cursor, session->spk_id); put_u32(&cursor, session->pk_id);
+    put_bytes(&cursor, session->ad, 64); put_bytes(&cursor, session->ek, 32);
+    put_bytes(&cursor, session->ek_private, 32); put_bytes(&cursor, public_key, 32);
+    put_bytes(&cursor, private_key, 32); put_bytes(&cursor, session->dhr, 32);
+    put_bytes(&cursor, session->root, 32); put_bytes(&cursor, session->cks, 32); put_bytes(&cursor, session->ckr, 32);
+    put_u32(&cursor, (uint32_t)session->skipped_count);
+    put_u64(&cursor, session->receive_events);
+    for(i = 0; i < session->skipped_count; ++i) {
+        put_bytes(&cursor, session->skipped[i].dh, 32); put_u32(&cursor, session->skipped[i].n);
+        put_bytes(&cursor, session->skipped[i].mk, 32);
+        put_u64(&cursor, session->skipped[i].created_event);
+    }
+    *output = record; record = NULL;
+complete:
+    signal_buffer_bzero_free(record);
+    signal_explicit_bzero(private_key, sizeof(private_key));
+    return result;
+}
+
+int omemo_session_deserialize(omemo_session **output, const uint8_t *record, size_t record_len, signal_context *context)
+{
+    omemo_session *session = NULL;
+    ec_public_key *public_key = NULL, *validation_key = NULL;
+    ec_private_key *private_key = NULL;
+    uint8_t public_bytes[32] = {0}, private_bytes[32] = {0}, encoded[32] = {0};
+    const uint8_t *cursor;
+    size_t i, j, count, fixed_length, skipped_length;
+    uint8_t version;
+    int result = SG_ERR_INVALID_MESSAGE;
+    if(!output) return SG_ERR_INVAL;
+    *output = NULL;
+    if(!record || !context) return SG_ERR_INVAL;
+    if(record_len < 9 || memcmp(record, session_magic, sizeof(session_magic)) != 0 || (record[8] != 1 && record[8] != 2)) return SG_ERR_INVALID_VERSION;
+    version = record[8];
+    fixed_length = version == 1 ? SESSION_V1_FIXED_LENGTH : SESSION_FIXED_LENGTH;
+    skipped_length = version == 1 ? SESSION_V1_SKIPPED_LENGTH : SESSION_SKIPPED_LENGTH;
+    if(record_len < fixed_length || record_len > fixed_length + OMEMO_SESSION_MAX_SKIP * skipped_length) return SG_ERR_INVALID_MESSAGE;
+    if((record[9] != 1 && record[9] != 2) || (record[10] & (uint8_t)~31u) || record[11]) return SG_ERR_INVALID_MESSAGE;
+    session = calloc(1, sizeof(*session));
+    if(!session) return SG_ERR_NOMEM;
+    session->context = context;
+    session->role = record[9]; session->flags = record[10];
+    cursor = record + 12;
+    session->ns = get_u32(&cursor); session->nr = get_u32(&cursor); session->pn = get_u32(&cursor);
+    session->spk_id = get_u32(&cursor); session->pk_id = get_u32(&cursor);
+    if(!valid_id(session->spk_id) || !valid_id(session->pk_id)) goto complete;
+    /* Publicly returned sessions always have a send/remote chain. Bob is only
+     * exposed after a first authenticated message and has both chains. */
+    if(!(session->flags & FLAG_SEND) || !(session->flags & FLAG_REMOTE) ||
+            (session->role == 2 && ((session->flags & (FLAG_PENDING | FLAG_EK_PRIVATE)) || !(session->flags & FLAG_RECEIVE))) ||
+            (session->role == 1 && !(session->flags & FLAG_EK_PRIVATE)) ||
+            (session->role == 1 && !(session->flags & FLAG_RECEIVE) && !(session->flags & FLAG_PENDING)) ||
+            ((session->flags & FLAG_PENDING) && ((session->flags & FLAG_RECEIVE) || session->nr || session->pn))) goto complete;
+    get_bytes(&cursor, session->ad, 64); get_bytes(&cursor, session->ek, 32); get_bytes(&cursor, session->ek_private, 32);
+    get_bytes(&cursor, public_bytes, 32); get_bytes(&cursor, private_bytes, 32);
+    get_bytes(&cursor, session->dhr, 32); get_bytes(&cursor, session->root, 32);
+    get_bytes(&cursor, session->cks, 32); get_bytes(&cursor, session->ckr, 32);
+    count = get_u32(&cursor);
+    if(count > OMEMO_SESSION_MAX_SKIP || record_len != fixed_length + count * skipped_length) goto complete;
+    if(version == 2) session->receive_events = get_u64(&cursor);
+    if((session->flags & FLAG_PENDING) && count) goto complete;
+    if((session->flags & FLAG_PENDING) && session->receive_events) goto complete;
+    if((private_bytes[0] & 7) || (private_bytes[31] & 0xc0) != 0x40) {
+        result = SG_ERR_INVALID_KEY; goto complete;
+    }
+    result = omemo_public_key_decode(&public_key, public_bytes, context);
+    if(result >= 0) result = curve_decode_private_point(&private_key, private_bytes, 32, context);
+    if(result >= 0) result = ec_key_pair_create(&session->dhs, public_key, private_key);
+    if(result >= 0) result = validate_pair(session->dhs, context);
+    if(result < 0) goto complete;
+    SIGNAL_UNREF(public_key); public_key = NULL;
+    SIGNAL_UNREF(private_key); private_key = NULL;
+    result = omemo_identity_key_decode(&validation_key, session->ad, context);
+    SIGNAL_UNREF(validation_key); validation_key = NULL;
+    if(result >= 0) result = omemo_identity_key_decode(&validation_key, session->ad + 32, context);
+    SIGNAL_UNREF(validation_key); validation_key = NULL;
+    if(result >= 0) result = omemo_public_key_decode(&validation_key, session->dhr, context);
+    SIGNAL_UNREF(validation_key); validation_key = NULL;
+    if(result < 0) goto complete;
+    if(session->flags & FLAG_EK_PRIVATE) {
+        if((session->ek_private[0] & 7) || (session->ek_private[31] & 0xc0) != 0x40) {
+            result = SG_ERR_INVALID_KEY; goto complete;
+        }
+        result = curve_decode_private_point(&private_key, session->ek_private, 32, context);
+        if(result >= 0) result = curve_generate_public_key(&public_key, private_key);
+        if(result >= 0) result = omemo_public_key_encode(encoded, public_key);
+        if(result >= 0 && memcmp(encoded, session->ek, 32) != 0) result = SG_ERR_INVALID_KEY;
+        if(result < 0) goto complete;
+    }
+    else {
+        static const uint8_t zero[32] = {0};
+        if(memcmp(session->ek_private, zero, 32) != 0) { result = SG_ERR_INVALID_KEY; goto complete; }
+    }
+    for(i = 0; i < count; ++i) {
+        get_bytes(&cursor, session->skipped[i].dh, 32);
+        session->skipped[i].n = get_u32(&cursor);
+        get_bytes(&cursor, session->skipped[i].mk, 32);
+        if(version == 2) session->skipped[i].created_event = get_u64(&cursor);
+        if(session->skipped[i].n == UINT32_MAX ||
+                (memcmp(session->skipped[i].dh, session->dhr, 32) == 0 && session->skipped[i].n >= session->nr) ||
+                session->skipped[i].created_event > session->receive_events ||
+                session->receive_events - session->skipped[i].created_event >= SESSION_SKIP_MAX_RECEIVE_EVENTS) {
+            result = SG_ERR_INVALID_MESSAGE; goto complete;
+        }
+        for(j = 0; j < i; ++j) if(session->skipped[j].n == session->skipped[i].n &&
+                memcmp(session->skipped[j].dh, session->skipped[i].dh, 32) == 0) {
+            result = SG_ERR_INVALID_MESSAGE; goto complete;
+        }
+    }
+    session->skipped_count = count;
+    *output = session; session = NULL;
+    result = SG_SUCCESS;
+complete:
+    SIGNAL_UNREF(public_key); SIGNAL_UNREF(private_key); SIGNAL_UNREF(validation_key);
+    signal_explicit_bzero(private_bytes, sizeof(private_bytes));
+    omemo_session_free(session);
+    return result;
+}
+
+uint32_t omemo_session_get_send_counter(const omemo_session *s) { return s ? s->ns : 0; }
+uint32_t omemo_session_get_receive_counter(const omemo_session *s) { return s ? s->nr : 0; }
+uint32_t omemo_session_get_previous_counter(const omemo_session *s) { return s ? s->pn : 0; }
+uint32_t omemo_session_get_remote_pre_key_id(const omemo_session *s) { return s && s->role == 1 ? s->pk_id : 0; }
+size_t omemo_session_get_skipped_count(const omemo_session *s) { return s ? s->skipped_count : 0; }
+int omemo_session_has_pending_key_exchange(const omemo_session *s) { return s && (s->flags & FLAG_PENDING); }
+int omemo_session_get_ephemeral_key(const omemo_session *s, uint8_t key[32])
+{ if(!s || !key) return SG_ERR_INVAL; memcpy(key, s->ek, 32); return SG_SUCCESS; }
+int omemo_session_get_ratchet_key(const omemo_session *s, uint8_t key[32])
+{ if(!s || !key) return SG_ERR_INVAL; return omemo_public_key_encode(key, ec_key_pair_get_public(s->dhs)); }
+int omemo_session_get_remote_identity(const omemo_session *s, uint8_t key[32])
+{ if(!s || !key) return SG_ERR_INVAL; memcpy(key, s->ad + (s->role == 1 ? 32 : 0), 32); return SG_SUCCESS; }
diff --git a/src/omemo_session.h b/src/omemo_session.h
new file mode 100644
index 0000000..1f20d0c
--- /dev/null
+++ b/src/omemo_session.h
@@ -0,0 +1,85 @@
+#ifndef OMEMO_SESSION_H
+#define OMEMO_SESSION_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "signal_protocol_types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define OMEMO_SESSION_MAX_SKIP 1000u
+#define OMEMO_SESSION_PLAINTEXT_LENGTH 48u
+#define OMEMO_SESSION_EMPTY_PLAINTEXT_LENGTH 32u
+
+/* Independent, opt-in urn:xmpp:omemo:2 state. Never a legacy Signal record.
+ * The caller owns identity trust checks and atomic persistence/OPK removal.
+ * All calls require external synchronization when a session is shared. */
+typedef struct omemo_session omemo_session;
+
+typedef struct omemo_session_bundle {
+    uint8_t identity_key[32];             /* Raw Ed25519 public key. */
+    uint8_t signed_pre_key[32];           /* Raw X25519 public key. */
+    uint8_t signed_pre_key_signature[64]; /* Ed25519-compatible signature. */
+    uint8_t one_time_pre_key[32];         /* Required raw X25519 public key. */
+    uint32_t signed_pre_key_id;
+    uint32_t one_time_pre_key_id;
+} omemo_session_bundle;
+
+/* Starts Alice's X3DH/Double Ratchet with a fresh EK and a separate fresh
+ * ratchet key pair. Verifies the bundle signature. Native key pairs must have
+ * public keys matching RFC7748 scalar decoding (use key import helpers); identities use
+ * the OMEMO identity helpers for their raw Ed25519 representation. */
+int omemo_session_begin_alice(omemo_session **session,
+        ec_key_pair *identity, const omemo_session_bundle *bundle,
+        signal_context *context);
+
+/* Authenticates the first KEX before returning a new Bob session. Matching
+ * SPK/OPK IDs and both private key pairs are required. No state is returned on
+ * authentication failure; the caller must not remove the OPK before success. */
+int omemo_session_begin_bob(omemo_session **session, signal_buffer **plaintext,
+        const uint8_t *key_exchange, size_t key_exchange_len,
+        ec_key_pair *identity, uint32_t signed_pre_key_id,
+        ec_key_pair *signed_pre_key, uint32_t one_time_pre_key_id,
+        ec_key_pair *one_time_pre_key, signal_context *context);
+
+/* Encrypts key32 || payloadMAC16 (48 bytes), or 32 zero bytes for an empty
+ * OMEMO control message (XEP-0384 §5.5.3). On success *is_key_exchange marks
+ * which wire protobuf was emitted. KEX persists until an authenticated reply.
+ * Each send advances the existing chain; repeated KEX retains the same EK.
+ * Failure does not change state. Output buffers belong to the caller. */
+int omemo_session_encrypt(omemo_session *session, signal_buffer **ciphertext,
+        int *is_key_exchange, const uint8_t *plaintext, size_t plaintext_len);
+
+/* Decrypts either wire type. Repeated KEX must match the stored EK, IDs and
+ * remote identity. A different EK returns SG_ERR_STALE_KEY_EXCHANGE so the
+ * caller can explicitly accept a replacement with begin_bob().
+ * Authentication, parsing, replay, gap and crypto failures preserve all state. */
+int omemo_session_decrypt(omemo_session *session, signal_buffer **plaintext,
+        const uint8_t *ciphertext, size_t ciphertext_len, int is_key_exchange);
+
+/* Local secret snapshot: versioned OMEMO2 profile prefix, never a wire format.
+ * Requires protected storage. Rejects legacy records and unknown profiles.
+ * Serialized state includes pending KEX, EK, counters and FIFO skipped keys. */
+int omemo_session_serialize(signal_buffer **record, const omemo_session *session);
+int omemo_session_deserialize(omemo_session **session,
+        const uint8_t *record, size_t record_len, signal_context *context);
+void omemo_session_free(omemo_session *session);
+
+uint32_t omemo_session_get_send_counter(const omemo_session *session);
+uint32_t omemo_session_get_receive_counter(const omemo_session *session);
+uint32_t omemo_session_get_previous_counter(const omemo_session *session);
+/* Initiator's remote one-time pre-key ID, retained after acknowledgement.
+ * Returns zero for responder and NULL sessions; does not mutate state. */
+uint32_t omemo_session_get_remote_pre_key_id(const omemo_session *session);
+size_t omemo_session_get_skipped_count(const omemo_session *session);
+int omemo_session_has_pending_key_exchange(const omemo_session *session);
+int omemo_session_get_ephemeral_key(const omemo_session *session, uint8_t key[32]);
+int omemo_session_get_ratchet_key(const omemo_session *session, uint8_t key[32]);
+int omemo_session_get_remote_identity(const omemo_session *session, uint8_t key[32]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/omemo_wire.c b/src/omemo_wire.c
new file mode 100644
index 0000000..4063e31
--- /dev/null
+++ b/src/omemo_wire.c
@@ -0,0 +1,387 @@
+#include "omemo_wire.h"
+#include "signal_protocol.h"
+
+#include <limits.h>
+#include <string.h>
+
+/* This small codec is intentionally separate from the legacy Signal protobuf
+ * messages: OMEMO has no Signal version byte, type-prefixed keys or MAC8. */
+typedef struct wire_reader {
+    const uint8_t *data;
+    size_t len;
+    size_t pos;
+} wire_reader;
+
+#define OMEMO_WIRE_MAX_GROUP_DEPTH 32
+
+static int read_varint(wire_reader *reader, uint64_t *value)
+{
+    unsigned int i;
+    uint64_t result = 0;
+    for(i = 0; i < 10; ++i) {
+        uint8_t byte;
+        if(reader->pos == reader->len) return SG_ERR_INVALID_PROTO_BUF;
+        byte = reader->data[reader->pos++];
+        if(i == 9 && byte > 1) return SG_ERR_INVALID_PROTO_BUF;
+        result |= (uint64_t)(byte & 0x7f) << (i * 7);
+        if(!(byte & 0x80)) {
+            *value = result;
+            return 0;
+        }
+    }
+    return SG_ERR_INVALID_PROTO_BUF;
+}
+
+static int read_tag(wire_reader *reader, uint32_t *field, unsigned int *type)
+{
+    uint64_t value;
+    if(read_varint(reader, &value) < 0 || value == 0 ||
+            (value >> 3) > 0x1fffffff || (value >> 3) == 0 ||
+            (value & 7) > 5) return SG_ERR_INVALID_PROTO_BUF;
+    *field = (uint32_t)(value >> 3);
+    *type = (unsigned int)(value & 7);
+    return 0;
+}
+
+static int read_bytes(wire_reader *reader, const uint8_t **data, size_t *len)
+{
+    uint64_t value;
+    if(read_varint(reader, &value) < 0 || value > reader->len - reader->pos)
+        return SG_ERR_INVALID_PROTO_BUF;
+    *data = reader->data + reader->pos;
+    *len = (size_t)value;
+    reader->pos += (size_t)value;
+    return 0;
+}
+
+static int skip_field(wire_reader *reader, uint32_t field, unsigned int type,
+        unsigned int depth)
+{
+    const uint8_t *data;
+    size_t len;
+    uint64_t value;
+    switch(type) {
+    case 0:
+        return read_varint(reader, &value);
+    case 1:
+        if(reader->len - reader->pos < 8) return SG_ERR_INVALID_PROTO_BUF;
+        reader->pos += 8;
+        return 0;
+    case 2:
+        return read_bytes(reader, &data, &len);
+    case 3:
+        if(depth >= OMEMO_WIRE_MAX_GROUP_DEPTH) return SG_ERR_INVALID_PROTO_BUF;
+        while(reader->pos < reader->len) {
+            uint32_t child_field;
+            unsigned int child_type;
+            if(read_tag(reader, &child_field, &child_type) < 0)
+                return SG_ERR_INVALID_PROTO_BUF;
+            if(child_type == 4)
+                return child_field == field ? 0 : SG_ERR_INVALID_PROTO_BUF;
+            if(skip_field(reader, child_field, child_type, depth + 1) < 0)
+                return SG_ERR_INVALID_PROTO_BUF;
+        }
+        return SG_ERR_INVALID_PROTO_BUF;
+    case 5:
+        if(reader->len - reader->pos < 4) return SG_ERR_INVALID_PROTO_BUF;
+        reader->pos += 4;
+        return 0;
+    default:
+        /* End groups are only legal in the matching skip_field group. */
+        return SG_ERR_INVALID_PROTO_BUF;
+    }
+}
+
+static size_t varint_length(uint64_t value)
+{
+    size_t len = 1;
+    while(value > 0x7f) { ++len; value >>= 7; }
+    return len;
+}
+
+static void write_varint(uint8_t **cursor, uint64_t value)
+{
+    while(value > 0x7f) {
+        *(*cursor)++ = (uint8_t)((value & 0x7f) | 0x80);
+        value >>= 7;
+    }
+    *(*cursor)++ = (uint8_t)value;
+}
+
+static void write_uint32(uint8_t **cursor, uint8_t tag, uint32_t value)
+{
+    *(*cursor)++ = tag;
+    write_varint(cursor, value);
+}
+
+static void write_bytes(uint8_t **cursor, uint8_t tag, const uint8_t *data, size_t len)
+{
+    *(*cursor)++ = tag;
+    write_varint(cursor, len);
+    if(len) memcpy(*cursor, data, len);
+    *cursor += len;
+}
+
+static int valid_ciphertext(size_t len)
+{
+    return len > 0 && len % 16 == 0 && len <= OMEMO_WIRE_MAX_MESSAGE_LENGTH;
+}
+
+void omemo_message_clear(omemo_message *message)
+{
+    if(!message) return;
+    signal_buffer_free(message->ciphertext);
+    memset(message, 0, sizeof(*message));
+}
+
+void omemo_authenticated_message_clear(omemo_authenticated_message *message)
+{
+    if(!message) return;
+    signal_buffer_free(message->message);
+    memset(message, 0, sizeof(*message));
+}
+
+void omemo_key_exchange_clear(omemo_key_exchange *message)
+{
+    if(!message) return;
+    omemo_authenticated_message_clear(&message->message);
+    memset(message, 0, sizeof(*message));
+}
+
+int omemo_message_encode(signal_buffer **output, const omemo_message *message)
+{
+    signal_buffer *encoded;
+    size_t ciphertext_len = 0;
+    size_t len;
+    uint8_t *cursor;
+    if(!output) return SG_ERR_INVAL;
+    *output = 0;
+    if(!message) return SG_ERR_INVAL;
+    if(message->ciphertext) {
+        ciphertext_len = signal_buffer_len(message->ciphertext);
+        if(!valid_ciphertext(ciphertext_len)) return SG_ERR_INVAL;
+    }
+    len = 1 + varint_length(message->n) + 1 + varint_length(message->pn) + 34;
+    if(message->ciphertext) len += 1 + varint_length(ciphertext_len) + ciphertext_len;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) return SG_ERR_INVAL;
+    encoded = signal_buffer_alloc(len);
+    if(!encoded) return SG_ERR_NOMEM;
+    cursor = signal_buffer_data(encoded);
+    write_uint32(&cursor, 0x08, message->n);
+    write_uint32(&cursor, 0x10, message->pn);
+    write_bytes(&cursor, 0x1a, message->dh_pub, OMEMO_WIRE_KEY_LENGTH);
+    if(message->ciphertext)
+        write_bytes(&cursor, 0x22, signal_buffer_const_data(message->ciphertext), ciphertext_len);
+    *output = encoded;
+    return 0;
+}
+
+int omemo_message_decode(omemo_message *message, const uint8_t *data, size_t len)
+{
+    wire_reader reader = {data, len, 0};
+    unsigned int seen = 0;
+    int result = SG_ERR_INVALID_PROTO_BUF;
+    if(!message) return SG_ERR_INVAL;
+    memset(message, 0, sizeof(*message));
+    if(!data && len) return SG_ERR_INVAL;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) return result;
+    while(reader.pos < reader.len) {
+        uint32_t field;
+        unsigned int type;
+        uint64_t value;
+        const uint8_t *bytes;
+        size_t bytes_len;
+        if(read_tag(&reader, &field, &type) < 0) goto fail;
+        if(field > 4) {
+            if(skip_field(&reader, field, type, 0) < 0) goto fail;
+            continue;
+        }
+        if(seen & (1u << field)) goto fail;
+        seen |= 1u << field;
+        if(field == 1 || field == 2) {
+            if(type != 0 || read_varint(&reader, &value) < 0 || value > UINT32_MAX)
+                goto fail;
+            if(field == 1) message->n = (uint32_t)value;
+            else message->pn = (uint32_t)value;
+        }
+        else {
+            if(type != 2 || read_bytes(&reader, &bytes, &bytes_len) < 0) goto fail;
+            if(field == 3) {
+                if(bytes_len != OMEMO_WIRE_KEY_LENGTH) goto fail;
+                memcpy(message->dh_pub, bytes, bytes_len);
+            }
+            else {
+                if(!valid_ciphertext(bytes_len)) goto fail;
+                message->ciphertext = signal_buffer_create(bytes, bytes_len);
+                if(!message->ciphertext) { result = SG_ERR_NOMEM; goto fail; }
+            }
+        }
+    }
+    if((seen & 0x0e) != 0x0e) goto fail;
+    return 0;
+fail:
+    omemo_message_clear(message);
+    return result;
+}
+
+static int validate_authenticated_inner(const uint8_t *data, size_t len)
+{
+    omemo_message inner;
+    int result = omemo_message_decode(&inner, data, len);
+    if(result >= 0 && !inner.ciphertext) result = SG_ERR_INVALID_PROTO_BUF;
+    omemo_message_clear(&inner);
+    return result;
+}
+
+int omemo_authenticated_message_encode(signal_buffer **output,
+        const omemo_authenticated_message *message)
+{
+    signal_buffer *encoded;
+    size_t message_len;
+    size_t len;
+    uint8_t *cursor;
+    int result;
+    if(!output) return SG_ERR_INVAL;
+    *output = 0;
+    if(!message || !message->message) return SG_ERR_INVAL;
+    message_len = signal_buffer_len(message->message);
+    result = validate_authenticated_inner(signal_buffer_const_data(message->message), message_len);
+    if(result < 0) return result == SG_ERR_NOMEM ? result : SG_ERR_INVAL;
+    len = 18 + 1 + varint_length(message_len) + message_len;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) return SG_ERR_INVAL;
+    encoded = signal_buffer_alloc(len);
+    if(!encoded) return SG_ERR_NOMEM;
+    cursor = signal_buffer_data(encoded);
+    write_bytes(&cursor, 0x0a, message->mac, OMEMO_WIRE_MAC_LENGTH);
+    write_bytes(&cursor, 0x12, signal_buffer_const_data(message->message), message_len);
+    *output = encoded;
+    return 0;
+}
+
+int omemo_authenticated_message_decode(omemo_authenticated_message *message,
+        const uint8_t *data, size_t len)
+{
+    wire_reader reader = {data, len, 0};
+    unsigned int seen = 0;
+    int result = SG_ERR_INVALID_PROTO_BUF;
+    if(!message) return SG_ERR_INVAL;
+    memset(message, 0, sizeof(*message));
+    if(!data && len) return SG_ERR_INVAL;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) return result;
+    while(reader.pos < reader.len) {
+        uint32_t field;
+        unsigned int type;
+        const uint8_t *bytes;
+        size_t bytes_len;
+        if(read_tag(&reader, &field, &type) < 0) goto fail;
+        if(field > 2) {
+            if(skip_field(&reader, field, type, 0) < 0) goto fail;
+            continue;
+        }
+        if(seen & (1u << field)) goto fail;
+        seen |= 1u << field;
+        if(type != 2 || read_bytes(&reader, &bytes, &bytes_len) < 0) goto fail;
+        if(field == 1) {
+            if(bytes_len != OMEMO_WIRE_MAC_LENGTH) goto fail;
+            memcpy(message->mac, bytes, bytes_len);
+        }
+        else {
+            int inner_result = validate_authenticated_inner(bytes, bytes_len);
+            if(inner_result < 0) {
+                if(inner_result == SG_ERR_NOMEM) result = inner_result;
+                goto fail;
+            }
+            /* Retain exactly the bytes the sender authenticated. */
+            message->message = signal_buffer_create(bytes, bytes_len);
+            if(!message->message) { result = SG_ERR_NOMEM; goto fail; }
+        }
+    }
+    if(seen != 0x06) goto fail;
+    return 0;
+fail:
+    omemo_authenticated_message_clear(message);
+    return result;
+}
+
+int omemo_key_exchange_encode(signal_buffer **output, const omemo_key_exchange *message)
+{
+    signal_buffer *auth = 0;
+    signal_buffer *encoded;
+    size_t auth_len;
+    size_t len;
+    uint8_t *cursor;
+    int result;
+    if(!output) return SG_ERR_INVAL;
+    *output = 0;
+    if(!message) return SG_ERR_INVAL;
+    result = omemo_authenticated_message_encode(&auth, &message->message);
+    if(result < 0) return result;
+    auth_len = signal_buffer_len(auth);
+    len = 1 + varint_length(message->pk_id) + 1 + varint_length(message->spk_id) +
+        34 + 34 + 1 + varint_length(auth_len) + auth_len;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) {
+        signal_buffer_free(auth);
+        return SG_ERR_INVAL;
+    }
+    encoded = signal_buffer_alloc(len);
+    if(!encoded) { signal_buffer_free(auth); return SG_ERR_NOMEM; }
+    cursor = signal_buffer_data(encoded);
+    write_uint32(&cursor, 0x08, message->pk_id);
+    write_uint32(&cursor, 0x10, message->spk_id);
+    write_bytes(&cursor, 0x1a, message->ik, OMEMO_WIRE_KEY_LENGTH);
+    write_bytes(&cursor, 0x22, message->ek, OMEMO_WIRE_KEY_LENGTH);
+    write_bytes(&cursor, 0x2a, signal_buffer_const_data(auth), auth_len);
+    signal_buffer_free(auth);
+    *output = encoded;
+    return 0;
+}
+
+int omemo_key_exchange_decode(omemo_key_exchange *message, const uint8_t *data, size_t len)
+{
+    wire_reader reader = {data, len, 0};
+    unsigned int seen = 0;
+    int result = SG_ERR_INVALID_PROTO_BUF;
+    if(!message) return SG_ERR_INVAL;
+    memset(message, 0, sizeof(*message));
+    if(!data && len) return SG_ERR_INVAL;
+    if(len > OMEMO_WIRE_MAX_MESSAGE_LENGTH) return result;
+    while(reader.pos < reader.len) {
+        uint32_t field;
+        unsigned int type;
+        uint64_t value;
+        const uint8_t *bytes;
+        size_t bytes_len;
+        if(read_tag(&reader, &field, &type) < 0) goto fail;
+        if(field > 5) {
+            if(skip_field(&reader, field, type, 0) < 0) goto fail;
+            continue;
+        }
+        if(seen & (1u << field)) goto fail;
+        seen |= 1u << field;
+        if(field == 1 || field == 2) {
+            if(type != 0 || read_varint(&reader, &value) < 0 || value > UINT32_MAX)
+                goto fail;
+            if(field == 1) message->pk_id = (uint32_t)value;
+            else message->spk_id = (uint32_t)value;
+        }
+        else {
+            if(type != 2 || read_bytes(&reader, &bytes, &bytes_len) < 0) goto fail;
+            if(field == 3 || field == 4) {
+                if(bytes_len != OMEMO_WIRE_KEY_LENGTH) goto fail;
+                memcpy(field == 3 ? message->ik : message->ek, bytes, bytes_len);
+            }
+            else {
+                int auth_result = omemo_authenticated_message_decode(&message->message, bytes, bytes_len);
+                if(auth_result < 0) {
+                    if(auth_result == SG_ERR_NOMEM) result = auth_result;
+                    goto fail;
+                }
+            }
+        }
+    }
+    if(seen != 0x3e) goto fail;
+    return 0;
+fail:
+    omemo_key_exchange_clear(message);
+    return result;
+}
diff --git a/src/omemo_wire.h b/src/omemo_wire.h
new file mode 100644
index 0000000..14c6bac
--- /dev/null
+++ b/src/omemo_wire.h
@@ -0,0 +1,64 @@
+#ifndef OMEMO_WIRE_H
+#define OMEMO_WIRE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "signal_protocol_types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define OMEMO_WIRE_KEY_LENGTH 32
+#define OMEMO_WIRE_MAC_LENGTH 16
+/* Resource limit for each encoded or decoded protobuf message. */
+#define OMEMO_WIRE_MAX_MESSAGE_LENGTH (1024u * 1024u)
+
+typedef struct omemo_message {
+    uint32_t n;
+    uint32_t pn;
+    uint8_t dh_pub[OMEMO_WIRE_KEY_LENGTH];
+    /* NULL represents the optional ciphertext omitted from a ratchet header.
+     * If present, it must contain a positive multiple of 16 bytes. */
+    signal_buffer *ciphertext;
+} omemo_message;
+
+typedef struct omemo_authenticated_message {
+    uint8_t mac[OMEMO_WIRE_MAC_LENGTH];
+    /* Owned bytes of the inner OMEMOMessage, preserved exactly on decode.
+     * These original bytes, not a reserialization, are the MAC input. */
+    signal_buffer *message;
+} omemo_authenticated_message;
+
+typedef struct omemo_key_exchange {
+    uint32_t pk_id;
+    uint32_t spk_id;
+    /* Raw Ed25519 identity public key and raw X25519 ephemeral public key. */
+    uint8_t ik[OMEMO_WIRE_KEY_LENGTH];
+    uint8_t ek[OMEMO_WIRE_KEY_LENGTH];
+    omemo_authenticated_message message;
+} omemo_key_exchange;
+
+/* Encoders return SG_SUCCESS and an owned signal_buffer, or a negative error.
+ * They always set *output to NULL on failure. Decoders require a new/cleared
+ * result, own all resulting buffers, and leave it zeroed on failure. Inputs
+ * are not retained. Unknown legal protobuf fields and arbitrary field order
+ * are accepted; duplicate known fields and malformed wire data are rejected.
+ * Authenticated and key-exchange messages require an inner ciphertext. */
+int omemo_message_encode(signal_buffer **output, const omemo_message *message);
+int omemo_message_decode(omemo_message *message, const uint8_t *data, size_t len);
+void omemo_message_clear(omemo_message *message);
+
+int omemo_authenticated_message_encode(signal_buffer **output, const omemo_authenticated_message *message);
+int omemo_authenticated_message_decode(omemo_authenticated_message *message, const uint8_t *data, size_t len);
+void omemo_authenticated_message_clear(omemo_authenticated_message *message);
+
+int omemo_key_exchange_encode(signal_buffer **output, const omemo_key_exchange *message);
+int omemo_key_exchange_decode(omemo_key_exchange *message, const uint8_t *data, size_t len);
+void omemo_key_exchange_clear(omemo_key_exchange *message);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
