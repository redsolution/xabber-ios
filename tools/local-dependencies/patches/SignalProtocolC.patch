+typedef struct rng_state { unsigned call; } rng_state;
+static int vector_rng(uint8_t *data, size_t len, void *user_data)
+{
+    rng_state *rng = user_data;
+    unsigned first = rng->call++ == 0 ? 33 : 97;
+    size_t i;
+    assert(len == 32);
+    for(i = 0; i < len; ++i) data[i] = (uint8_t)(first + i);
+    return 0;
+}
+
+static void assert_hex(const uint8_t *actual, const char *hex, size_t len)
+{
+    size_t i;
+    for(i = 0; i < len; ++i) {
+        unsigned expected;
+        assert(sscanf(hex + 2 * i, "%2x", &expected) == 1);
+        assert(actual[i] == (uint8_t)expected);
+    }
+}
+
+static void decode_hex(uint8_t *output, const char *hex, size_t len)
+{
+    size_t i;
+    for(i = 0; i < len; ++i) {
+        unsigned value;
+        assert(sscanf(hex + 2 * i, "%2x", &value) == 1);
+        output[i] = (uint8_t)value;
+    }
+}
