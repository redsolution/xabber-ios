+    assert(omemo_session_decrypt(f.bob, &plain, signal_buffer_data(bad), signal_buffer_len(bad), 1) == SG_ERR_INVALID_KEY_ID);
+    assert_unchanged(f.bob, before); signal_buffer_free(bad); kex.pk_id--;
