  "computedFallbacks": {
    "circle_mask_name": {
      "expression": "mask",
      "reason": "The surrounding switch constrains the runtime mask label to Circle."
    },
    "files": {
      "expression": "Kind.files.rawValue",
      "reason": "The media filter enum supplies the English development label at runtime."
    },
    "groupchat__toast__invitations_sent": {
      "expression": "invitationCount == 1 ? Invitation sent : Invitations sent",
      "reason": "The development fallback follows the same singular/plural branch as the native plural resource."
    },
    "images": {
      "expression": "Kind.images.rawValue",
      "reason": "The media filter enum supplies the English development label at runtime."
    },
    "motivating_oneliner": {
      "expression": "titles.randomElement()",
      "reason": "The fallback is the runtime-selected English title while catalog English stores the canonical title corpus."
    },
